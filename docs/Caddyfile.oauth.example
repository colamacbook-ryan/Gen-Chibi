# gen-chibi v0.19 — sample Caddyfile for when your own login gate sits in front of the app.
# © 2026 Gen Labs — All rights reserved.
#
# Principle: MACHINE (agent) routes go STRAIGHT to the app, never through the login gate; everything else (Studio, /api, the Authorize page) goes through the gate.
# The machine routes are protected by the app's own Bearer tokens (OAuth access token / GC_API_TOKEN / keyed link) + PKCE — no gate cookie needed.
#
# Why forward_auth must not sit at site level: it would also run for /mcp. The gate answers 302 /login or its own 401 (without WWW-Authenticate)
# → the agent cannot discover OAuth by itself. Put forward_auth INSIDE the last handle, as below.
#
# The app does NOT trust Remote-User / X-Forwarded-User headers added by the gate: /oauth/authorize still asks the owner for GC_API_TOKEN (or a Studio session).
# claude.ai requirements: port 443, a hostname with a public A record, no apex ↔ www redirect (a redirect drops the Authorization header).
# Cloudflare: Bot Fight Mode / "Block AI bots" return 403 to the Claude-User UA → create a WAF skip rule for IP 160.79.104.0/21 (Anthropic egress)
# or turn those features off for the machine paths below.
#
# Replace: chibi.example.com → your domain · 7480 → GC_PORT · set GC_PUBLIC_URL=https://chibi.example.com and GC_ALLOWED_HOSTS=chibi.example.com in gen-chibi's .env.

chibi.example.com {
	# machine routes: discovery (RFC 9728 / 8414), registration, token exchange, revocation, and MCP itself
	@machine path /mcp /mcp/* /.well-known/oauth-protected-resource* /.well-known/oauth-authorization-server* /oauth/register /oauth/token /oauth/revoke
	handle @machine {
		reverse_proxy 127.0.0.1:7480
	}

	# everything else — Studio, /api/*, /oauth/authorize (the Authorize page), /api/oauth/approve — stays BEHIND your existing login gate
	handle {
		# forward_auth goes INSIDE this handle (example — adapt it to your gate):
		# forward_auth 127.0.0.1:9000 {
		# 	uri /verify
		# 	copy_headers Remote-User
		# }
		reverse_proxy 127.0.0.1:7480
	}
}
