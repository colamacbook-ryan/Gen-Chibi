# gen-chibi — base config of the edge Caddy (container gen-chibi-edge). v0.21
# © 2026 Gen Labs — All rights reserved.
# Shipped with each release as edge/Caddyfile.base; `genchibi online --caddy` copies it to edge/conf/Caddyfile once (never overwrites).
# Sites live in /edge/conf/sites.caddy, generated by the app (empty file = no site yet). Reload: POST /load on the admin socket.
# Caddy sees only ./edge/conf (read-only: this file, sites.caddy, edge-secret), ./edge/run (admin socket), caddy-data, caddy-config —
# never the rest of the install (tunnel token lives in ./run, not mounted here).
{
	# Admin API only on a unix socket in the shared volume: 0660, the app (same user) reloads through it; nothing listens on TCP.
	# Declared in THIS FILE, so every reload from the file keeps it (CNS-194).
	admin unix//edge/run/caddy-admin.sock|0660
	# not root inside the container: compose publishes 80→8080, 443→8443 (CNS-187)
	http_port 8080
	https_port 8443
	# only TCP 443 is published → do not advertise HTTP/3 (UDP)
	servers {
		protocols h1 h2
	}
	# no system trust store in the container (and never touch the host's)
	skip_install_trust
}

import /edge/conf/sites.caddy
