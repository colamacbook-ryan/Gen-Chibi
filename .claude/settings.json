{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/no-pkill.sh",
            "timeout": 10,
            "statusMessage": "Kiểm lệnh (no-pkill)"
          }
        ]
      }
    ]
  }
}
