 "works": [
  {
   "id": "fo-first-day",
   "title": "First Day at Work",
   "lang": "en",
   "logline": "Nana's first day at work: picky Boss Ted and Barry's mountain of paperwork.",
   "script": "Nana arrives at 7 am, but Boss Ted still says she is late. Barry dumps a 300-page report on her. Nana grinds away all day and finishes it. At sunset on the rooftop, Boss Ted praises Nana — and the whole team bursts out laughing.",
   "shots": [
    {
     "id": "shot-1",
     "title": "The first morning",
     "description": "Nana greets the boss with a big smile; the boss checks the clock.",
     "scene": "local.my/fo-office",
     "cast": [
      "local.my/fo-nana",
      "local.my/fo-boss-ted"
     ],
     "event": {
      "title": "The first morning",
      "steps": [
       {
        "actor": "fo-nana",
        "state": "proud",
        "spot": "left",
        "activity": "wave",
        "to": "fo-boss-ted",
        "say": "Good morning, boss! I'm Nana, the new hire!"
       },
       {
        "actor": "fo-boss-ted",
        "state": "smug",
        "spot": "midRight",
        "to": "fo-nana",
        "say": "Hm. The clock says 8:01."
       },
       {
        "actor": "fo-nana",
        "state": "shock",
        "spot": "midLeft",
        "fx": [
         "sweat"
        ],
        "to": "fo-boss-ted",
        "sfx": [],
        "say": "But… I've been here since 7, boss!"
       },
       {
        "actor": "fo-boss-ted",
        "state": "think",
        "to": "fo-nana",
        "say": "Early, huh… I'll count it as on time.",
        "hold": 2.6
       }
      ]
     }
    },
    {
     "id": "shot-2",
     "title": "Mountain of paperwork",
     "description": "Barry dumps a 300-page report on Nana.",
     "scene": "local.my/fo-office",
     "cast": [
      "local.my/fo-boss-ted",
      "local.my/fo-barry",
      "local.my/fo-nana"
     ],
     "event": {
      "title": "Mountain of paperwork",
      "steps": [
       {
        "actor": "fo-boss-ted",
        "state": "work",
        "spot": "center",
        "activity": "point",
        "to": "fo-barry",
        "say": "Barry, give Nana the Q3 report."
       },
       {
        "actor": "fo-barry",
        "state": "lazy",
        "spot": "right",
        "to": "fo-boss-ted",
        "say": "Sure, boss… I'll bring it over."
       },
       {
        "actor": "fo-barry",
        "state": "smug",
        "spot": "midLeft",
        "to": "fo-nana",
        "say": "Here, it's light… only three hundred pages."
       },
       {
        "actor": "fo-nana",
        "state": "panic",
        "spot": "left",
        "fx": [
         "exclaim"
        ],
        "to": "fo-barry",
        "sfx": [],
        "say": "THREE HUNDRED PAGES?!"
       },
       {
        "actor": "fo-barry",
        "state": "smug",
        "spot": "right",
        "activity": "wave",
        "to": "fo-nana",
        "say": "Good luck, kiddo~"
       }
      ]
     }
    },
    {
     "id": "shot-3",
     "title": "Full speed",
     "description": "Nana grinds through the report all day.",
     "scene": "local.my/fo-office",
     "cast": [
      "local.my/fo-nana"
     ],
     "event": {
      "title": "Full speed",
      "steps": [
       {
        "actor": "fo-nana",
        "state": "vow",
        "spot": "center",
        "activity": "write",
        "say": "No problem! Nana can do this!"
       },
       {
        "actor": "fo-nana",
        "state": "exhausted",
        "fx": [
         "sweatMany"
        ],
        "say": "Page… two hundred ninety-nine…"
       },
       {
        "actor": "fo-nana",
        "state": "proud",
        "activity": "cheer",
        "fx": [
         "confetti"
        ],
        "say": "DONE!!!"
       }
      ]
     }
    },
    {
     "id": "shot-4",
     "title": "Sunset on the rooftop",
     "description": "The boss praises Nana; Barry butts in.",
     "scene": "local.my/fo-rooftop",
     "cast": [
      "local.my/fo-boss-ted",
      "local.my/fo-nana",
      "local.my/fo-barry"
     ],
     "event": {
      "title": "Sunset",
      "steps": [
       {
        "actor": "fo-boss-ted",
        "state": "proud",
        "spot": "midRight",
        "to": "fo-nana",
        "say": "Great work, Nana. Come in early tomorrow… like today."
       },
       {
        "actor": "fo-nana",
        "state": "proud",
        "spot": "midLeft",
        "activity": "salute",
        "to": "fo-boss-ted",
        "say": "Yes, boss! I'll come at 6!"
       },
       {
        "actor": "fo-barry",
        "state": "shock",
        "spot": "left",
        "fx": [
         "sweat"
        ],
        "to": "fo-nana",
        "sfx": [],
        "say": "Don't, the door is still locked at 6!"
       }
      ]
     }
    }
   ]
  }
