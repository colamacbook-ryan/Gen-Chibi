  if echo "$r" | grep -q '"restart":true'; then
    for i in $(seq 1 60); do sleep 1; curl -fsS "$URL/api/health" >/dev/null 2>&1 && break; done
    sleep 2
    # compose của bản đang chạy (sau cập nhật, hoặc bản cũ nếu đã tự rollback) — app áp ở lần start tới; edge Caddy (nếu bật) nhận image mới ngay
    if [ "$MODE" = docker ]; then sync_compose; if [ -f "$EDGE_MARK" ]; then edge_prepare; compose up -d --no-deps --quiet-pull gen-chibi-edge >/dev/null 2>&1 || true; fi; fi
    status
  fi
}
