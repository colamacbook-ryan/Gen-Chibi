    # CNS-280: KHÔNG BAO GIỜ đề nghị khi người chạy chính là chủ thư mục cài (bản cài thường của uid 1000). Root: cần bằng chứng DƯƠNG "root cài không sudo, uid 1000
    # do đoán": GC_INSTALLED_BY=root · sudo:<người khác uid 1000> · uid 1000 không có trong passwd (không là ai) · hoặc owner tự chọn --migrate. Không biết → chỉ báo
    if [ "$me" != "$APP_UID" ] && [ -n "$IS_ROOT" ] && { [ "$APP_UID" = 1000 ] || [ "${GC_UID:-}" = 1000 ]; }; then
      who="$(id -nu 1000 2>/dev/null || true)"
      case "$by" in
        sudo:*) n="${by#sudo:}"; nu="$(id -u "$n" 2>/dev/null || true)"; [ "$nu" = 1000 ] || mig=1 ;;
        user:*) ;;
        root) mig=1 ;;
        *) if [ -z "$who" ] || [ -n "$force" ]; then mig=1; elif [ "$su" != 1000 ]; then dr "·" "$(mn dr_uid_unknown "$APP_UID" "$who" "$(gc_cmd)")"; said=1; fi ;;
      esac
    fi
    if [ -n "$mig" ]; then dr "!" "$(mn dr_uid_legacy "$APP_UID" "${who:-?}" "$SYS_USER" "$(gc_cmd)")"
    elif sys_ids && [ "$NU" = "$APP_UID" ]; then dr "✓" "$(mn dr_uid_sys "$SYS_USER" "$APP_UID")"
    elif [ -z "$said" ]; then dr "✓" "$(mn dr_uid_ok "$APP_UID" "${by:-?}")"; fi   # đã in dòng "·" chưa rõ ai → không in thêm ✓ trái ngược (CNS-295)
  fi
  # cổng
  case "${GC_BIND:-127.0.0.1}" in
    127.0.0.1|localhost|::1) dr "✓" "$(mn dr_bind_local "$PORT" )";;
    *) if [ -n "$(owner_token)" ]; then dr "!" "$(mn dr_bind_open "${GC_BIND}" "$PORT")"; else dr "✗" "$(mn refuse_bind "${GC_BIND}")"; fi ;;
  esac
  if [ "$MODE" = docker ]; then
    if compose_loopback; then dr "✓" "$(mn dr_pub_ok)"; elif [ "$PUBADDR" = "?" ]; then dr "!" "$(mn dr_pub_unknown)"; else dr "!" "$(mn dr_pub_open "$PUBADDR")"; fi
  fi
  if [ -z "$h" ] && port_busy "$PORT"; then dr "✗" "$(mn dr_port_busy "$PORT")"; fi
  # thiết lập lần đầu
  st="$(setup_stage)"
  case "$st" in
    done) dr "✓" "$(mn dr_stage_done )";;
    admin) dr "!" "$(mn dr_stage_admin )";;
    must_init) dr "!" "$(mn dr_stage_init )";;
    domain|mcp) dr "!" "$(mn dr_stage_wizard "$st" "http://localhost:$PORT" )";;
    *) dr "·" "$(mn dr_stage_none )";;
  esac
  # edge
  if [ -f "$EDGE_MARK" ]; then
    if port_busy 80 && port_busy 443; then dr "✓" "$(mn dr_caddy_on)"; else dr "✗" "$(mn dr_caddy_ports)"; fi
  fi
  # nguồn edge ($EDGE_DIR) phải thuộc user của thư mục cài — không thì start từ chối edge (CNS-291)
  if [ -n "$TRUST" ] && [ -f "$EDGE_MARK" ] && [ -d "$EDGE_DIR" ]; then
    for f in conf run caddy-data caddy-config; do
      [ -d "$EDGE_DIR/$f" ] && [ ! -L "$EDGE_DIR/$f" ] || continue
      o="$(ls -ldn "$EDGE_DIR/$f" | awk '{ print $3 }')"
      [ "$o" = "$APP_UID" ] || { dr "✗" "$(mn dr_edge_owner "$EDGE_DIR/$f" "$o" "$APP_UID" "$(mn edge_fix_owner "$APP_UID" "$APP_GID" "$EDGE_DIR")")"; break; }
    done
  fi
  es="$(rd run/edge-status.json | tr -d '\n')" || es=""
  tun="$(printf '%s' "$es" | sed -n 's/.*"tunnel":[[:space:]]*"\([a-z]*\)".*/\1/p')"
  rdy="$(printf '%s' "$es" | sed -n 's/.*"ready":[[:space:]]*\([a-z]*\).*/\1/p')"
  err="$(printf '%s' "$es" | sed -n 's/.*"error":[[:space:]]*"\([a-z-]*\)".*/\1/p')"
  case "$tun" in
    token|quick) if [ "$rdy" = true ]; then dr "✓" "$(mn dr_tunnel_ok "$tun")"; else dr "✗" "$(mn dr_tunnel_bad "$tun" "${err:-not ready}")"; fi ;;
  esac
  [ -z "${GC_TUNNEL:-}" ] || dr "!" "$(mn gc_tunnel "$GC_TUNNEL" | sed 's/^! //')"
  if rd .env | grep -c '^[[:space:]]*\(export[[:space:]]\{1,\}\)\{0,1\}GC_TEST' >/dev/null; then dr "!" "$(mn dr_test_hooks)"; fi
  # chuyển user
  if [ -n "$mig" ]; then
    if [ -z "$IS_ROOT" ] || [ -z "$TRUST" ]; then m dr_mig_root "sudo ${CLI_SELF:-$TD/genchibi}"
    elif ! override_gate; then DR_BAD=$((DR_BAD + 1))   # chuyển user dừng + chạy lại container → cùng rào override
    elif [ -n "$y" ] || ask_yn "$(mn dr_mig_ask "$APP_UID" "${who:-?}" "$SYS_USER" "$APP_UID")"; then doctor_migrate || DR_BAD=$((DR_BAD + 1))
    else m dr_mig_skip "$SYS_USER"; fi
  fi
  if [ "$DR_BAD" = 0 ]; then m dr_ok; return 0; fi
  m dr_bad "$DR_BAD"; return 1
}
