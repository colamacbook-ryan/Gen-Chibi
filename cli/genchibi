cf_login() { # lấy cert.pem (chứng chỉ tài khoản Cloudflare) vào $TDIR/.cloudflared — chỉ dùng lúc thiết lập
  local host="$1" dest="$TDIR/.cloudflared/cert.pem" dl f i
  [ -f "$dest" ] && return 0
  if [ -f "$HOME/.cloudflared/cert.pem" ]; then cp "$HOME/.cloudflared/cert.pem" "$dest"; m cf_reuse; return 0; fi
  dl="$(xdg-user-dir DOWNLOAD 2>/dev/null || true)"; [ -d "$dl" ] || dl="$HOME/Downloads"
  local mark="$TDIR/.login-start"; touch "$mark"
  pick_download() { # chỉ nhận cert.pem trình duyệt tải về SAU khi lần đăng nhập này bắt đầu, và hỏi trước khi dùng
    f="$(find "$dl" -maxdepth 1 -type f -name 'cert.pem' -newer "$mark" 2>/dev/null | head -1)"
    [ -n "$f" ] || return 1
    local a="" yes=""; [ -r /dev/tty ] && read -r -p "$(mn cf_pick "$f")" a < /dev/tty
    if [ "$UI" = vi ]; then case "$a" in c|C) yes=1 ;; esac; else case "$a" in y|Y) yes=1 ;; esac; fi
    [ -n "$yes" ] || return 1
    cp "$f" "$dest" && m cf_picked "$f"
  }
  for i in 1 2 3; do
    m cf_login "$i" "${host#*.}"
    cf tunnel login 2>&1 | grep --line-buffered -oE 'https://dash\.cloudflare\.com/argotunnel[^ ]*|successfully logged in' | sed 's/^/    /' || true
    [ -f "$dest" ] && { rm -f "$mark"; m cf_logged; return 0; }
    pick_download && { rm -f "$mark"; return 0; }
    [ $i -lt 3 ] && m cf_retry
  done
  rm -f "$mark"
  m cf_fail "$dest" >&2
  exit 1
}
expose_named() { # expose_named <tên-miền> [--overwrite-dns]
  local host="$1" over="${2:-}" name id
  [[ "$host" =~ ^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?\.[A-Za-z]{2,}$ ]] || { m bad_domain "$host" >&2; exit 1; }
  need_cf
  ensure_keys
  # cert.pem là chứng chỉ cấp tài khoản (tạo/xoá tunnel, sửa DNS cả tên miền): chỉ dùng lúc thiết lập rồi xoá.
  # Lúc chạy, tunnel chỉ cần creds.json của chính nó. Lần sau cùng tên miền thì không cần đăng nhập lại.
  if [ -f "$TDIR/.cloudflared/creds.json" ] && grep -qxF "  - hostname: $host" "$TDIR/config.yml" 2>/dev/null; then
    m tun_reuse "$host"
  else
    mkdir -p "$TDIR/.cloudflared"; chmod 700 "$TDIR"
    cf_login "$host"
    trap 'rm -f "$TDIR/.cloudflared/cert.pem"' EXIT
    name="gen-chibi-$(hostname -s 2>/dev/null | tr -c 'a-zA-Z0-9\n' '-' || echo may)"   # một tunnel cho mỗi máy
    if [ ! -f "$TDIR/.cloudflared/creds.json" ]; then
      cf tunnel create --credentials-file "$(CFH)/.cloudflared/creds.json" "$name" >/dev/null 2>&1 \
        || cf tunnel token --cred-file "$(CFH)/.cloudflared/creds.json" "$name" >/dev/null \
        || { m tun_create_fail "$name" >&2; exit 1; }
      m tun_ready "$name"
    fi
    id="$(json TunnelID < "$TDIR/.cloudflared/creds.json")"
    [ -n "$id" ] || { m tun_creds_bad "$TDIR/.cloudflared/creds.json" >&2; exit 1; }
    if ! cf tunnel route dns ${over:+--overwrite-dns} "$id" "$host" >/dev/null 2>"$TDIR/route.err"; then
      if grep -qi "already" "$TDIR/route.err"; then
        m dns_taken "$host" "$host" >&2
      else cat "$TDIR/route.err" >&2; fi
      exit 1
    fi
    rm -f "$TDIR/.cloudflared/cert.pem" "$TDIR/route.err"
    m dns_done "$host"
  fi
  id="$(json TunnelID < "$TDIR/.cloudflared/creds.json")"
  allow_host "$host"
  cat > "$TDIR/config.yml" <<EOF
# generated by genchibi expose — only the MCP + OAuth routes go out to the Internet (the Studio and the rest of /api stay on this machine):
#   /mcp*                                    MCP (link with key + Bearer)
#   /.well-known/oauth-*                     agent self-discovery (RFC 9728 / 8414)
#   /oauth/register|token|revoke|authorize   registration, token exchange, revocation; authorize = the self-contained Authorize page (the owner enters GC_API_TOKEN)
#   /api/oauth/approve                       the Authorize button on that page (requires the owner token)
tunnel: $id
credentials-file: $(CFH)/.cloudflared/creds.json
ingress:
  - hostname: $host
    path: ^/mcp(/.*)?$
    service: $(origin_url)
  - hostname: $host
    path: ^/\.well-known/oauth-(protected-resource|authorization-server)(/mcp)?$
    service: $(origin_url)
  - hostname: $host
    path: ^/oauth/(register|token|revoke|authorize)$
    service: $(origin_url)
  - hostname: $host
    path: ^/api/oauth/approve$
    service: $(origin_url)
  - service: http_status:404
EOF
  cf tunnel --config "$(CFH)/config.yml" ingress validate >/dev/null || { m tun_cfg_bad >&2; exit 1; }
  set_env GC_TUNNEL named; set_env GC_PUBLIC_URL "https://$host"
  [ "$MODE" = docker ] && set_env COMPOSE_PROFILES tunnel
  apply_env
  wait_link "$(link_url)" || true
  print_link
}
expose_quick() {
  mkdir -p "$TDIR"; chmod 700 "$TDIR"   # tạo trước, không để Docker tạo thư mục mang chủ root
  need_cf
  ensure_keys; allow_host "*.trycloudflare.com"
  set_env GC_TUNNEL quick; set_env GC_PUBLIC_URL ""
  if [ "$MODE" = docker ]; then set_env COMPOSE_PROFILES quick; docker compose rm -sf tunnel >/dev/null 2>&1 || true; fi
  apply_env
  local i u=""
  for i in $(seq 1 30); do u="$(quick_url)"; [ -n "$u" ] && break; sleep 1; done
  [ -n "$u" ] || { m quick_fail >&2; exit 1; }
  wait_link "$(link_url)" || true
  print_link
  m quick_note
}
expose_off() {
  set_env GC_TUNNEL ""; set_env GC_PUBLIC_URL ""
  if [ "$MODE" = docker ]; then
    set_env COMPOSE_PROFILES ""
    docker compose --profile tunnel --profile quick rm -sf tunnel tunnel-quick >/dev/null 2>&1 || true
  fi
  apply_env
  m off_1 "$TDIR"
  m off_2
}
expose_help() {
  if [ "$UI" = vi ]; then cat <<EOF
genchibi expose <tên-miền>      mở MCP qua tên miền của bạn (Cloudflare quản lý DNS), vd. genchibi expose chibi.example.com
genchibi expose --quick         link tạm *.trycloudflare.com, không cần tài khoản (đổi link mỗi lần khởi động lại)
genchibi expose --rotate        đổi khoá trong link
genchibi expose --off           tắt
genchibi link [--check]         in link + lệnh nối agent (--check: thử gọi qua Internet)
EOF
  else cat <<EOF
genchibi expose <domain>        open MCP through your own domain (DNS managed by Cloudflare), e.g. genchibi expose chibi.example.com
genchibi expose --quick         temporary *.trycloudflare.com link, no account needed (the link changes on every restart)
genchibi expose --rotate        change the key in the link
genchibi expose --off           turn it off
genchibi link [--check]         print the link + agent connect commands (--check: test a call over the Internet)
EOF
  fi
}
expose() {
  case "${1:-}" in
    --quick) expose_quick ;;
    --off) expose_off ;;
    --rotate)
      [ -n "${GC_TUNNEL:-}" ] || { m not_exposed; exit 1; }
      set_env GC_MCP_KEY "$(rand_hex 24)"; apply_env; m rotated
      wait_link "$(link_url)" || true; print_link ;;
    ""|-h|--help) expose_help ;;
    -*) m bad_opt_expose "$1" >&2; exit 1 ;;
    *) [ -z "${2:-}" ] || [ "$2" = --overwrite-dns ] || { m bad_opt "$2" >&2; exit 1; }; expose_named "$1" "${2:-}" ;;
  esac
}
link_cmd() {
  if [ "${1:-}" = --check ]; then local u; u="$(link_url)"; [ -n "$u" ] || { print_link; exit 1; }
    if probe "$u"; then m link_ok; else m link_fail "$u"; exit 1; fi
  else print_link; fi
}

