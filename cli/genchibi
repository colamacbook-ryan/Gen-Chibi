cli_path_save() { as_app mkdir -p run 2>/dev/null && as_app chmod 700 run 2>/dev/null; printf '%s\n' "$CLI_SELF" | aw run/cli-path 600 2>/dev/null; own_fix run 2>/dev/null || true; return 0; }
host_check() {
  local q="${1:-}" out errf n=0 ok=false err="" line body i=0
  cli_path_save
  if [ -n "$q" ]; then   # start / open: chỉ khi thiết lập lần đầu chưa xong, và đợi app trả lời (vừa khởi động) — không trả lời thì bỏ qua (không ghi kết quả sai)
    [ "$(setup_stage)" != done ] || return 0
    until curl -fsS -m 2 "$URL/api/health" >/dev/null 2>&1; do i=$((i + 1)); [ "$i" -lt "${GC_HOSTCHECK_WAIT:-20}" ] || return 0; sleep 0.5; done
  fi
  errf="$(mktemp "${TMPDIR:-/tmp}/gc-hc-XXXXXX")" || return 0
  out="$(printf '%s\n%s\n' '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-06-18","capabilities":{},"clientInfo":{"name":"gen-chibi-selftest","version":"host"}}}' '{"jsonrpc":"2.0","id":2,"method":"tools/list"}' \
    | "$CLI_SELF" mcp 2>"$errf")" || true
  line="$(printf '%s\n' "$out" | grep '"id":2' | head -1)" || true
  n="$(printf '%s' "$line" | grep -o '"inputSchema"' | wc -l | tr -d ' ')" || true
  if [ "${n:-0}" -gt 0 ] && printf '%s\n' "$out" | grep -q '"id":1.*"protocolVersion"'; then ok=true
  else err="$(tail -n 1 "$errf" 2>/dev/null | tr -d '"\\' | tr -cd '[:print:]' | cut -c1-200)"; [ -n "$err" ] || err="no tools/list reply"; fi
  rm -f "$errf"
  body="$(printf '{"ok":%s,"tools":%s,"cmd":"%s","error":"%s"}' "$ok" "${n:-0}" "$(cfg_esc "$CLI_SELF")" "$err")"
  oapi POST /api/setup/hostcheck "$body"
  if [ "$ok" = true ]; then m hc_ok "$CLI_SELF" "$n"; else m hc_fail "$CLI_SELF" "$err" >&2; fi
  [ "$OCODE" = 200 ] || [ -n "$q" ] || m hc_nopost >&2
  [ -n "$q" ] || [ "$ok" = true ]
}
setup_cmd() {
  local sub="${1:-}" reason
  [ $# -eq 0 ] || shift
  case "$sub" in
    ""|status) setup_status ;;
    skip)
      reason="$(printf '%s' "$*" | tr -d '"\\' | tr -cd '[:print:]' | cut -c1-200)"
      opost /api/setup/skip "{\"reason\":\"$reason\"}"
      case "$OCODE" in 2??) m setup_skipped ;; *) online_err; return 1 ;; esac ;;
    reset)
      opost /api/setup/reset '{}'
      case "$OCODE" in 2??) m setup_reset "$(jv stage)" ;; *) online_err; return 1 ;; esac ;;
    hint) setup_hint ;;
    check) host_check ;;
    -h|--help|help) m setup_help ;;
    *) m bad_opt "$sub" >&2; m setup_help >&2; return 2 ;;
  esac
}

sync_compose() {
  # chép tệp compose + Caddyfile gốc của bản đang chạy. KHÔNG đụng docker-compose.override.yml (của chủ),
  # edge/conf/Caddyfile (bản sống) và edge/conf/sites.caddy (app sinh).
  [ "$MODE" = docker ] || return 0
  local f d
  if [ -n "${TRUST:-}" ]; then   # root: chép từ gói đã kiểm ($TD), ghi bằng user của thư mục cài (bản sao cho người đọc; root không dùng tệp trong thư mục cài)
    d="$(trust_files)"; [ -n "$d" ] || return 0
    for f in docker-compose.yml docker-compose.edge.yml; do [ -f "$d/$f" ] && ! rd "$f" | cmp -s - "$d/$f" && aw "$f" 644 < "$d/$f"; done
    if [ -f "$d/Caddyfile.base" ] && ! rd edge/Caddyfile.base | cmp -s - "$d/Caddyfile.base"; then as_app mkdir -p edge && aw edge/Caddyfile.base 644 < "$d/Caddyfile.base"; fi
    return 0
  fi
  for f in docker-compose.yml docker-compose.edge.yml; do
    [ -f "current/$f" ] && ! cmp -s "current/$f" "$f" && cp "current/$f" "$f"
  done
  if [ -f current/edge/Caddyfile.base ] && ! cmp -s current/edge/Caddyfile.base edge/Caddyfile.base; then mkdir -p edge && cp current/edge/Caddyfile.base edge/Caddyfile.base; fi
  return 0
}
edge_prepare() {
  # chỉ khi đã bật edge Caddy: tạo trước các thư mục Caddy mount (edge/conf chỉ đọc, edge/run, caddy-data, caddy-config) bằng user này
  # (Docker tự tạo sẽ mang chủ root → Caddy / app không ghi được), Caddyfile sống từ bản gốc nếu chưa có, sites.caddy rỗng nếu chưa có
  # (Caddy dừng khi tệp import không tồn tại). Không ghi đè tệp nào đã có. Caddy KHÔNG thấy phần còn lại của edge/ hay run/ (tunnel token).
  [ -f "$EDGE_MARK" ] || return 0
  if [ -n "${TRUST:-}" ]; then edge_prepare_trust; return; fi
  as_app mkdir -p edge/conf edge/run edge/caddy-data edge/caddy-config && as_app chmod 700 edge/conf edge/run
  [ -f edge/conf/Caddyfile ] || { [ -f edge/Caddyfile.base ] && as_app cp edge/Caddyfile.base edge/conf/Caddyfile; }
  [ -f edge/conf/sites.caddy ] || as_app touch edge/conf/sites.caddy
  own_fix edge
  return 0
}
# TRUST (F1): nguồn bind mount của Caddy + hai thư mục app dùng chung với nó nằm ở $EDGE_DIR = $TD/edge (NGOÀI thư mục cài). $TD / $EDGE_DIR thuộc root (hoặc
# chính user) — container ghi được BÊN TRONG conf/ run/ caddy-data/ caddy-config/ (đã mount) nhưng không bao giờ tráo được chính các thư mục nguồn bằng symlink
# (docker daemon — root — sẽ đi theo symlink đó khi mount). Lần đầu: chép nội dung edge/<…> cũ của thư mục cài sang (chứng chỉ, Caddyfile) — đọc và ghi đều bằng
# chủ thư mục cài, mỗi phía cwd riêng (tar qua ống). Ngay trước compose up: mỗi nguồn phải là thư mục thật, không symlink, thuộc chủ thư mục cài.
EDGE_MIGRATED=""   # vừa tạo nguồn edge ở $EDGE_DIR trong lệnh này → container app cũ còn mount ./edge của thư mục cài, phải dựng lại cả app (CNS-292a)
edge_prepare_trust() {
  local d base
  [ "$APP_UID" != 0 ] || { m uid0_refuse "$HOME_DIR" >&2; return 1; }   # không bao giờ tạo / đổi chủ thư mục edge cho uid 0
  if as_app test -L edge; then m edge_unsafe "$HOME_DIR/edge" "$APP_UID" "$(mn edge_fix_link "$HOME_DIR/edge")" >&2; return 1; fi   # edge/ của thư mục cài là liên kết → từ chối
  ( umask 022; mkdir -p "$EDGE_DIR" ) && chmod 755 "$EDGE_DIR" || return 1
  for d in conf run caddy-data caddy-config; do
    if [ ! -e "$EDGE_DIR/$d" ] && [ ! -L "$EDGE_DIR/$d" ]; then   # symlink có sẵn: không "chữa" lặng lẽ — edge_sources_ok từ chối, chủ xem
      mkdir -m 700 "$EDGE_DIR/$d" || return 1
      [ -z "$DROP" ] || chown -h "$APP_UID:$APP_GID" "$EDGE_DIR/$d" || return 1
      EDGE_MIGRATED=1
      # lần đầu: chép edge/<d> cũ của thư mục cài (chứng chỉ, Caddyfile, sites) — đọc và ghi đều bằng chủ thư mục cài. Lỗi → KHÔNG nuốt: xoá đích (lần sau
      # chép lại), báo, dừng — Caddy chạy thiếu chứng chỉ sẽ xin lại (giới hạn tần suất Let's Encrypt) (CNS-292c)
      if as_app sh -c '[ ! -L edge ] && [ -d "edge/$1" ] && [ ! -L "edge/$1" ]' sh "$d"; then
        # kiểm + tar trong CÙNG một tiến trình (container không tráo được giữa lúc kiểm và lúc đọc): cd -P rồi so đường thật với thư mục cài
        if ! { as_app sh -c '[ ! -L edge ] && [ ! -L "edge/$1" ] && cd -P "edge/$1" && [ "$(pwd -P)" = "$2/edge/$1" ] && tar -cf - .' sh "$d" "$HOME_PHYS" | ( cd "$EDGE_DIR/$d" && as_app tar -xf - ); } 2>/dev/null; then
          case "$EDGE_DIR/$d" in "$TD"/i/*/edge/*) rm -rf -- "${EDGE_DIR:?}/$d" ;; esac
          m edge_copy_fail "$d" "$EDGE_DIR/$d" >&2; return 1
        fi
      fi
    fi
  done
  base="$(trust_files)/Caddyfile.base"
  if [ ! -f "$EDGE_DIR/conf/Caddyfile" ] && [ -f "$base" ]; then ( cd "$EDGE_DIR/conf" && as_app sh -c 'rm -f Caddyfile.gc-tmp; cat > Caddyfile.gc-tmp && mv -f Caddyfile.gc-tmp Caddyfile' ) < "$base"; fi
  [ -f "$EDGE_DIR/conf/sites.caddy" ] || ( cd "$EDGE_DIR/conf" && as_app touch sites.caddy )
  edge_sources_ok
}
edge_sources_ok() { # mỗi nguồn mount edge là thư mục thật (không symlink) thuộc chủ thư mục cài, trong $EDGE_DIR an toàn
  local d o
  path_safe "$EDGE_DIR" || { m edge_unsafe "$EDGE_DIR" "$APP_UID" "chmod go-w $EDGE_DIR" >&2; return 1; }
  for d in conf run caddy-data caddy-config; do
    [ -d "$EDGE_DIR/$d" ] && [ ! -L "$EDGE_DIR/$d" ] || { m edge_unsafe "$EDGE_DIR/$d" "$APP_UID" "$(mn edge_fix_link "$EDGE_DIR/$d")" >&2; return 1; }
    o="$(ls -ldn "$EDGE_DIR/$d" | awk '{ print $3 }')"; [ "$o" = "$APP_UID" ] || { m edge_unsafe "$EDGE_DIR/$d" "$APP_UID" "$(mn edge_fix_owner "$APP_UID" "$APP_GID" "$EDGE_DIR")" >&2; return 1; }
  done
}
# update / rollback có edge: dựng lại Caddy (image mới). Nguồn edge vừa dời ra $EDGE_DIR, hoặc container app chưa mount edge/conf từ đó (tạo trước v0.23.1) →
# dựng lại CẢ app, để app và Caddy dùng cùng một nguồn (sites.caddy, socket admin) — CNS-292a
edge_app_ok() { [ -z "$EDGE_MIGRATED" ] && [ "$(dk inspect -f '{{range .Mounts}}{{println .Source}}{{end}}' gen-chibi 2>/dev/null | grep -cx "$EDGE_DIR/conf")" -ge 1 ]; }
edge_refresh() {
  edge_prepare || return 1
  if [ -n "${TRUST:-}" ] && ! edge_app_ok; then compose up -d --quiet-pull >/dev/null 2>&1
  else compose up -d --no-deps --quiet-pull gen-chibi-edge >/dev/null 2>&1; fi
}
port_busy() { # port_busy <cổng> → 0 khi có tiến trình đang nghe trên máy này
  # ss thấy cả tiến trình chỉ nghe trên IP công khai; không có ss (macOS) / ss lỗi → thử nối 127.0.0.1 bằng /dev/tcp (bash 3.2 có).
  # Đếm dòng bằng wc (đọc hết) — không dùng grep -q sau ống: pipefail + SIGPIPE làm kết quả sai.
  local n=0
  if command -v ss >/dev/null 2>&1; then n="$(ss -ltn "sport = :$1" 2>/dev/null | wc -l | tr -d ' ')"; fi
  if [ "${n:-0}" -ge 1 ]; then [ "$n" -gt 1 ]; return; fi
  (echo > "/dev/tcp/127.0.0.1/$1") 2>/dev/null
}
online_caddy() { # online_caddy [flow] — flow: gọi từ `genchibi online caddy <tên-miền>` (không bảo "làm tiếp ở Studio")
  [ "$MODE" = docker ] || { m caddy_native >&2; exit 1; }
  sync_compose
  { [ -f docker-compose.edge.yml ] && [ -f edge/Caddyfile.base ]; } || { m caddy_old >&2; exit 1; }
  if [ -f "$EDGE_MARK" ]; then m caddy_already
  else
    local busy=""
    port_busy 80 && busy="80"
    port_busy 443 && busy="${busy:+$busy, }443"
    [ -z "$busy" ] || { m caddy_busy "$busy" >&2; exit 1; }
    as_app mkdir -p edge && as_app touch "$EDGE_MARK"
  fi
  edge_prepare
  compose up -d --quiet-pull 2>&1 | grep -vE "Creating|Created|Starting|Network|Container .* (Running|Waiting)" || true
  if [ "${1:-}" = flow ]; then m caddy_on_flow; else m caddy_on; fi
}
online_caddy_off() {
  [ "$MODE" = docker ] || { m caddy_native >&2; exit 1; }
  [ -f "$EDGE_MARK" ] || { m caddy_not_on; return 0; }
  compose rm -sf gen-chibi-edge >/dev/null 2>&1 || true   # dấu còn → compose còn tệp edge, gỡ đúng container của nó
  as_app rm -f "$EDGE_MARK"
  m caddy_off "$HOME_DIR"
}
# ---------------------------------------------------------------- genchibi online: Go online từ dòng lệnh (v0.21 §2) — CÙNG API /api/online/* với Studio
# Mọi lời gọi mang token chủ qua stdin của curl (-K -); thân lệnh (kể cả API token Cloudflare) cũng đi qua stdin (dòng `data = "…"` của cấu hình curl),
# không bao giờ nằm trong argv / biến môi trường của tiến trình con / log. JSON đọc bằng awk thuần (máy Docker có thể không có node / jq).
# Mã thoát: 0 xong · 1 lỗi / dừng ở một bậc (kể cả chưa khởi tạo owner — v0.23 bỏ mã 3 "chờ mật khẩu") · 2 sai cách dùng.
NL='
'
tty_ok() { { : < /dev/tty; } 2>/dev/null; }   # có người ngồi trước terminal (kể cả curl | bash); setsid / CI thì không
ask_yn() { # ask_yn "câu hỏi" → 0 khi trả lời có (y / c / yes / có); không terminal → không
  local a=""; tty_ok || return 1
  read -r -p "$1" a < /dev/tty || return 1
  case "$a" in y|Y|yes|YES|Yes|c|C|co|có|Có) return 0 ;; *) return 1 ;; esac
}
jflat() { # JSON (stdin) → mỗi giá trị một dòng "đường<TAB>giá trị" (vd flow.steps.0.id), chuỗi đã bỏ thoát; \n trong chuỗi → \036, \t / \r → khoảng trắng
  awk '
  function ws() { while (i <= n) { c = substr(s, i, 1); if (c == " " || c == "\t" || c == "\n" || c == "\r") i++; else break } }
  function str(   r, ch, e) {
    i++; r = ""
    while (i <= n) {
      ch = substr(s, i, 1)
      if (ch == "\"") { i++; return r }
      if (ch == "\\") {
        e = substr(s, i + 1, 1); i += 2
        if (e == "u") { i += 4; r = r "?" } else if (e == "n") r = r "\036"; else if (e == "t" || e == "r" || e == "b" || e == "f") r = r " "; else r = r e
        continue
      }
      if (match(substr(s, i, 512), /^[^"\\]+/)) { r = r substr(s, i, RLENGTH); i += RLENGTH } else { r = r ch; i++ }
    }
    bad = 1; return r
  }
  function val(p,   ch, k, idx) {
    ws(); if (i > n) { bad = 1; return }
    ch = substr(s, i, 1)
    if (ch == "{") {
      i++; ws()
      if (substr(s, i, 1) == "}") { i++; print p "\t{}"; return }
      while (i <= n) {
        ws(); if (substr(s, i, 1) != "\"") { bad = 1; return }
        k = str(); ws(); if (substr(s, i, 1) != ":") { bad = 1; return }
        i++; val(p == "" ? k : p "." k); if (bad) return
        ws(); ch = substr(s, i, 1); i++
        if (ch == "}") return
        if (ch != ",") { bad = 1; return }
      }
      bad = 1; return
    }
    if (ch == "[") {
      i++; ws()
      if (substr(s, i, 1) == "]") { i++; print p "\t[]"; return }
      for (idx = 0; i <= n; idx++) {
        val(p == "" ? idx : p "." idx); if (bad) return
        ws(); ch = substr(s, i, 1); i++
        if (ch == "]") return
        if (ch != ",") { bad = 1; return }
      }
      bad = 1; return
    }
    if (ch == "\"") { k = str(); print p "\t" k; return }
    if (match(substr(s, i, 64), /^[-+0-9.eEa-z]+/)) { print p "\t" substr(s, i, RLENGTH); i += RLENGTH; return }
    bad = 1
  }
  { s = s $0 "\n" }
  END { n = length(s); i = 1; bad = 0; val(""); if (bad) exit 1 }'
}
J=""   # bảng phẳng của phản hồi gần nhất
jv() { printf '%s\n' "$J" | awk -F '\t' -v k="$1" '$1 == k { sub(/^[^\t]*\t/, ""); gsub(/\036/, " "); if ($0 != "null") print; exit }'; }   # null → rỗng
jv_raw() { printf '%s\n' "$J" | awk -F '\t' -v k="$1" '$1 == k { sub(/^[^\t]*\t/, ""); gsub(/\036/, "\n"); print; exit }'; }   # giữ xuống dòng (đoạn cấu hình proxy)
jsteps() { # các bậc của luồng: mỗi dòng "id<TAB>state<TAB>detail<TAB>fix<TAB>manual"
  printf '%s\n' "$J" | awk -F '\t' '
    match($1, /^flow\.steps\.[0-9]+\./) { k = substr($1, RSTART, RLENGTH); f = substr($1, RLENGTH + 1); v = $0; sub(/^[^\t]*\t/, "", v); gsub(/\036/, " ", v)
      if (!(k in seen)) { seen[k] = 1; order[++n] = k } a[k, f] = v }
    END { for (j = 1; j <= n; j++) { k = order[j]; d = a[k, "detail"]; x = a[k, "fix"]; if (d == "null") d = ""; if (x == "null") x = ""
      print a[k, "id"] "\t" a[k, "state"] "\t" d "\t" x "\t" a[k, "manual"] } }'
}
OCODE=""; OBODY=""
oapi() { # oapi PHƯƠNG_THỨC ĐƯỜNG [JSON] → OCODE (000 = app không trả lời), OBODY, J. Token chủ + thân lệnh đi qua stdin của curl (-K -)
  local r
  r="$( { auth_cfg; if [ -n "${3:-}" ]; then printf 'data = "%s"\n' "$(cfg_esc "$3")"; fi; } | curl -sS -m 30 -K - -X "$1" -H 'X-GC-Request: 1' -H "X-GC-Lang: $UI" -H 'Content-Type: application/json' -w '\n%{http_code}' "$URL$2" 2>/dev/null)" || true
  OCODE="$(printf '%s\n' "$r" | tail -n 1)"; OBODY="$(printf '%s\n' "$r" | sed '$d')"
  case "$OCODE" in [1-5][0-9][0-9]) ;; *) OCODE=000 ;; esac
  J="$(printf '%s\n' "$OBODY" | jflat 2>/dev/null | LC_ALL=C tr -d '\000-\010\013-\035\037\177')" || J=""   # bỏ ký tự điều khiển của app (giữ \t \n và \036 của jflat) — F2
}
opost() { # opost ĐƯỜNG [JSON] — 429 (trần tần suất của app) → đợi rồi gửi lại, tối đa 5 lần
  local n=0 b="${2:-}"; [ -n "$b" ] || b='{}'
  while :; do
    oapi POST "$1" "$b"
    [ "$OCODE" = 429 ] && [ $n -lt 5 ] || return 0
    n=$((n + 1)); sleep "${GC_ONLINE_RETRY:-3}"
  done
}
online_err() { # in lỗi của phản hồi gần nhất (đã theo ngôn ngữ CLI) → luôn trả 1
  case "$OCODE" in
    000) m on_down "$URL" >&2 ;;
    401|403) m on_auth "$OCODE" "$HOME_DIR" >&2 ;;
    *) m on_err "$(jv error)" "$OCODE" >&2 ;;
  esac
  return 1
}
sname() { # tên hiển thị của một bậc
  case "$1" in
    domain) mn sn_domain ;; edge) mn sn_edge ;; port) mn sn_port ;; cert) mn sn_cert ;; public) mn sn_public ;; mcp) mn sn_mcp ;;
    owner) mn sn_owner ;; token) mn sn_token ;; zone) mn sn_zone ;; tunnel) mn sn_tunnel ;; waf) mn sn_waf ;; config) mn sn_config ;; local) mn sn_local ;; remote) mn sn_remote ;;
    *) printf '%s' "$1" ;;
  esac
}
srow() { # srow "id<TAB>state<TAB>detail<TAB>fix…" — một hàng của bảng bậc (✓ / ✗ / … / ·), cách sửa dưới hàng ✗
  local id st det fix sym rest
  id="${1%%	*}"; rest="${1#*	}"; st="${rest%%	*}"; rest="${rest#*	}"; det="${rest%%	*}"; rest="${rest#*	}"; fix="${rest%%	*}"
  case "$st" in ok) sym="✓" ;; fail) sym="✗" ;; running) sym="…" ;; *) sym="·" ;; esac
  printf '  %s %-24s %s\n' "$sym" "$(sname "$id")" "$det"
  if [ "$st" = fail ] && [ -n "$fix" ]; then m on_fix "$fix"; fi
}
FIRST_ID=""; FIRST_ST=""; FIRST_MANUAL=""
first_open() { # bậc làm luồng dừng (J) → FIRST_*: bậc ✗ đầu tiên; không có thì bậc đang chờ (…); không có nữa thì bậc chưa chạy (·) đầu tiên
  # (bậc "·" đứng TRƯỚC bậc ✗ là bậc đã trả về chờ chạy lại — vd publicUrl tạm bị trả về — không phải chỗ dừng)
  local l rest st pf="" pr="" pp=""
  FIRST_ID=""; FIRST_ST=""; FIRST_MANUAL=""
  while IFS= read -r l; do
    [ -n "$l" ] || continue
    rest="${l#*	}"; st="${rest%%	*}"
    case "$st" in ok) ;; fail) [ -n "$pf" ] || pf="$l" ;; running) [ -n "$pr" ] || pr="$l" ;; *) [ -n "$pp" ] || pp="$l" ;; esac
  done <<EOF
$(jsteps)
EOF
  l="${pf:-${pr:-$pp}}"; [ -n "$l" ] || return 0
  rest="${l#*	}"; FIRST_ID="${l%%	*}"; FIRST_ST="${rest%%	*}"; FIRST_MANUAL="${l##*	}"
  return 0
}
# online_follow — theo dõi luồng vừa gửi: hỏi GET /api/online, in mỗi thay đổi của từng bậc. Bậc đang chờ (chứng chỉ, connector…) khi app đã trả lời xong
# → gửi "Kiểm lại" (POST /recheck) tới khi xong hoặc hết GC_ONLINE_TIMEOUT giây (mặc định 900).
# Trả: 0 xong · 1 lỗi · 3 chờ mật khẩu chủ · 4 CNAME có sẵn cần xác nhận · 5 WAF phải làm tay · 6 token thấy nhiều tên miền (chọn)
online_follow() {
  local shown="$NL" l key end idle=0
  FIRST_ID=""
  end=$(( $(date +%s) + ${GC_ONLINE_TIMEOUT:-900} ))
  while :; do
    oapi GET /api/online
    [ "$OCODE" = 200 ] || { online_err; return 1; }
    while IFS= read -r l; do
      [ -n "$l" ] || continue
      key="$(printf '%s' "$l" | cut -f1-3)"
      case "$shown" in *"$NL$key$NL"*) ;; *) shown="$shown$key$NL"; srow "$l" ;; esac
    done <<EOF
$(jsteps)
EOF
    if [ "$(jv busy)" = true ]; then sleep "${GC_ONLINE_POLL:-2}"; continue; fi
    [ "$(jv flow.done)" = true ] && return 0
    if [ "$(jv flow.needs)" = urlChange ]; then   # mọi bậc ✓, chính thức hoá địa chỉ mới sẽ gỡ kết nối agent cũ (luồng không biết địa chỉ lúc bắt đầu) → hỏi như lúc bắt đầu
      local from; from="$(jv publicUrl)"
      m on_url_change "${from:--}" "$(jv flow.url)" "$(jv flow.revokes)"
      if [ -n "$YES" ] || ask_yn "$(mn on_url_ask)"; then
        opost /api/online/recheck '{"confirmUrlChange":true}'
        case "$OCODE" in 2??) continue ;; *) online_err; return 1 ;; esac
      fi
      m on_url_stop >&2; return 1
    fi
    first_open
    case "$FIRST_ST" in
      fail)
        [ "$(jv flow.needs)" = confirm ] && return 4
        [ "$FIRST_ID" = waf ] && [ "$FIRST_MANUAL" = true ] && return 5
        [ "$FIRST_ID" = token ] && [ -n "$(jv flow.choices.0)" ] && return 6
        return 1 ;;
      running) ;;
      *) # không bậc nào ✗ / đang chờ mà luồng chưa xong (bất thường): kiểm lại một lần, không lặp (trần tần suất của app)
        idle=$((idle + 1)); [ "$idle" -le 1 ] || { m on_failed "$(sname "${FIRST_ID:-?}")" >&2; FIRST_ID=""; return 1; } ;;
    esac
    [ "$(date +%s)" -lt "$end" ] || { m on_timeout "$(( ${GC_ONLINE_TIMEOUT:-900} / 60 ))" >&2; return 1; }
    sleep "${GC_ONLINE_RETRY:-3}"
    opost /api/online/recheck '{}'
    case "$OCODE" in 2??) ;; *) online_err; return 1 ;; esac
  done
}
YES=""; OVERWRITE=""; TOKSTDIN=""; WAFDONE=""; CFSUB=""
online_send() { # online_send ĐƯỜNG "khoá":giá-trị,… — bắt đầu một luồng; 409 needs=urlChange → hỏi (có terminal) / --yes; needs=legacy → hướng dẫn di chuyển
  local inner="$2" sep=""
  [ -z "$inner" ] || sep=","
  opost "$1" "{$inner}"
  if [ "$OCODE" = 409 ] && [ "$(jv needs)" = urlChange ]; then
    local to; to="$(jv to)"; case "$to" in ''|null) to="$(mn on_w_new)" ;; esac
    m on_url_change "$(jv from)" "$to" "$(jv revokes)"
    if [ -n "$YES" ] || ask_yn "$(mn on_url_ask)"; then opost "$1" "{$inner$sep\"confirmUrlChange\":true}"
    else m on_url_stop >&2; return 1; fi
  fi
  if [ "$OCODE" = 409 ] && [ "$(jv needs)" = legacy ]; then m on_legacy >&2; return 1; fi
  if [ "$OCODE" = 409 ] && [ "$(jv needs)" = owner ]; then m on_need_owner >&2; return 1; fi   # v0.23: chưa khởi tạo owner → không lên mạng
  case "$OCODE" in 2??) return 0 ;; *) online_err; return 1 ;; esac
}
online_done() { # in kết quả sau khi luồng xong; $1 = mã của online_follow → mã thoát
  local rc="$1" u
  u="$(jv flow.url)"; [ -n "$u" ] || u="$(jv publicUrl)"
  case "$rc" in
    0)
      if [ "$(jv flow.mode)" = off ]; then m on_off_done; [ -f "$EDGE_MARK" ] && m on_off_caddy; return 0; fi
      m on_done "$u"; m on_done_studio "$u"; m on_done_mcp "$u"; return 0 ;;
    1) [ -z "$FIRST_ID" ] || m on_failed "$(sname "$FIRST_ID")" >&2 ;;
  esac
  return "$rc"
}
cf_token() { # API token Cloudflare → CFTOK (biến shell, không export): --token-stdin · GC_CF_TOKEN (rồi xoá khỏi môi trường) · hỏi ẩn trên terminal
  CFTOK=""
  if [ -n "$TOKSTDIN" ]; then IFS= read -r CFTOK || true
  elif [ -n "${GC_CF_TOKEN:-}" ]; then CFTOK="$GC_CF_TOKEN"
  elif tty_ok; then
    oapi GET /api/online; [ -z "$(jv cloudflare.tokenLink)" ] || m cf_tok_link "$(jv cloudflare.tokenLink)"
    read -r -s -p "$(mn cf_tok_ask)" CFTOK < /dev/tty || true; printf '\n' >&2
  fi
  unset GC_CF_TOKEN   # tiến trình con (curl, awk…) không thừa hưởng
  CFTOK="${CFTOK%$'\r'}"
  [ -n "$CFTOK" ] || { m cf_tok_none >&2; return 1; }
  case "$CFTOK" in *[!A-Za-z0-9_.-]*) m cf_tok_bad >&2; CFTOK=""; return 1 ;; esac
  [ "${#CFTOK}" -ge 20 ] || { m cf_tok_bad >&2; CFTOK=""; return 1; }
}
online_status() {
  oapi GET /api/online
  [ "$OCODE" = 200 ] || { online_err; return 1; }
  local md dom u pend fm
  md="$(jv mode)"; dom="$(jv domain)"; u="$(jv publicUrl)"; pend="$(jv publicUrlPending)"
  m on_title "$md" "${dom:+ · $dom}"
  if [ -n "$u" ]; then m on_url "$u"; else m on_url_none; fi
  [ -z "$pend" ] || m on_url_pending "$pend"
  [ "$(jv flow.waitingOwner)" != true ] || m on_wait_owner "$pend"
  fm="$(jv flow.mode)"
  if [ -n "$fm" ]; then
    if [ "$(jv busy)" = true ]; then m on_flow "$fm" "$(mn on_w_busy)"
    elif [ "$(jv flow.done)" = true ]; then m on_flow "$fm" "$(mn on_w_done) $(jv flow.doneAt)"
    else m on_flow "$fm" "$(mn on_w_stopped)"; fi
    while IFS= read -r l; do [ -z "$l" ] || srow "$l"; done <<EOF
$(jsteps)
EOF
  fi
  local cad tun es=""
  if [ "$(jv edge.caddyEnabled)" = true ]; then cad="$(mn on_w_on)"; else cad="$(mn on_w_off)"; fi
  tun="$(jv edge.intent)"
  if [ -n "$(jv edge.status.tunnel)" ] && [ "$tun" != off ]; then
    if [ -n "$(jv edge.status.error)" ]; then es=" · $(jv edge.status.error)"
    elif [ "$(jv edge.status.ready)" = true ]; then es=" · $(mn on_w_ready)"
    elif [ "$(jv edge.status.running)" = true ]; then es=" · $(mn on_w_starting)"; fi
  fi
  m on_edge "$cad" "${tun:-off}" "$es"
  [ "$(jv legacy.active)" = true ] && m on_legacy_note
  m on_hint
  return 0
}
online_go_caddy() { # genchibi online caddy <tên-miền>: bật edge Caddy nếu chưa (kiểm cổng 80/443, bật container) → POST /api/online/caddy → theo dõi
  local d="$1"
  [ "$MODE" = docker ] || { m caddy_native >&2; return 1; }
  valid_host "$d" || { m bad_domain "$d" >&2; return 2; }
  online_caddy flow
  # socket admin của Caddy nằm ở nguồn mount edge/run: $EDGE_DIR/run (bản cài Docker v0.23.1 — ngoài thư mục cài, F1), không thì edge/run của thư mục cài
  local i sk="edge/run/caddy-admin.sock"; [ -z "${TRUST:-}" ] || sk="$EDGE_DIR/run/caddy-admin.sock"
  for i in $(seq 1 "${GC_EDGE_WAIT:-60}"); do [ -S "$sk" ] && break; [ "$i" = 1 ] && m on_wait_caddy; sleep 1; done
  [ -S "$sk" ] || { m on_caddy_nostart >&2; return 1; }
  m on_start "caddy" "$d"
  online_send /api/online/caddy "\"domain\":\"$d\"" || return 1
  online_follow && a=0 || a=$?; online_done "$a"
}
online_go_cloudflare() { # genchibi online cloudflare [<tên-miền> | <tên-con.tên-miền>] [--sub tên] [--overwrite-dns] [--token-stdin] [--yes]
  local d="${1:-}" zone="" sub="" alt="" rc
  if [ -n "$d" ]; then
    valid_host "$d" || { m bad_domain "$d" >&2; return 2; }
    if [ -n "$CFSUB" ]; then zone="$d"; sub="$CFSUB"
    elif [[ "${d#*.}" == *.* ]]; then zone="${d#*.}"; sub="${d%%.*}"; alt="$d"   # chibi.example.com → zone example.com, tên con chibi (không thấy zone đó → thử cả tên là zone)
    else zone="$d"; sub="chibi"; fi
  fi
  cf_token || return 1
  m on_start "cloudflare" "${sub:+$sub.}${zone:-?}"
  while :; do
    online_send /api/online/cloudflare "\"token\":\"$CFTOK\"${zone:+,\"zone\":\"$zone\"}${sub:+,\"sub\":\"$sub\"}" || return 1
    online_follow && rc=0 || rc=$?
    case "$rc" in
      4) # CNAME / bản ghi có sẵn: không tự đè
        if [ -n "$OVERWRITE" ] || ask_yn "$(mn cf_cname_ask)"; then
          opost /api/online/cloudflare/confirm '{"overwriteCname":true}'
          case "$OCODE" in 2??) ;; *) online_err; return 1 ;; esac
          online_follow && rc=0 || rc=$?
        else m cf_cname_stop "$zone" >&2; return 1; fi ;;
      6) # token thấy nhiều tên miền, chưa chọn
        local i=0 c pick=""
        m cf_choices
        while c="$(jv "flow.choices.$i")"; [ -n "$c" ]; do i=$((i + 1)); m cf_choice_row "$i" "$c"; done
        if tty_ok; then read -r -p "$(mn cf_choice_ask)" pick < /dev/tty || pick=""; fi
        case "$pick" in ''|*[!0-9]*) m cf_choice_stop >&2; return 1 ;; esac
        zone="$(jv "flow.choices.$((pick - 1))")"; [ -n "$zone" ] || { m cf_choice_stop >&2; return 1; }
        sub="${CFSUB:-chibi}"; YES=1; sleep 2; continue ;;
      1)
        if [ -n "$alt" ] && [ "$FIRST_ID" = token ]; then zone="$alt"; sub="${CFSUB:-chibi}"; alt=""; m cf_retry_zone "$zone" "$sub"; YES=1; sleep 2; continue; fi ;;
    esac
    break
  done
  [ "$rc" != 5 ] || { online_waf && rc=0 || rc=$?; }
  CFTOK=""
  online_done "$rc"
}
online_waf() { # WAF phải làm tay (token không có quyền WAF): cách sửa (biểu thức luật) đã in ở hàng ✗; có terminal → hỏi "đã làm chưa" rồi Kiểm lại
  local rc
  while :; do
    if [ -n "$WAFDONE" ] || ask_yn "$(mn cf_waf_ask)"; then
      WAFDONE=""
      opost /api/online/recheck '{"confirmManual":"waf"}'
      case "$OCODE" in 2??) ;; *) online_err; return 1 ;; esac
      online_follow && rc=0 || rc=$?
      [ "$rc" = 5 ] && continue
      return "$rc"
    fi
    m cf_waf_stop >&2; return 1
  done
}
online_go_proxy() {
  local d="$1"
  valid_host "$d" || { m bad_domain "$d" >&2; return 2; }
  m on_start "proxy" "$d"
  online_send /api/online/proxy "\"domain\":\"$d\"" || return 1
  if [ -n "$(jv snippets.caddy)" ]; then
    m on_proxy_snip; printf '\n# Caddy\n%s\n\n# nginx\n%s\n\n' "$(jv_raw snippets.caddy)" "$(jv_raw snippets.nginx)"
  fi
  online_follow && a=0 || a=$?; online_done "$a"
}
valid_host() { [[ "$1" =~ ^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?)*\.[A-Za-z]{2,63}$ ]] && [ "${#1}" -le 253 ]; }
online_usage() { m on_help; }
online_cmd() {
  local sub="${1:-}" pos="" a
  [ $# -eq 0 ] || shift
  case "$sub" in
    --caddy) online_caddy; return ;;
    --caddy-off) online_caddy_off; return ;;
    -h|--help|help) online_usage; return 0 ;;
    ""|status) online_status; return ;;
  esac
  while [ $# -gt 0 ]; do
    a="$1"; shift
    case "$a" in
      --yes|-y) YES=1 ;;
      --overwrite-dns) OVERWRITE=1 ;;
      --token-stdin) TOKSTDIN=1 ;;
      --waf-done) WAFDONE=1 ;;
      --sub) CFSUB="${1:-}"; [ $# -eq 0 ] || shift
        [[ "$CFSUB" =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$ ]] || { m bad_opt "--sub $CFSUB" >&2; return 2; } ;;
      --token|--token=*|--api-token|--api-token=*) m cf_tok_argv >&2; return 2 ;;
      -*) m bad_opt "$a" >&2; online_usage >&2; return 2 ;;
      *) if [ -z "$pos" ]; then pos="$a"
         elif [[ "$a" =~ ^[A-Za-z0-9_.-]{20,}$ ]]; then m cf_tok_argv >&2; return 2   # trông như token: từ chối, không dùng
         else m bad_opt "$a" >&2; return 2; fi ;;
    esac
  done
  case "$sub" in
    caddy) [ -n "$pos" ] || { online_usage >&2; return 2; }; online_go_caddy "$pos" ;;
    cloudflare|cf) online_go_cloudflare "$pos" ;;
    proxy) [ -n "$pos" ] || { online_usage >&2; return 2; }; online_go_proxy "$pos" ;;
    quick)
      [ -z "$pos" ] || { m bad_opt "$pos" >&2; return 2; }
      m on_start "quick" "*.trycloudflare.com"
      online_send /api/online/quick "" || return 1
      online_follow && a=0 || a=$?; online_done "$a" ;;
    recheck)
      opost /api/online/recheck "$([ -n "$WAFDONE" ] && printf '{"confirmManual":"waf"}' || printf '{}')"
      case "$OCODE" in 2??) ;; *) online_err; return 1 ;; esac
      WAFDONE=""; online_follow && a=0 || a=$?
      [ "$a" != 5 ] || { online_waf && a=0 || a=$?; }
      online_done "$a" ;;
    off)
      local body='{}'
      if [ -n "$TOKSTDIN" ] || [ -n "${GC_CF_TOKEN:-}" ]; then cf_token || return 1; body="{\"token\":\"$CFTOK\"}"; fi   # có token → app dọn cả tunnel / DNS / WAF đã tạo ở Cloudflare
      unset GC_CF_TOKEN
      opost /api/online/off "$body"; CFTOK=""; body=""
      case "$OCODE" in 2??) ;; *) online_err; return 1 ;; esac
      online_follow && a=0 || a=$?; online_done "$a" ;;
    migrate)
      opost /api/online/migrate '{}'
      if [ "$OCODE" = 404 ]; then m on_migrate_old >&2; return 1; fi
      case "$OCODE" in 2??) m on_migrated
        # máy còn GC_TUNNEL (genchibi expose ≤ v0.22): cấu hình đã sang Go online → dừng tunnel cũ còn sót, bỏ GC_TUNNEL / profile cũ khỏi .env (hết dòng nhắc)
        if [ -n "${GC_TUNNEL:-}" ]; then legacy_tunnel_down; set_env GC_TUNNEL ""; GC_TUNNEL=""
          case "${COMPOSE_PROFILES:-}" in tunnel|quick) set_env COMPOSE_PROFILES ""; COMPOSE_PROFILES="" ;; esac; fi
        online_status ;;
        *) online_err; return 1 ;; esac ;;
    *) m bad_opt "$sub" >&2; online_usage >&2; return 2 ;;
  esac
}
set_env() { # set_env KHOÁ GIÁ_TRỊ — sửa hoặc thêm dòng trong .env. Móc kiểm thử GC_TEST* không bao giờ vào .env (review bảo mật 🟡7): từ chối, và bỏ dòng cũ nếu có
  # đọc / ghi .env bằng user của thư mục cài (root không ghi xuyên symlink .env → /etc/…); 600
  local k="$1" v="$2" cur
  case "$k" in GC_TEST*) return 0 ;; esac
  cur="$(rd .env)" || cur=""
  printf '%s\n' "$cur" | K="$k" V="$v" awk 'BEGIN { k = ENVIRON["K"]; v = ENVIRON["V"] } /^[ \t]*(export[ \t]+)?GC_TEST/ { next } NR == 1 && $0 == "" { next } index($0, k "=") == 1 { if (!d) print k "=" v; d = 1; next } { print } END { if (!d) print k "=" v }' | aw .env 600
  if [ -z "${TRUST:-}" ]; then export "$k=$v"; else printf -v "$k" '%s' "$v"; fi
}
rand_hex() { openssl rand -hex "$1" 2>/dev/null || node -e "console.log(require('crypto').randomBytes($1).toString('hex'))"; }
token_cmd() {
  # genchibi token [giá trị|--clear]: đặt GC_GITHUB_TOKEN (repo private). Không truyền giá trị → hỏi ẩn / đọc stdin,
  # để token không nằm trong lịch sử shell hay danh sách tiến trình.
  local t="${1:-}" tmp
  if [ "$t" = "--clear" ]; then t=""
  elif [ -z "$t" ]; then
    if [ -t 0 ]; then read -r -s -p "$(mn tok_ask)" t; echo; else read -r t || true; fi
    [ -n "$t" ] || { m tok_none >&2; exit 1; }
  fi
  case "$t" in *[!A-Za-z0-9_.-]*) m tok_bad >&2; exit 1 ;; esac
  set_env GC_GITHUB_TOKEN "$t"   # một bộ ghi .env (bỏ dòng GC_TEST* như mọi lần ghi — CNS-287)
  if [ -n "$t" ]; then m tok_set; else m tok_cleared; fi
  if [ "$MODE" = docker ]; then start; else stop; start; fi
}
lang_cmd() {
  # genchibi lang [en|vi]: không đối số → in ngôn ngữ CLI + mặc định THẬT của Studio (/api/health khi app chạy, không thì data/settings.json).
  # Có đối số → so với CẢ HAI (không chỉ .env — CNS-153): khác thì ghi GC_LANG vào .env và đổi mặc định của Studio:
  #   app đang chạy → PUT /api/settings { uiLang, uiLangEnv } (đánh dấu giá trị .env đã áp: lần khởi động sau không áp lại đè lựa chọn Studio về sau);
  #   app dừng → sửa uiLang / uiLangEnv trong data/settings.json (thiếu khoá thì server tự áp GC_LANG mới ở lần chạy tới).
  local want="${1:-}" cur real h="" run=""
  cur="$(env_get GC_LANG)"
  case "$cur" in en|vi) ;; *) cur="" ;; esac
  h="$(curl -fsS -m 5 "$URL/api/health" 2>/dev/null || true)"; [ -n "$h" ] && run=1
  if [ -n "$run" ]; then real="$(printf '%s' "$h" | sed -n 's/.*"uiLang"[[:space:]]*:[[:space:]]*"\([A-Za-z_-]*\)".*/\1/p')"; else real="$(settings_lang)"; fi
  case "$real" in en|vi) ;; *) real="${cur:-en}" ;; esac
  if [ -z "$want" ]; then
    m lang_now "$(lang_name "$UI")" "$UI" "$(lang_name "$real")" "$real"; m lang_hint; return 0
  fi
  case "$want" in en|EN|En) want=en ;; vi|VI|Vi) want=vi ;; *) m lang_bad "$want" >&2; exit 1 ;; esac
  UI="$want"   # từ đây nói bằng ngôn ngữ vừa chọn
  if [ "$cur" = "$want" ] && [ "$real" = "$want" ]; then m lang_same "$(lang_name "$want")" "$want"; m lang_note; return 0; fi
  set_env GC_LANG "$want"
  m lang_set "$(lang_name "$want")" "$want"
  if [ -n "$run" ]; then
    # API không nhận (app quá cũ, lỗi mạng…) → khởi động lại: server áp GC_LANG mới khi khởi động
    if api PUT /api/settings "{\"uiLang\":\"$want\",\"uiLangEnv\":\"$want\"}" >/dev/null 2>&1; then m lang_live "$(lang_name "$want")"; else m lang_restart; apply_env; fi
  else
    local sj; sj="$(rd data/settings.json)" || sj=""
    if [[ "$sj" =~ \"uiLang\"[[:space:]]*: ]]; then
      printf '%s\n' "$sj" | sed -e "s/\"uiLang\"\([[:space:]]*:[[:space:]]*\)\"[A-Za-z_-]*\"/\"uiLang\"\1\"$want\"/" \
          -e "s/\"uiLangEnv\"\([[:space:]]*:[[:space:]]*\)\"[A-Za-z_-]*\"/\"uiLangEnv\"\1\"$want\"/" | aw data/settings.json 644
    fi
    m lang_norun
  fi
  m lang_note
}
apply_env() { # khởi động lại để app nhận khoá/tên miền/ngôn ngữ mới
  if [ "$MODE" = docker ]; then sync_compose; edge_prepare; compose up -d --quiet-pull 2>&1 | grep -vE "Creating|Created|Starting|Started|Stopping|Stopped|Removing|Removed|Recreate|Network|Container .* (Running|Waiting)" || true
  else stop >/dev/null; start >/dev/null; fi
}
# ---------------------------------------------------------------- genchibi expose / link: ĐÃ BỎ ở v0.23 (bí danh từ v0.21.3; CHANGELOG v0.22.0 báo trước)
# Không chạy gì: một dòng chỉ lệnh online tương ứng (stderr), thoát 2. Không còn nhánh cũ (expose --off dọn .env, --rotate, link có khoá).
removed_cmd() {
  local old="$1" a="${2:-}" new
  if [ "$old" = link ]; then case "$a" in --check) new="online recheck" ;; *) new="online" ;; esac
  else case "$a" in --quick) new="online quick" ;; --off) new="online off" ;; ""|-*|help) new="online --help" ;; *) new="online cloudflare $a" ;; esac; fi
  m removed "$old${a:+ $a}" "$new" >&2
  exit 2
}
# Máy còn GC_TUNNEL trong .env (tunnel do genchibi expose ≤ v0.22 tạo; profiles tunnel / quick đã bỏ khỏi docker-compose.yml): start / update / status
# in MỘT dòng nhắc genchibi online migrate. Tunnel cũ không còn được chạy; tiến trình / container cũ còn sót thì dừng (start, stop, migrate) —
# không để thứ mở ra Internet mà genchibi stop không quản được.
legacy_tunnel_note() { [ -z "${GC_TUNNEL:-}" ] || m gc_tunnel "$GC_TUNNEL" >&2; return 0; }
legacy_tunnel_down() {
  local pf="$HOME_DIR/logs/tunnel.pid" p
  if [ -z "${TRUST:-}" ] && [ -f "$pf" ]; then   # cloudflared cũ chạy native (≤ v0.20) — root không giết tiến trình theo tệp pid của thư mục cài
    p="$(tr -dc 0-9 < "$pf")"
    if [ -n "$p" ]; then case "$(ps -p "$p" -o command= 2>/dev/null)" in *cloudflared*) kill "$p" 2>/dev/null || true ;; esac; fi   # chỉ đúng cloudflared cũ (pid có thể đã bị dùng lại)
    rm -f "$pf"
  fi
  if [ "$MODE" = docker ] && [ -n "${GC_TUNNEL:-}" ]; then dk rm -f gen-chibi-tunnel gen-chibi-tunnel-quick >/dev/null 2>&1 || true; fi
  return 0
}

