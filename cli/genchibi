_t() { F=""; if [ "$UI" = vi ]; then _vi "$1"; fi; if [ -z "$F" ]; then _en "$1"; fi; if [ -z "$F" ]; then F="$1"; fi; }
# san: bỏ ký tự điều khiển (trừ \t \n) — MỌI chuỗi do app / API / thư mục cài đưa ra terminal đi qua đây (ESC không đổi được terminal của người gõ — F2)
san() { LC_ALL=C tr -d '\000-\010\013-\037\177' | LC_ALL=C awk 'BEGIN { r = sprintf("%c[%c-%c]", 194, 128, 159) } { gsub(r, ""); print }'; }   # C0 + DEL + C1 (UTF-8) — giữ \t \n
san_args() { SA=(); local a; for a in ${1+"$@"}; do case "$a" in *[[:cntrl:]]*) SA+=("$(printf '%s' "$a" | san)") ;; *) SA+=("$a") ;; esac; done; }
m()  { _t "$1"; shift; local SA; san_args ${1+"$@"}; printf "%s$F\n" "" ${SA[@]+"${SA[@]}"}; }   # "%s" + "" đứng đầu: câu bắt đầu bằng "-" không bị printf hiểu là tuỳ chọn
mn() { _t "$1"; shift; local SA; san_args ${1+"$@"}; printf "%s$F" "" ${SA[@]+"${SA[@]}"}; }
pick_ui() { case "${1:-}" in vi|vi[_.-]*|VI|VI[_.-]*|Vi) UI=vi ;; *) UI=en ;; esac; }
lang_name() { case "$1" in vi) echo "Tiếng Việt" ;; *) echo "English" ;; esac; }
# mặc định của Studio ghi trong data/settings.json › uiLang (một nguồn sự thật — server ghi). sed thuần: không cần node / jq, chạy được với bash 3.2
settings_lang() { rd data/settings.json | sed -n 's/.*"uiLang"[[:space:]]*:[[:space:]]*"\([A-Za-z_-]*\)".*/\1/p' | head -1 || true; }
ENV_LANG="${GC_LANG:-}"   # GC_LANG=vi genchibi … (biến môi trường) thắng giá trị trong .env
pick_ui "$ENV_LANG"

HOME_DIR="${GC_HOME:-__GC_HOME__}"
# thư mục TIN CẬY của root (v0.23.1, CNS-233 / CNS-257): install.sh thay __GC_TRUST__ bằng ~/.local/lib/gen-chibi của người cài (root). Bản trong releases/ (chưa thay) → $HOME/.local/lib/gen-chibi
TRUST_BAKED="__GC_TRUST__"
# đường TUYỆT ĐỐI của lệnh owner gõ (CNS-269): thẻ nối agent + genchibi agent connect dùng đường này — ứng dụng mở từ Dock / menu không thấy PATH của terminal.
# Bản ngoài (~/.local/bin/genchibi) chuyển cho bản trong qua GC_CLI_SELF, để đường ghi ra là đường owner thật sự gọi
case "$0" in /*) _self="$0" ;; */*) _self="$(cd "$(dirname "$0")" 2>/dev/null && pwd)/$(basename "$0")" ;; *) _self="$(command -v "$0" 2>/dev/null || printf '%s' "$0")" ;; esac
SELF_FILE="$_self"; CLI_SELF="${GC_CLI_SELF:-$_self}"; unset _self
