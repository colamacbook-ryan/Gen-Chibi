# mã setup (v0.21 §3.4): server ghi data/setup-code.txt (0600) — dòng 1 "XXXXX-XXXXX", dòng 2 "expires=<epoch giây>"; có tệp = chưa có mật khẩu chủ.
# setup_code [phút]: in mã nếu còn hạn ít nhất <phút> (mặc định 0); không thì in rỗng
setup_code() {
  local f=data/setup-code.txt c e now
  [ -r "$f" ] || return 0
  c="$(sed -n '1p' "$f" | tr -d ' \r')"; e="$(sed -n 's/^expires=\([0-9]*\).*/\1/p' "$f")"; now="$(date +%s)"
  case "$c" in [0-9A-Z][0-9A-Z][0-9A-Z][0-9A-Z][0-9A-Z]-[0-9A-Z][0-9A-Z][0-9A-Z][0-9A-Z][0-9A-Z]) ;; *) return 0 ;; esac
  [ -n "$e" ] && [ "$e" -gt $((now + ${1:-0} * 60)) ] && printf '%s' "$c"
  return 0
}
setup_until() { local e; e="$(sed -n 's/^expires=\([0-9]*\).*/\1/p' data/setup-code.txt 2>/dev/null)"; [ -n "$e" ] && { date -d "@$e" '+%H:%M' 2>/dev/null || date -r "$e" '+%H:%M' 2>/dev/null; }; return 0; }
# genchibi open: chưa có mật khẩu chủ → mở trang đặt mật khẩu với mã setup điền sẵn; mã sắp hết hạn → xin mã mới qua API (token chủ) rồi đọc lại tệp.
# Có mật khẩu rồi → mở trang chính (đăng nhập một lần, máy nhớ 30 ngày).
# MÃ KHÔNG BAO GIỜ NẰM TRONG argv (review bảo mật O1): argv của open / xdg-open / trình duyệt đọc được qua /proc/<pid>/cmdline bởi MỌI user của máy — user khác
# đọc được mã thì đặt mật khẩu trước chủ. Cách làm (kiểu Jupyter): ghi tệp HTML chuyển hướng 0600 trong run/ (0700) của thư mục cài — chỉ chủ đọc được — chứa
# location.replace('http://localhost:<cổng>/setup#code=<mã>') (mã ở fragment: không gửi lên server, không vào log), rồi mở ĐƯỜNG DẪN TỆP. Tệp tự xoá sau 2 phút
# và ở lần `genchibi open` sau. Không mở được trang (máy không có trình duyệt, trình duyệt bị sandbox không đọc được tệp): in /setup + mã ra terminal (builtin, không argv).
open_ui() {
  local u="http://localhost:$PORT" st c f=""
  st="$(curl -fsS -m 5 "$URL/api/auth/state" 2>/dev/null || true)"
  if echo "$st" | grep -q '"password":false'; then
    c="$(setup_code 5)"
    if [ -z "$c" ]; then api POST /api/auth/setup-code >/dev/null 2>&1 || true; c="$(setup_code 5)"; fi
    if [ -n "$c" ]; then
      m open_setup
      mkdir -p run && chmod 700 run && rm -f run/open-setup-*.html
      f="$HOME_DIR/run/open-setup-$(rand_hex 8).html"
      ( umask 077; printf '<!doctype html>\n<meta charset="utf-8"><meta name="referrer" content="no-referrer"><title>gen-chibi setup</title>\n<script>location.replace("%s/setup#code=%s")</script>\n<p><a href="%s/setup#code=%s">gen-chibi: set the owner password</a></p>\n' "$u" "$c" "$u" "$c" > "$f" )
      chmod 600 "$f"
      m open_code "$u/setup" "$c"
      u="$u/setup"
      ( sleep 120; rm -f "$f" ) </dev/null >/dev/null 2>&1 &
    fi
  fi
  local t="${f:-$u}"   # có mã → mở TỆP (argv chỉ có đường dẫn tệp); không mã → mở URL trơn
  (command -v open >/dev/null && open "$t") || (command -v xdg-open >/dev/null && xdg-open "$t") || echo "$u"
}
# genchibi password: đặt / đặt lại mật khẩu chủ (quên mật khẩu: ai vào được máy chủ là chủ — §3.3). Hỏi ẩn hai lần (không có terminal: đọc một dòng stdin).
# App đang chạy → POST /api/auth/password bằng token chủ (server thu hồi phiên trong bộ nhớ, nhất quán; mật khẩu + token đi qua stdin của curl, không vào argv).
# App dừng → ghi thẳng data/auth.json bằng server/auth-cli.js (cùng mã băm của server; Docker chạy trong container một lần). Không ghi tệp khi app chạy: server đang giữ
# auth.json trong bộ nhớ sẽ ghi đè lên.
cfg_esc() { local s="$1"; s="${s//\\/\\\\}"; s="${s//\"/\\\"}"; printf '%s' "$s"; }   # \ và " → thoát (dùng cho chuỗi JSON rồi chuỗi cấu hình curl)
password_cmd() {
  local p1="" p2="" r code
  if [ -t 0 ]; then
    read -r -s -p "$(mn pw_ask)" p1; echo; read -r -s -p "$(mn pw_again)" p2; echo
    [ "$p1" = "$p2" ] || { m pw_mismatch >&2; exit 1; }
  else IFS= read -r p1 || true; fi
  case "$p1" in *[[:cntrl:]]*) m pw_ctrl >&2; exit 1 ;; esac
  [ "${#p1}" -ge 12 ] || { m pw_short >&2; exit 1; }
  if curl -fsS -m 5 "$URL/api/health" >/dev/null 2>&1; then
    r="$( { auth_cfg; printf 'data = "%s"\n' "$(cfg_esc "{\"password\":\"$(cfg_esc "$p1")\"}")"; } | curl -sS -K - -X POST -H 'X-GC-Request: 1' -H "X-GC-Lang: $UI" -H 'Content-Type: application/json' -w '\n%{http_code}' "$URL/api/auth/password" 2>&1)" || true
    code="$(printf '%s' "$r" | tail -1)"
    if [ "$code" = 200 ]; then m pw_done "$(printf '%s' "$r" | sed -n '1p' | json revoked)"; else m pw_fail "$(printf '%s' "$r" | sed -n '1p' | json error)" >&2; exit 1; fi
  else
    if [ "$MODE" = docker ]; then r="$(printf '%s\n' "$p1" | compose run --rm -T --no-deps app node /install/current/server/auth-cli.js password "$UI" 2>&1)" || { m pw_fail "$r" >&2; exit 1; }
    else r="$(printf '%s\n' "$p1" | GC_HOME="$HOME_DIR" node "$HOME_DIR/current/server/auth-cli.js" password "$UI" 2>&1)" || { m pw_fail "$r" >&2; exit 1; }; fi
    m pw_done_off
  fi
}

sync_compose() {
