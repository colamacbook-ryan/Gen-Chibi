# Bản cài Docker: thư mục cài là bind mount ./:/install của container — app (nếu bị chiếm) ghi được TOÀN BỘ. Ai gõ genchibi (root, hay user trong nhóm docker
# — tương đương root) → KHÔNG BAO GIỜ chạy / nạp tệp nào trong đó:
#   (a) lệnh là bản tự đủ: ~/.local/bin/genchibi (trình cài chép) → $TD/genchibi (bản mới nhất ĐÃ KIỂM — tải gói phát hành + SHA256SUMS); không exec current/
#   (b) .env đọc như DỮ LIỆU (env_load: KHOÁ=giá trị, danh sách khoá cho phép, không source / eval)
#   (c) compose: $TD/rel/<bản>/ (gói đã kiểm) + --project-directory thư mục cài + --env-file $TD/run/compose.env (đã lọc); override chỉ khi đã duyệt
#   (d) root: mọi đọc / ghi trong thư mục cài chạy bằng chủ của nó (as_app: setpriv → sudo -u '#uid'), cwd = thư mục cài (đi được cả khi cha là /root 0700)
# $TD: root → home của uid 0 theo passwd (KHÔNG theo $HOME — sudo -E / HOME của user, CNS-284); user → $HOME của chính mình (container chỉ thấy /install).
# Chế độ: $TD/installs — mỗi dòng "<chế độ> <đường thật thư mục cài>" (trình cài / lần đầu ghi — .env không đổi được nó về sau); chưa có dòng cho thư mục này
# → GC_MODE của .env (dữ liệu). TRUST = chế độ docker, mọi uid. Theo từng thư mục cài: một user có thể có bản native + bản Docker.
# Native (không container): app chạy bằng chính user này, không có ranh giới để giữ → như cũ (exec current/cli/genchibi) — nói rõ trong README.
IS_ROOT=""; [ "$(id -u)" = 0 ] && IS_ROOT=1
dir_ids() { ls -ldn "$1/." 2>/dev/null | awk '{ print $3 " " $4 }'; }
APP_UID=""; APP_GID=""; read -r APP_UID APP_GID <<EOF_IDS
$(dir_ids "$HOME_DIR")
EOF_IDS
DROP=""; [ -n "$IS_ROOT" ] && [ -n "$APP_UID" ] && [ "$APP_UID" != 0 ] && DROP=1   # root trên thư mục của user khác → hạ quyền khi đụng tệp trong đó
TRUST=""; TD=""; BOOT=""
# path_safe P: P và mọi thư mục cha thuộc chính mình hoặc root, không ai khác ghi được (trừ thư mục dính bit t như /tmp), không ACL mở rộng
# (getfacl, nếu có) — không ai khác đổi tên / tráo được
path_safe() {
  local p="$1" l
  while :; do
    [ -e "$p" ] && [ ! -L "$p" ] || return 1
    l="$(ls -ldn "$p" 2>/dev/null)" || return 1
    if [ ! -O "$p" ] && [ "$(printf '%s' "$l" | awk '{ print $3 }')" != 0 ]; then return 1; fi
    case "$l" in d????????[tT]*) ;; ?????w*|????????w*) return 1 ;; esac
    if command -v getfacl >/dev/null 2>&1 && [ -n "$(getfacl -cp "$p" 2>/dev/null | grep -Ev '^(user|group|other|mask)::|^$' || true)" ]; then return 1; fi
    [ "$p" = / ] && return 0
    p="$(dirname "$p")"
  done
}
file_safe() { [ -f "$1" ] && [ ! -L "$1" ] && [ -O "$1" ] && path_safe "$1"; }
# as_app LỆNH…: root trên thư mục của user khác → chạy bằng user đó (môi trường sạch env -i, cwd hiện tại); không hạ được → từ chối. Còn lại chạy thẳng
as_app() {
  if [ -z "${DROP:-}" ]; then ${1+"$@"}; return; fi
  if command -v setpriv >/dev/null 2>&1; then setpriv --reuid="$APP_UID" --regid="$APP_GID" --clear-groups -- env -i PATH="$PATH" LC_ALL=C ${1+"$@"}
  elif command -v sudo >/dev/null 2>&1; then sudo -n -u "#$APP_UID" -g "#$APP_GID" -- env -i PATH="$PATH" LC_ALL=C ${1+"$@"}
  else m root_nodrop "$APP_UID" >&2; return 1; fi
}
rd() { ( cd "$HOME_DIR" && as_app cat -- "$1" ) 2>/dev/null; }   # đọc một tệp của thư mục cài (đường tương đối, như dữ liệu)
home_of() { # home của uid theo passwd (getent → /etc/passwd → dscl macOS)
  local h=""
  h="$(getent passwd "$1" 2>/dev/null | cut -d: -f6)" || h=""
  [ -n "$h" ] || h="$(awk -F: -v u="$1" '$3 == u { print $6; exit }' /etc/passwd 2>/dev/null)" || h=""
  [ -n "$h" ] || { [ "$1" = 0 ] && h="$(dscl . -read /Users/root NFSHomeDirectory 2>/dev/null | awk '{ print $2 }')"; } || h=""
  [ -n "$h" ] || { [ "$1" = 0 ] && h=/root; }
  printf '%s' "$h"
}
# Docker cài bằng snap (Ubuntu): docker / compose bị giới hạn bởi interface "home" — KHÔNG đọc được thư mục ẩn trong home (~/.local) → $TD ở đường không ẩn
snap_docker() {
  local p r; p="$(command -v docker 2>/dev/null)" || p=""; [ -n "$p" ] || return 1
  r="$(readlink -f "$p" 2>/dev/null)" || r="$p"
  case "$p:$r" in /snap/*|*:/snap/*) return 0 ;; esac
  command -v snap >/dev/null 2>&1 && snap list docker >/dev/null 2>&1
}
td_default() { if snap_docker; then printf '%s/gen-chibi-trust' "$1"; else printf '%s/.local/lib/gen-chibi' "$1"; fi; }   # MỘT chỗ chọn $TD (trình cài dùng chung hàm này)
# root: $HOME chỉ khi nó (và mọi thư mục cha) an toàn — thuộc root, không ai khác ghi được; không thì home của uid 0 theo passwd (sudo -E / HOME của user — CNS-284)
if [ -n "$IS_ROOT" ]; then if [ -n "${HOME:-}" ] && path_safe "$HOME"; then TRUST_HOME="$HOME"; else TRUST_HOME="$(home_of 0)"; fi; else TRUST_HOME="$HOME"; fi
case "$TRUST_BAKED" in __GC_TRUST*) TD="$(td_default "$TRUST_HOME")" ;; *) TD="$TRUST_BAKED" ;; esac
# thư mục gần nhất đã có trên đường $TD phải an toàn TRƯỚC khi mkdir (CNS-284) — không an toàn (vd bản chép của user chạy bằng root) → $TD mặc định của mình
td_parent_ok() { local p="$1"; while [ ! -e "$p" ]; do p="$(dirname "$p")"; done; path_safe "$p"; }
td_parent_ok "$TD" || TD="$(td_default "$TRUST_HOME")"
TI=""; EDGE_DIR=""   # TRUST: $TD/i/BĂM(đường thật thư mục cài) — trạng thái RIÊNG của bản cài này (override đã duyệt, compose.env, edge — CNS-293); đặt sau sha256_of
# nhóm đặc quyền: container / tệp không bao giờ chạy với gid của root, docker, sudo, wheel, adm, admin
priv_gid() { local n x; [ "$1" = 0 ] && return 0; for n in docker sudo wheel adm admin root; do x="$(getent group "$n" 2>/dev/null | cut -d: -f3)" || x=""; [ "$x" != "$1" ] || [ -z "$x" ] || return 0; done; return 1; }
MODE_T=""
mode_get() { file_safe "$TD/installs" || return 0; awk -v p="$HOME_PHYS" '{ m = $1; sub(/^[^ ]* /, ""); if ($0 == p) r = m } END { print r }' "$TD/installs"; }
mode_put() { # mode_put CHẾ_ĐỘ — chốt chế độ của thư mục cài này (thay dòng cũ của nó)
  local t; t="$(mktemp "$TD/installs.XXXXXX" 2>/dev/null)" || return 0
  { if file_safe "$TD/installs"; then awk -v p="$HOME_PHYS" '{ l = $0; sub(/^[^ ]* /, ""); if ($0 != p) print l }' "$TD/installs"; fi; [ -z "$1" ] || printf '%s %s\n' "$1" "$HOME_PHYS"; } > "$t" && chmod 600 "$t" && mv -f "$t" "$TD/installs"
}
# bản ghi chế độ có mà không an toàn (người khác ghi / tráo được) → KHÔNG đoán theo .env (fail closed — .env GC_MODE=native sẽ exec mã của container)
if [ -e "$TD/installs" ] || [ -L "$TD/installs" ]; then file_safe "$TD/installs" || { m td_unsafe "$TD/installs" >&2; exit 1; }; fi
# dấu Docker: container compose của chính thư mục này (nhãn working_dir do compose gắn) — chỉ hỏi khi phải đoán (chưa có bản ghi nào)
# Đóng khi nghi ngờ: máy có docker mà hỏi không được (quyền, daemon…) → coi như CÓ dấu. Không dùng dk (chưa định nghĩa ở đây, và GC_DOCKER_VIA đến từ .env)
docker_marked() {
  command -v docker >/dev/null 2>&1 || return 1   # máy không có Docker → không thể là bản cài Docker
  local d o
  for d in "$HOME_PHYS" "$HOME_DIR"; do
    o="$(docker ps -aq --filter "label=com.docker.compose.project.working_dir=$d" 2>/dev/null)" || return 0
    [ -z "$o" ] || return 0
  done
  return 1
}
# chưa có tệp bản ghi nào — và chắc chắn là chưa có: thư mục chứa nó đọc được (không đọc được → coi như CÓ bản ghi, không đoán native)
rec_absent() { local p="$TD"; while [ ! -e "$p" ] && [ ! -L "$p" ]; do p="$(dirname "$p")"; done; [ -d "$p" ] && [ -r "$p" ] && [ -x "$p" ] && [ ! -e "$TD/installs" ] && [ ! -L "$TD/installs" ]; }
MODE_GUESS=""   # .env nói native nhưng không chứng minh được → mô hình Docker, KHÔNG ghi bản ghi (chủ cài lại --native là xong), nhắc mỗi lần
MODE_T="$(mode_get)" || MODE_T=""
case "$MODE_T" in docker|native) ;; *)
  # chưa có bản ghi cho thư mục này: native CHỈ khi chưa có tệp bản ghi nào (bản cài ≤ v0.23.0), thư mục thuộc chính người gõ, .env nói native và không có
  # container nào của nó. Mọi trường hợp khác → docker (mô hình tin cậy) — hoặc từ chối khi root đứng trên bản native của user khác
  MODE_T="$(rd .env | sed -n 's/^\(export \)\{0,1\}GC_MODE=["'"'"']\{0,1\}\([a-z]*\).*/\2/p' | tail -n 1)" || MODE_T=""
  if [ "$MODE_T" = native ]; then
    if [ -n "$DROP" ]; then :
    elif rec_absent && [ "$APP_UID" = "$(id -u)" ] && ! docker_marked; then :
    else MODE_T=docker; MODE_GUESS=1; fi
  else MODE_T=docker; fi ;;
esac
# root + thư mục của user khác + native → root sẽ phải chạy node launcher.js của user đó → từ chối
if [ -n "$DROP" ] && [ "$MODE_T" != docker ]; then m root_native "$HOME_DIR" "$APP_UID" >&2; exit 1; fi
[ "$MODE_T" = docker ] && TRUST=1
# user thường mà thư mục cài thuộc root (không ghi được nó) → container chạy bằng chính user này (không bao giờ uid 0)
if [ -z "$IS_ROOT" ] && [ "$APP_UID" = 0 ]; then APP_UID="$(id -u)"; APP_GID="$(id -g)"; fi
if [ -n "$TRUST" ]; then
  td_parent_ok "$TD" || { m td_unsafe "$TD" >&2; exit 1; }
  ( umask 077; mkdir -p "$TD/rel" "$TD/run" ) 2>/dev/null || true
  [ -d "$TD" ] && TD="$(cd -P "$TD" && pwd)"
  path_safe "$TD" || { m td_unsafe "$TD" >&2; exit 1; }
  case "$TD/" in "$HOME_PHYS"/*) m td_in_install "$TD" "$HOME_DIR" >&2; exit 1 ;; esac   # container ghi được → không còn là chỗ tin cậy
  if [ -z "$(mode_get)" ] && [ -z "$MODE_GUESS" ]; then
    # một bản cài — một tài khoản giữ bản duyệt / edge (CNS-293): root trên bản cài mà chủ của nó đã quản lý (bản ghi trong $TD của chủ) → bảo dùng tài khoản đó
    if [ -n "$DROP" ]; then
      UTD="$(td_default "$(home_of "$APP_UID")")"
      if [ -r "$UTD/installs" ] && awk -v p="$HOME_PHYS" '{ sub(/^[^ ]* /, ""); if ($0 == p) f = 1 } END { exit !f }' "$UTD/installs" 2>/dev/null; then m td_other "$HOME_DIR" "$APP_UID" >&2; exit 1; fi
    fi
    mode_put docker 2>/dev/null || true
  fi
  # bản mới nhất đã kiểm ($TD/genchibi) thắng bản trong PATH
  if [ -z "${GC_CLI_INNER:-}" ] && [ "$SELF_FILE" != "$TD/genchibi" ] && file_safe "$TD/genchibi"; then
    GC_CF_TOKEN="${GC_CF_TOKEN-}" GC_CLI_INNER=1 GC_HOME="$HOME_DIR" GC_CLI_SELF="$CLI_SELF" exec bash "$TD/genchibi" ${1+"$@"}
  fi
  # user thường trên bản cài trình cài dựng bằng sudo (dấu run/trust-owner — chỉ để nhắc, không quyết gì): bản duyệt / edge của root ở tài khoản root
  if [ -z "$IS_ROOT" ] && [ "$(rd run/trust-owner | head -n 1)" = root ]; then m td_root_owned "${CLI_SELF:-genchibi}" >&2; fi
  [ -z "$MODE_GUESS" ] || m mode_guess >&2
  # chạy từ TRONG thư mục cài (lệnh cũ ≤ v0.23.0 exec sang current/cli/genchibi) → tự lắp lệnh đã kiểm, thay các lệnh cũ, chuyển sang (trust_boot, dưới)
  case "$SELF_FILE" in "$HOME_DIR"/*|"$HOME_PHYS"/*) BOOT=1 ;; esac
  case "$CLI_SELF" in "$HOME_DIR"/*|"$HOME_PHYS"/*) CLI_SELF="" ;; esac   # đường thật owner gõ không biết (lệnh ≤ v0.22 không truyền GC_CLI_SELF) → trust_boot dò
else
  # native: app chạy bằng chính user này (không container) — lệnh đi theo bản cài như trước
  INNER="$HOME_DIR/current/cli/genchibi"
  if [ -z "${GC_CLI_INNER:-}" ] && [ -f "$INNER" ]; then GC_CF_TOKEN="${GC_CF_TOKEN-}" GC_CLI_INNER=1 GC_HOME="$HOME_DIR" GC_CLI_SELF="$CLI_SELF" exec bash "$INNER" ${1+"$@"}; fi
fi
ORIG_PWD="$PWD"   # thư mục người gọi lệnh (agent skill cài vào dự án của họ, không phải thư mục cài)
cd "$HOME_DIR"

# aw TỆP [chế-độ]: stdin → TỆP (tệp tạm cạnh nó rồi mv — không ghi xuyên symlink có sẵn), bằng user của thư mục cài; chế độ mặc định 600
aw() { as_app sh -c 'umask 077; rm -f "$1.gc-tmp" && cat > "$1.gc-tmp" && chmod "$2" "$1.gc-tmp" && mv -f "$1.gc-tmp" "$1"' sh "$1" "${2:-600}"; }

# .env = DỮ LIỆU (CNS-233 b): mỗi dòng KHOÁ=giá trị (chấp nhận "export " đầu dòng, giá trị trong "…" / '…' lấy nguyên văn), chỉ khoá trong ENV_KEYS;
# không source, không eval, không mở rộng $(…) / `…` / ${…}. Móc kiểm thử GC_TEST* không bao giờ từ .env (chỉ từ shell gọi lệnh — review bảo mật 🟡7).
# Thường (không TRUST): export như trước (app native nhận môi trường). TRUST: không export gì — compose nhận bản đã lọc qua --env-file (compose_env).
ENV_KEYS=" GC_MODE GC_PORT GC_BIND GC_MASTER_KEY GC_AUTO_UPDATE GC_UID GC_GID GC_REPO GC_LANG GC_GITHUB_TOKEN GC_API_TOKEN GC_ALLOWED_HOSTS GC_MCP_KEY GC_PUBLIC_URL GC_OAUTH_REDIRECTS GC_OAUTH_ACCESS_TTL GC_CLIENT_IP_HEADER GC_EXTRA_CA GC_TUNNEL COMPOSE_PROFILES GC_DOCKER_VIA GC_INSTALLED_BY GC_LISTEN GC_NO_AUTOCHECK GC_FEED_URL GC_HEALTH_WINDOW_MS GC_EDGE_HEALTH_WINDOW_MS HTTPS_PROXY https_proxy HTTP_PROXY http_proxy NO_PROXY no_proxy "
ENV_RAW=""   # các dòng KHOÁ=giá trị đã nhận (compose_env lọc lại)
ENV_ALL=""   # MỌI dòng KHOÁ=giá trị hợp lệ (dữ liệu, không đặt biến) — compose_env lấy khoá mà override đã duyệt cần (CNS-281)
env_line() { # env_line DÒNG → EK / EV (0) hoặc 1: KHOÁ=giá trị, "export " đầu dòng chấp nhận, "…" / '…' bỏ nháy, không ký tự điều khiển
  local line="${1%$'\r'}"
  case "$line" in "export "*) line="${line#export }" ;; esac
  case "$line" in [A-Za-z_]*=*) ;; *) return 1 ;; esac
  EK="${line%%=*}"; EV="${line#*=}"
  case "$EK" in *[!A-Za-z0-9_]*) return 1 ;; esac
  case "$EV" in \"*\") EV="${EV#\"}"; EV="${EV%\"}" ;; \'*\') EV="${EV#\'}"; EV="${EV%\'}" ;; esac
  case "$EV" in *[[:cntrl:]]*) return 1 ;; esac
  return 0
}
env_get() { # env_get KHOÁ → giá trị cuối trong .env (một nguồn đọc — cùng luật với env_load)
  local line v=""; while IFS= read -r line || [ -n "$line" ]; do env_line "$line" && [ "$EK" = "$1" ] && v="$EV"; done < <(rd .env); printf '%s' "$v"
}
env_load() {
  local line EK EV
  [ -f .env ] || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    env_line "$line" || continue
    case "$EK" in GC_TEST*) continue ;; esac
    ENV_ALL="$ENV_ALL$EK=$EV"$'\n'
    case "$ENV_KEYS" in *" $EK "*) ;; *) continue ;; esac
    ENV_RAW="$ENV_RAW$EK=$EV"$'\n'
    # TRUST: proxy của .env chỉ là dữ liệu cho container (compose_env) — không đè / gỡ export proxy sẵn có của người gọi (CNS-283)
    if [ -n "$TRUST" ]; then case "$EK" in HTTPS_PROXY|https_proxy|HTTP_PROXY|http_proxy|NO_PROXY|no_proxy) continue ;; esac; fi
    printf -v "$EK" '%s' "$EV"
    if [ -z "$TRUST" ]; then export "$EK"; else export -n "$EK" 2>/dev/null || true; fi
  done < <(rd .env)
}
env_load
# GC_LANG (biến môi trường › .env) rỗng — bản cài ≤ v0.19 nâng cấp, hoặc cài lại không chọn — thì CLI nói theo mặc định của Studio (CNS-152)
UI_SRC="${ENV_LANG:-${GC_LANG:-}}"; [ -n "$UI_SRC" ] || UI_SRC="$(settings_lang)"
pick_ui "$UI_SRC"
MODE="${GC_MODE:-docker}"; PORT="${GC_PORT:-7480}"
case "$PORT" in ''|*[!0-9]*) PORT=7480 ;; esac
[ "$PORT" -ge 1 ] && [ "$PORT" -le 65535 ] || PORT=7480
URL="http://127.0.0.1:$PORT"
PIDF="$HOME_DIR/logs/launcher.pid"; LOG="$HOME_DIR/logs/gen-chibi.log"
# TRUST: chế độ đã chốt ở $TD/installs — .env (container ghi được) đổi GC_MODE=native không làm genchibi chạy node launcher.js của thư mục cài
[ -z "$TRUST" ] || MODE=docker

# token chủ (v0.21, CNS-195): GC_API_TOKEN trong .env → data/owner-token (server tự sinh khi .env trống). Đọc lúc gọi (server có thể vừa sinh tệp).
# Không export, không in ra màn hình; đi qua stdin (curl -K -), không nằm trong argv → không lộ trong `ps`
# Token chỉ gồm ký tự an toàn (CNS-257): nó vào dòng `header = "…"` của cấu hình curl (-K -) — " hay xuống dòng trong .env / owner-token sẽ chèn được chỉ thị
# curl (vd output = <tệp>) chạy bằng root. Sai dạng → coi như không có token
owner_token() {
  local t=""
  if [ -n "${GC_API_TOKEN:-}" ]; then t="$GC_API_TOKEN"
  else t="$(rd data/owner-token | tr -d ' \r\n')" || t=""; fi
  case "$t" in *[!A-Za-z0-9._~+/=-]*) t="" ;; esac
  printf '%s' "$t"
}
auth_cfg() { local t; t="$(owner_token)"; if [ -n "$t" ]; then printf 'header = "Authorization: Bearer %s"\n' "$t"; fi; }
api() { auth_cfg | curl -fsS -K - -X "$1" -H 'X-GC-Request: 1' -H "X-GC-Lang: $UI" -H 'Content-Type: application/json' ${3:+-d "$3"} "$URL$2"; }   # X-GC-Lang: câu server trả về theo ngôn ngữ CLI
running_native() { [ -f "$PIDF" ] && kill -0 "$(cat "$PIDF")" 2>/dev/null; }
json() { ( cd / && node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{const o=JSON.parse(s);const k=process.argv[1].split(".");let v=o;for(const x of k)v=v==null?v:v[x];console.log(v===undefined?"":typeof v==="object"?JSON.stringify(v):v)})' "$1" ) 2>/dev/null || sed -n "s/.*\"$1\": *\"\{0,1\}\([^\",}]*\).*/\1/p"; }

# ---------------------------------------------------------------- docker compose: LUÔN ghép -f tường minh, KHÔNG BAO GIỜ đặt / ghi COMPOSE_FILE
# (CNS-169: COMPOSE_FILE=a:b làm compose bỏ qua docker-compose.override.yml → mất service riêng của chủ, vd cổng đăng nhập của Ryan).
# Thứ tự: docker-compose.yml · docker-compose.edge.yml (khi đã bật edge Caddy) · override của chủ (sau cùng, để chủ chỉnh được cả edge).
EDGE_MARK="edge/caddy.enabled"
compose_override() { # tệp override compose tự nạp khi không có -f (cùng thứ tự tìm của docker compose)
  local f; for f in compose.override.yml compose.override.yaml docker-compose.override.yml docker-compose.override.yaml; do [ -f "$f" ] && { echo "$f"; return 0; }; done; return 0
}
compose_files() { # in các cặp "-f tệp", mỗi phần một dòng
  local ov d
  if [ -n "${TRUST:-}" ]; then   # root (CNS-257): tệp từ gói đã kiểm + override root đã duyệt; đường tương đối vẫn tính từ thư mục cài; .env đã lọc
    # có override đã duyệt → LUÔN đúng dạng chuẩn đã phân giải + kiểm ($TI/effective.yml — lệnh tạo container: override_gate vừa ghi lại nó), không bao giờ
    # tệp override thô (vòng 8, 🔴B). Đã duyệt mà chưa có dạng chuẩn (chỉ lệnh không tạo container tới được đây) → chỉ tệp đã kiểm
    if file_safe "$TI/override.yml" && file_safe "$TI/effective.yml"; then
