# ---------------------------------------------------------------- genchibi doctor (v0.23.1, CNS-234): kiểm sức khoẻ bản cài + chuyển user container cũ sang `genchibi`
# Bản cài v0.21.0–0.21.2 bằng root không sudo đoán GC_UID=1000 — trên máy dùng chung, 1000 có thể là NGƯỜI KHÁC (người đó ghi được thư mục cài).
# Dấu hiệu: chủ thư mục cài là uid 1000, và không biết ai cài (GC_INSTALLED_BY chưa có — trình cài ghi từ v0.23.1) / cài bằng root không sudo / sudo của người khác.
# Chuyển: dừng app, tạo / dùng lại tài khoản hệ thống genchibi (nologin), đổi chủ CHỈ các tệp đang thuộc uid cũ (find -user, không theo symlink, một filesystem),
# .env GC_UID / GC_GID / GC_INSTALLED_BY, chạy lại. Hỏi trước (terminal) · --yes không hỏi. Chỉ root làm được; user thường chỉ xem.
SYS_USER=genchibi
DR_BAD=0
dr() { printf '  %s %s\n' "$1" "$2"; [ "$1" != "✗" ] || DR_BAD=$((DR_BAD + 1)); }   # dr ✓ / ! / ✗ / · "câu đã dịch"
sys_ids() { local u g; u="$(id -u "$SYS_USER" 2>/dev/null)" || return 1; g="$(id -g "$SYS_USER" 2>/dev/null)" || return 1
  case "$u$g" in ''|*[!0-9]*) return 1 ;; esac; [ "$u" != 0 ] && [ "$g" != 0 ] || return 1; NU="$u"; NG="$g"; }
sys_user_make() { # như install.sh sys_user: dùng lại / useradd --system / adduser -S (BusyBox)
  local nl; nl="$(command -v nologin 2>/dev/null || true)"; [ -n "$nl" ] || nl=/usr/sbin/nologin
  if id -u "$SYS_USER" >/dev/null 2>&1; then sys_ids; return; fi
  if command -v useradd >/dev/null 2>&1 && useradd --system --no-create-home --home-dir /nonexistent --shell "$nl" --user-group "$SYS_USER" >/dev/null 2>&1 && sys_ids; then return 0; fi
  if command -v adduser >/dev/null 2>&1; then
    command -v addgroup >/dev/null 2>&1 && addgroup -S "$SYS_USER" >/dev/null 2>&1 || true
    adduser -S -D -H -h /nonexistent -s "$nl" -G "$SYS_USER" "$SYS_USER" >/dev/null 2>&1 || adduser -S -D -H -h /nonexistent -s "$nl" "$SYS_USER" >/dev/null 2>&1 || true
    sys_ids && return 0
  fi
  return 1
}
doctor_migrate() {
  local old="$APP_UID" NU="" NG=""
  sys_user_make || { m dr_mig_nouser "$SYS_USER" >&2; return 1; }
  [ "$NU" != "$old" ] || { m dr_mig_same "$SYS_USER" "$NU"; return 0; }
  m dr_mig_stop; stop >/dev/null 2>&1 || { m dr_mig_stopfail >&2; return 1; }   # app còn chạy (còn ghi) → không đổi chủ dưới chân nó
  # app đã dừng mà uid cũ còn tiến trình → có NGƯỜI đang dùng tài khoản đó (máy dùng chung): không lấy tệp của họ; chạy lại app như cũ
  if ps -eo uid= 2>/dev/null | awk -v u="$old" '$1 == u { f = 1 } END { exit !f }'; then m dr_mig_busy "$old" >&2; ( start ) >/dev/null 2>&1 || true; return 1; fi
  # chỉ tệp đang thuộc uid cũ, không theo symlink, một filesystem, không tệp có nhiều liên kết cứng (liên kết tới tệp của người khác) — cả nguồn edge ở $EDGE_DIR
  # (CNS-291: không thì start ngay sau đây từ chối edge, app nằm dừng)
  # -P + -execdir: chown chạy NGAY trong thư mục chứa tệp với tên ./tệp — không đường chuỗi dài nào để container tráo một thư mục cha thành liên kết giữa chừng.
  # find từ chối -execdir khi PATH có mục tương đối → PATH chỉ giữ mục tuyệt đối
  local sp; sp="$(printf '%s' "$PATH" | tr ':' '\n' | grep '^/' | paste -sd: -)" || sp="/usr/sbin:/usr/bin:/sbin:/bin"
  PATH="$sp" find -P "$HOME_DIR" -xdev -user "$old" \( -type d -o -type l -o -links 1 \) -execdir chown -h "$NU:$NG" {} + || { m dr_mig_chown "$HOME_DIR" >&2; return 1; }
  if [ -n "$EDGE_DIR" ] && [ -d "$EDGE_DIR" ]; then PATH="$sp" find -P "$EDGE_DIR" -xdev -user "$old" \( -type d -o -type l -o -links 1 \) -execdir chown -h "$NU:$NG" {} + || { m dr_mig_chown "$EDGE_DIR" >&2; return 1; }; fi
  APP_UID="$NU"; APP_GID="$NG"
  set_env GC_UID "$NU"; set_env GC_GID "$NG"; set_env GC_INSTALLED_BY root
  m dr_mig_done "$old" "$SYS_USER" "$NU" "$NG"
  start
}
doctor_cmd() {
  local y="" a h t f st es tun rdy err mig="" by n nu who="" su="" NU="" NG="" force="" me said="" o
  for a in ${1+"$@"}; do case "$a" in --yes|-y) y=1 ;; --migrate) force=1 ;; *) m bad_opt "$a" >&2; return 2 ;; esac; done
  me="$(id -u)"
  m dr_title "$HOME_DIR" "$MODE"
