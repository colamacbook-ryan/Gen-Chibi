  backup; stop; rm -rf data.restore && mkdir data.restore && tar -xzf "$f" -C data.restore
  rm -rf data && mv data.restore/data data && rm -rf data.restore
  rm -f data/install-id
  printf '{"v":1,"at":"%s"}\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > data/restore-pending.json && chmod 600 data/restore-pending.json
  mkdir -p run && chmod 700 run && rm -f run/tunnel.token
  printf '{"tunnel":"off","online":false}\n' > run/edge-intent.json && chmod 600 run/edge-intent.json
