# ---------------------------------------------------------------- genchibi online: Go online từ dòng lệnh (v0.21 §2) — CÙNG API /api/online/* với Studio
# Mọi lời gọi mang token chủ qua stdin của curl (-K -); thân lệnh (kể cả API token Cloudflare) cũng đi qua stdin (dòng `data = "…"` của cấu hình curl),
# không bao giờ nằm trong argv / biến môi trường của tiến trình con / log. JSON đọc bằng awk thuần (máy Docker có thể không có node / jq).
# Mã thoát: 0 xong · 1 lỗi / dừng ở một bậc · 2 sai cách dùng · 3 đã ra Internet, chỉ còn chờ chủ đặt mật khẩu (mã setup in kèm).
NL='
'
tty_ok() { { : < /dev/tty; } 2>/dev/null; }   # có người ngồi trước terminal (kể cả curl | bash); setsid / CI thì không
ask_yn() { # ask_yn "câu hỏi" → 0 khi trả lời có (y / c / yes / có); không terminal → không
  local a=""; tty_ok || return 1
  read -r -p "$1" a < /dev/tty || return 1
  case "$a" in y|Y|yes|YES|Yes|c|C|co|có|Có) return 0 ;; *) return 1 ;; esac
}
jflat() { # JSON (stdin) → mỗi giá trị một dòng "đường<TAB>giá trị" (vd flow.steps.0.id), chuỗi đã bỏ thoát; \n trong chuỗi → \036, \t / \r → khoảng trắng
  awk '
  function ws() { while (i <= n) { c = substr(s, i, 1); if (c == " " || c == "\t" || c == "\n" || c == "\r") i++; else break } }
  function str(   r, ch, e) {
    i++; r = ""
    while (i <= n) {
      ch = substr(s, i, 1)
      if (ch == "\"") { i++; return r }
      if (ch == "\\") {
        e = substr(s, i + 1, 1); i += 2
        if (e == "u") { i += 4; r = r "?" } else if (e == "n") r = r "\036"; else if (e == "t" || e == "r" || e == "b" || e == "f") r = r " "; else r = r e
        continue
      }
      if (match(substr(s, i, 512), /^[^"\\]+/)) { r = r substr(s, i, RLENGTH); i += RLENGTH } else { r = r ch; i++ }
    }
    bad = 1; return r
  }
  function val(p,   ch, k, idx) {
    ws(); if (i > n) { bad = 1; return }
    ch = substr(s, i, 1)
    if (ch == "{") {
      i++; ws()
      if (substr(s, i, 1) == "}") { i++; print p "\t{}"; return }
      while (i <= n) {
        ws(); if (substr(s, i, 1) != "\"") { bad = 1; return }
        k = str(); ws(); if (substr(s, i, 1) != ":") { bad = 1; return }
        i++; val(p == "" ? k : p "." k); if (bad) return
        ws(); ch = substr(s, i, 1); i++
        if (ch == "}") return
        if (ch != ",") { bad = 1; return }
      }
      bad = 1; return
    }
    if (ch == "[") {
      i++; ws()
      if (substr(s, i, 1) == "]") { i++; print p "\t[]"; return }
      for (idx = 0; i <= n; idx++) {
        val(p == "" ? idx : p "." idx); if (bad) return
        ws(); ch = substr(s, i, 1); i++
        if (ch == "]") return
        if (ch != ",") { bad = 1; return }
      }
      bad = 1; return
    }
    if (ch == "\"") { k = str(); print p "\t" k; return }
    if (match(substr(s, i, 64), /^[-+0-9.eEa-z]+/)) { print p "\t" substr(s, i, RLENGTH); i += RLENGTH; return }
    bad = 1
  }
  { s = s $0 "\n" }
  END { n = length(s); i = 1; bad = 0; val(""); if (bad) exit 1 }'
}
J=""   # bảng phẳng của phản hồi gần nhất
jv() { printf '%s\n' "$J" | awk -F '\t' -v k="$1" '$1 == k { sub(/^[^\t]*\t/, ""); gsub(/\036/, " "); if ($0 != "null") print; exit }'; }   # null → rỗng
jv_raw() { printf '%s\n' "$J" | awk -F '\t' -v k="$1" '$1 == k { sub(/^[^\t]*\t/, ""); gsub(/\036/, "\n"); print; exit }'; }   # giữ xuống dòng (đoạn cấu hình proxy)
jsteps() { # các bậc của luồng: mỗi dòng "id<TAB>state<TAB>detail<TAB>fix<TAB>manual"
  printf '%s\n' "$J" | awk -F '\t' '
    match($1, /^flow\.steps\.[0-9]+\./) { k = substr($1, RSTART, RLENGTH); f = substr($1, RLENGTH + 1); v = $0; sub(/^[^\t]*\t/, "", v); gsub(/\036/, " ", v)
      if (!(k in seen)) { seen[k] = 1; order[++n] = k } a[k, f] = v }
    END { for (j = 1; j <= n; j++) { k = order[j]; d = a[k, "detail"]; x = a[k, "fix"]; if (d == "null") d = ""; if (x == "null") x = ""
      print a[k, "id"] "\t" a[k, "state"] "\t" d "\t" x "\t" a[k, "manual"] } }'
}
OCODE=""; OBODY=""
oapi() { # oapi PHƯƠNG_THỨC ĐƯỜNG [JSON] → OCODE (000 = app không trả lời), OBODY, J. Token chủ + thân lệnh đi qua stdin của curl (-K -)
  local r
  r="$( { auth_cfg; if [ -n "${3:-}" ]; then printf 'data = "%s"\n' "$(cfg_esc "$3")"; fi; } | curl -sS -m 30 -K - -X "$1" -H 'X-GC-Request: 1' -H "X-GC-Lang: $UI" -H 'Content-Type: application/json' -w '\n%{http_code}' "$URL$2" 2>/dev/null)" || true
  OCODE="$(printf '%s\n' "$r" | tail -n 1)"; OBODY="$(printf '%s\n' "$r" | sed '$d')"
  case "$OCODE" in [1-5][0-9][0-9]) ;; *) OCODE=000 ;; esac
  J="$(printf '%s\n' "$OBODY" | jflat 2>/dev/null)" || J=""
}
opost() { # opost ĐƯỜNG [JSON] — 429 (trần tần suất của app) → đợi rồi gửi lại, tối đa 5 lần
  local n=0 b="${2:-}"; [ -n "$b" ] || b='{}'
  while :; do
    oapi POST "$1" "$b"
    [ "$OCODE" = 429 ] && [ $n -lt 5 ] || return 0
    n=$((n + 1)); sleep "${GC_ONLINE_RETRY:-3}"
  done
}
online_err() { # in lỗi của phản hồi gần nhất (đã theo ngôn ngữ CLI) → luôn trả 1
  case "$OCODE" in
    000) m on_down "$URL" >&2 ;;
    401|403) m on_auth "$OCODE" "$HOME_DIR" >&2 ;;
    *) m on_err "$(jv error)" "$OCODE" >&2 ;;
  esac
  return 1
}
sname() { # tên hiển thị của một bậc
  case "$1" in
    domain) mn sn_domain ;; edge) mn sn_edge ;; port) mn sn_port ;; cert) mn sn_cert ;; public) mn sn_public ;; mcp) mn sn_mcp ;; password) mn sn_password ;;
    owner) mn sn_owner ;; token) mn sn_token ;; zone) mn sn_zone ;; tunnel) mn sn_tunnel ;; waf) mn sn_waf ;; config) mn sn_config ;; local) mn sn_local ;; remote) mn sn_remote ;;
    *) printf '%s' "$1" ;;
  esac
}
srow() { # srow "id<TAB>state<TAB>detail<TAB>fix…" — một hàng của bảng bậc (✓ / ✗ / … / ·), cách sửa dưới hàng ✗
  local id st det fix sym rest
  id="${1%%	*}"; rest="${1#*	}"; st="${rest%%	*}"; rest="${rest#*	}"; det="${rest%%	*}"; rest="${rest#*	}"; fix="${rest%%	*}"
  case "$st" in ok) sym="✓" ;; fail) sym="✗" ;; running) sym="…" ;; *) sym="·" ;; esac
  printf '  %s %-24s %s\n' "$sym" "$(sname "$id")" "$det"
  if [ "$st" = fail ] && [ -n "$fix" ]; then m on_fix "$fix"; fi
}
FIRST_ID=""; FIRST_ST=""; FIRST_MANUAL=""
first_open() { # bậc làm luồng dừng (J) → FIRST_*: bậc ✗ đầu tiên; không có thì bậc đang chờ (…); không có nữa thì bậc chưa chạy (·) đầu tiên
  # (bậc "·" đứng TRƯỚC bậc ✗ là bậc đã trả về chờ chạy lại — vd publicUrl tạm bị trả về — không phải chỗ dừng)
  local l rest st pf="" pr="" pp=""
  FIRST_ID=""; FIRST_ST=""; FIRST_MANUAL=""
  while IFS= read -r l; do
    [ -n "$l" ] || continue
    rest="${l#*	}"; st="${rest%%	*}"
    case "$st" in ok) ;; fail) [ -n "$pf" ] || pf="$l" ;; running) [ -n "$pr" ] || pr="$l" ;; *) [ -n "$pp" ] || pp="$l" ;; esac
  done <<EOF
$(jsteps)
EOF
  l="${pf:-${pr:-$pp}}"; [ -n "$l" ] || return 0
  rest="${l#*	}"; FIRST_ID="${l%%	*}"; FIRST_ST="${rest%%	*}"; FIRST_MANUAL="${l##*	}"
  return 0
}
# online_follow — theo dõi luồng vừa gửi: hỏi GET /api/online, in mỗi thay đổi của từng bậc. Bậc đang chờ (chứng chỉ, connector…) khi app đã trả lời xong
# → gửi "Kiểm lại" (POST /recheck) tới khi xong hoặc hết GC_ONLINE_TIMEOUT giây (mặc định 900).
# Trả: 0 xong · 1 lỗi · 3 chờ mật khẩu chủ · 4 CNAME có sẵn cần xác nhận · 5 WAF phải làm tay · 6 token thấy nhiều tên miền (chọn)
online_follow() {
  local shown="$NL" l key end idle=0
  FIRST_ID=""
  end=$(( $(date +%s) + ${GC_ONLINE_TIMEOUT:-900} ))
  while :; do
    oapi GET /api/online
    [ "$OCODE" = 200 ] || { online_err; return 1; }
    while IFS= read -r l; do
      [ -n "$l" ] || continue
      key="$(printf '%s' "$l" | cut -f1-3)"
      case "$shown" in *"$NL$key$NL"*) ;; *) shown="$shown$key$NL"; srow "$l" ;; esac
    done <<EOF
$(jsteps)
EOF
    if [ "$(jv busy)" = true ]; then sleep "${GC_ONLINE_POLL:-2}"; continue; fi
    [ "$(jv flow.done)" = true ] && return 0
    if [ "$(jv flow.needs)" = urlChange ]; then   # mọi bậc ✓, chính thức hoá địa chỉ mới sẽ gỡ kết nối agent cũ (luồng không biết địa chỉ lúc bắt đầu) → hỏi như lúc bắt đầu
      local from; from="$(jv publicUrl)"
      m on_url_change "${from:--}" "$(jv flow.url)" "$(jv flow.revokes)"
      if [ -n "$YES" ] || ask_yn "$(mn on_url_ask)"; then
        opost /api/online/recheck '{"confirmUrlChange":true}'
        case "$OCODE" in 2??) continue ;; *) online_err; return 1 ;; esac
      fi
      m on_url_stop >&2; return 1
    fi
    first_open
    case "$FIRST_ST" in
      fail)
        [ "$(jv flow.needs)" = confirm ] && return 4
        [ "$FIRST_ID" = waf ] && [ "$FIRST_MANUAL" = true ] && return 5
        [ "$FIRST_ID" = token ] && [ -n "$(jv flow.choices.0)" ] && return 6
        return 1 ;;
      running)
        [ "$FIRST_ID" = password ] && return 3 ;;
      *) # không bậc nào ✗ / đang chờ mà luồng chưa xong (bất thường): kiểm lại một lần, không lặp (trần tần suất của app)
        idle=$((idle + 1)); [ "$idle" -le 1 ] || { m on_failed "$(sname "${FIRST_ID:-?}")" >&2; FIRST_ID=""; return 1; } ;;
    esac
    [ "$(date +%s)" -lt "$end" ] || { m on_timeout "$(( ${GC_ONLINE_TIMEOUT:-900} / 60 ))" >&2; return 1; }
    sleep "${GC_ONLINE_RETRY:-3}"
    opost /api/online/recheck '{}'
    case "$OCODE" in 2??) ;; *) online_err; return 1 ;; esac
  done
}
YES=""; OVERWRITE=""; TOKSTDIN=""; WAFDONE=""; CFSUB=""
online_send() { # online_send ĐƯỜNG "khoá":giá-trị,… — bắt đầu một luồng; 409 needs=urlChange → hỏi (có terminal) / --yes; needs=legacy → hướng dẫn di chuyển
  local inner="$2" sep=""
  [ -z "$inner" ] || sep=","
  opost "$1" "{$inner}"
  if [ "$OCODE" = 409 ] && [ "$(jv needs)" = urlChange ]; then
    local to; to="$(jv to)"; case "$to" in ''|null) to="$(mn on_w_new)" ;; esac
    m on_url_change "$(jv from)" "$to" "$(jv revokes)"
    if [ -n "$YES" ] || ask_yn "$(mn on_url_ask)"; then opost "$1" "{$inner$sep\"confirmUrlChange\":true}"
    else m on_url_stop >&2; return 1; fi
  fi
  if [ "$OCODE" = 409 ] && [ "$(jv needs)" = legacy ]; then m on_legacy >&2; return 1; fi
  case "$OCODE" in 2??) return 0 ;; *) online_err; return 1 ;; esac
}
online_done() { # in kết quả sau khi luồng xong / chỉ còn mật khẩu; $1 = mã của online_follow → mã thoát
  local rc="$1" u code
  u="$(jv flow.url)"; [ -n "$u" ] || u="$(jv publicUrl)"
  case "$rc" in
    0)
      if [ "$(jv flow.mode)" = off ]; then m on_off_done; [ -f "$EDGE_MARK" ] && m on_off_caddy; return 0; fi
      m on_done "$u"; m on_done_studio "$u"; m on_done_mcp "$u"; return 0 ;;
    3)
      code="$(setup_code)"
      if [ -n "$code" ]; then m on_pw_wait "$u" "$u" "$code"; else m on_pw_wait_nocode "$u" "$u"; fi
      return 3 ;;
    1) [ -z "$FIRST_ID" ] || m on_failed "$(sname "$FIRST_ID")" >&2 ;;
  esac
  return "$rc"
}
cf_token() { # API token Cloudflare → CFTOK (biến shell, không export): --token-stdin · GC_CF_TOKEN (rồi xoá khỏi môi trường) · hỏi ẩn trên terminal
  CFTOK=""
  if [ -n "$TOKSTDIN" ]; then IFS= read -r CFTOK || true
  elif [ -n "${GC_CF_TOKEN:-}" ]; then CFTOK="$GC_CF_TOKEN"
  elif tty_ok; then
    oapi GET /api/online; [ -z "$(jv cloudflare.tokenLink)" ] || m cf_tok_link "$(jv cloudflare.tokenLink)"
    read -r -s -p "$(mn cf_tok_ask)" CFTOK < /dev/tty || true; printf '\n' >&2
  fi
  unset GC_CF_TOKEN   # tiến trình con (curl, awk…) không thừa hưởng
  CFTOK="${CFTOK%$'\r'}"
  [ -n "$CFTOK" ] || { m cf_tok_none >&2; return 1; }
  case "$CFTOK" in *[!A-Za-z0-9_.-]*) m cf_tok_bad >&2; CFTOK=""; return 1 ;; esac
  [ "${#CFTOK}" -ge 20 ] || { m cf_tok_bad >&2; CFTOK=""; return 1; }
}
online_status() {
  oapi GET /api/online
  [ "$OCODE" = 200 ] || { online_err; return 1; }
  local md dom u pend fm
  md="$(jv mode)"; dom="$(jv domain)"; u="$(jv publicUrl)"; pend="$(jv publicUrlPending)"
  m on_title "$md" "${dom:+ · $dom}"
  if [ -n "$u" ]; then m on_url "$u"; else m on_url_none; fi
  [ -z "$pend" ] || m on_url_pending "$pend"
  [ "$(jv flow.waitingPassword)" != true ] || m on_wait_pw "$pend" "$pend"
  fm="$(jv flow.mode)"
  if [ -n "$fm" ]; then
    if [ "$(jv busy)" = true ]; then m on_flow "$fm" "$(mn on_w_busy)"
    elif [ "$(jv flow.done)" = true ]; then m on_flow "$fm" "$(mn on_w_done) $(jv flow.doneAt)"
    else m on_flow "$fm" "$(mn on_w_stopped)"; fi
    while IFS= read -r l; do [ -z "$l" ] || srow "$l"; done <<EOF
$(jsteps)
EOF
  fi
  local cad tun es=""
  if [ "$(jv edge.caddyEnabled)" = true ]; then cad="$(mn on_w_on)"; else cad="$(mn on_w_off)"; fi
  tun="$(jv edge.intent)"
  if [ -n "$(jv edge.status.tunnel)" ] && [ "$tun" != off ]; then
    if [ -n "$(jv edge.status.error)" ]; then es=" · $(jv edge.status.error)"
    elif [ "$(jv edge.status.ready)" = true ]; then es=" · $(mn on_w_ready)"
    elif [ "$(jv edge.status.running)" = true ]; then es=" · $(mn on_w_starting)"; fi
  fi
  m on_edge "$cad" "${tun:-off}" "$es"
  [ "$(jv legacy.active)" = true ] && m on_legacy_note
  m on_hint
  return 0
}
online_go_caddy() { # genchibi online caddy <tên-miền>: bật edge Caddy nếu chưa (kiểm cổng 80/443, bật container) → POST /api/online/caddy → theo dõi
  local d="$1"
  [ "$MODE" = docker ] || { m caddy_native >&2; return 1; }
  valid_host "$d" || { m bad_domain "$d" >&2; return 2; }
  online_caddy flow
  local i; for i in $(seq 1 "${GC_EDGE_WAIT:-60}"); do [ -S edge/run/caddy-admin.sock ] && break; [ "$i" = 1 ] && m on_wait_caddy; sleep 1; done
  [ -S edge/run/caddy-admin.sock ] || { m on_caddy_nostart >&2; return 1; }
  m on_start "caddy" "$d"
  online_send /api/online/caddy "\"domain\":\"$d\"" || return 1
  online_follow && a=0 || a=$?; online_done "$a"
}
online_go_cloudflare() { # genchibi online cloudflare [<tên-miền> | <tên-con.tên-miền>] [--sub tên] [--overwrite-dns] [--token-stdin] [--yes]
  local d="${1:-}" zone="" sub="" alt="" rc
  if [ -n "$d" ]; then
    valid_host "$d" || { m bad_domain "$d" >&2; return 2; }
    if [ -n "$CFSUB" ]; then zone="$d"; sub="$CFSUB"
    elif [[ "${d#*.}" == *.* ]]; then zone="${d#*.}"; sub="${d%%.*}"; alt="$d"   # chibi.example.com → zone example.com, tên con chibi (không thấy zone đó → thử cả tên là zone)
    else zone="$d"; sub="chibi"; fi
  fi
  cf_token || return 1
  m on_start "cloudflare" "${sub:+$sub.}${zone:-?}"
  while :; do
    online_send /api/online/cloudflare "\"token\":\"$CFTOK\"${zone:+,\"zone\":\"$zone\"}${sub:+,\"sub\":\"$sub\"}" || return 1
    online_follow && rc=0 || rc=$?
    case "$rc" in
      4) # CNAME / bản ghi có sẵn: không tự đè
        if [ -n "$OVERWRITE" ] || ask_yn "$(mn cf_cname_ask)"; then
          opost /api/online/cloudflare/confirm '{"overwriteCname":true}'
          case "$OCODE" in 2??) ;; *) online_err; return 1 ;; esac
          online_follow && rc=0 || rc=$?
        else m cf_cname_stop "$zone" >&2; return 1; fi ;;
      6) # token thấy nhiều tên miền, chưa chọn
        local i=0 c pick=""
        m cf_choices
        while c="$(jv "flow.choices.$i")"; [ -n "$c" ]; do i=$((i + 1)); m cf_choice_row "$i" "$c"; done
        if tty_ok; then read -r -p "$(mn cf_choice_ask)" pick < /dev/tty || pick=""; fi
        case "$pick" in ''|*[!0-9]*) m cf_choice_stop >&2; return 1 ;; esac
        zone="$(jv "flow.choices.$((pick - 1))")"; [ -n "$zone" ] || { m cf_choice_stop >&2; return 1; }
        sub="${CFSUB:-chibi}"; YES=1; sleep 2; continue ;;
      1)
        if [ -n "$alt" ] && [ "$FIRST_ID" = token ]; then zone="$alt"; sub="${CFSUB:-chibi}"; alt=""; m cf_retry_zone "$zone" "$sub"; YES=1; sleep 2; continue; fi ;;
    esac
    break
  done
  [ "$rc" != 5 ] || { online_waf && rc=0 || rc=$?; }
  CFTOK=""
  online_done "$rc"
}
online_waf() { # WAF phải làm tay (token không có quyền WAF): cách sửa (biểu thức luật) đã in ở hàng ✗; có terminal → hỏi "đã làm chưa" rồi Kiểm lại
  local rc
  while :; do
    if [ -n "$WAFDONE" ] || ask_yn "$(mn cf_waf_ask)"; then
      WAFDONE=""
      opost /api/online/recheck '{"confirmManual":"waf"}'
      case "$OCODE" in 2??) ;; *) online_err; return 1 ;; esac
      online_follow && rc=0 || rc=$?
      [ "$rc" = 5 ] && continue
      return "$rc"
    fi
    m cf_waf_stop >&2; return 1
  done
}
online_go_proxy() {
  local d="$1"
  valid_host "$d" || { m bad_domain "$d" >&2; return 2; }
  m on_start "proxy" "$d"
  online_send /api/online/proxy "\"domain\":\"$d\"" || return 1
  if [ -n "$(jv snippets.caddy)" ]; then
    m on_proxy_snip; printf '\n# Caddy\n%s\n\n# nginx\n%s\n\n' "$(jv_raw snippets.caddy)" "$(jv_raw snippets.nginx)"
  fi
