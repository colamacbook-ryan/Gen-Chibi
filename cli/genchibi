# token chủ (v0.21, CNS-195): GC_API_TOKEN trong .env → data/owner-token (server tự sinh khi .env trống). Đọc lúc gọi (server có thể vừa sinh tệp).
# Không export, không in ra màn hình; đi qua stdin (curl -K -), không nằm trong argv → không lộ trong `ps`
owner_token() {
  if [ -n "${GC_API_TOKEN:-}" ]; then printf '%s' "$GC_API_TOKEN"
  elif [ -r data/owner-token ]; then tr -d ' \r\n' < data/owner-token; fi
}
auth_cfg() { local t; t="$(owner_token)"; if [ -n "$t" ]; then printf 'header = "Authorization: Bearer %s"\n' "$t"; fi; }
api() { auth_cfg | curl -fsS -K - -X "$1" -H 'X-GC-Request: 1' -H "X-GC-Lang: $UI" -H 'Content-Type: application/json' ${3:+-d "$3"} "$URL$2"; }   # X-GC-Lang: câu server trả về theo ngôn ngữ CLI
running_native() { [ -f "$PIDF" ] && kill -0 "$(cat "$PIDF")" 2>/dev/null; }
json() { node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{const o=JSON.parse(s);const k=process.argv[1].split(".");let v=o;for(const x of k)v=v==null?v:v[x];console.log(v===undefined?"":typeof v==="object"?JSON.stringify(v):v)})' "$1" 2>/dev/null || sed -n "s/.*\"$1\": *\"\{0,1\}\([^\",}]*\).*/\1/p"; }

# ---------------------------------------------------------------- docker compose: LUÔN ghép -f tường minh, KHÔNG BAO GIỜ đặt / ghi COMPOSE_FILE
# (CNS-169: COMPOSE_FILE=a:b làm compose bỏ qua docker-compose.override.yml → mất service riêng của chủ, vd cổng đăng nhập của Ryan).
# Thứ tự: docker-compose.yml · docker-compose.edge.yml (khi đã bật edge Caddy) · override của chủ (sau cùng, để chủ chỉnh được cả edge).
EDGE_MARK="edge/caddy.enabled"
compose_override() { # tệp override compose tự nạp khi không có -f (cùng thứ tự tìm của docker compose)
  local f; for f in compose.override.yml compose.override.yaml docker-compose.override.yml docker-compose.override.yaml; do [ -f "$f" ] && { echo "$f"; return 0; }; done; return 0
}
compose_files() { # in các cặp "-f tệp", mỗi phần một dòng
  local ov; ov="$(compose_override)"
  printf '%s\n' -f docker-compose.yml
  if [ -f "$EDGE_MARK" ] && [ -f docker-compose.edge.yml ]; then printf '%s\n' -f docker-compose.edge.yml; fi
  if [ -n "$ov" ]; then printf '%s\n' -f "$ov"; fi
  return 0
}
# docker: thẳng · qua nhóm docker (sg docker -c) · sudo docker — máy trình cài vừa cài Docker + usermod -aG docker mà phiên đăng nhập này chưa
# nhận nhóm mới (CNS-174): mọi lệnh vẫn chạy ngay, đăng xuất / vào lại thì đi thẳng. GC_DOCKER_VIA = direct | sg | sudo (trình cài đặt);
# trống → dò một lần: docker thẳng được → direct; user có tên trong nhóm docker (/etc/group) → sg (không hỏi mật khẩu nhóm); sudo không hỏi mật khẩu → sudo.
DOCKER_VIA="${GC_DOCKER_VIA:-}"
dk_pick() {
  [ -z "$DOCKER_VIA" ] || return 0
  DOCKER_VIA=direct
  docker info >/dev/null 2>&1 && return 0
  local g; g=" $(id -nG "$(id -un 2>/dev/null)" 2>/dev/null) "   # nhóm trong /etc/group (kể cả nhóm phiên này chưa nhận) — không dùng grep -q sau ống (pipefail)
  if command -v sg >/dev/null 2>&1 && case "$g" in *" docker "*) true ;; *) false ;; esac && sg docker -c 'docker info' >/dev/null 2>&1 </dev/null; then DOCKER_VIA=sg
  elif command -v sudo >/dev/null 2>&1 && sudo -n docker info >/dev/null 2>&1 </dev/null; then DOCKER_VIA=sudo; fi
  return 0
}
dk() { # dk <đối số docker…> — stdin / stdout đi thẳng (cầu MCP stdio, mật khẩu qua stdin)
  dk_pick
  case "$DOCKER_VIA" in
    sg) local q="docker" x; for x in ${1+"$@"}; do q="$q $(printf '%q' "$x")"; done; sg docker -c "$q" ;;
    sudo) sudo docker ${1+"$@"} ;;
    *) docker ${1+"$@"} ;;
  esac
}
compose() { # compose <lệnh docker compose…> — chạy trong thư mục cài (đã cd)
  local a=() l
  while IFS= read -r l; do a+=("$l"); done < <(compose_files)
  dk compose "${a[@]}" ${1+"$@"}
}
guard_exposure() {
  # đóng khi nghi ngờ: mở ra ngoài máy này mà không có token thì không chạy
  case "${GC_BIND:-127.0.0.1}" in 127.0.0.1|localhost|::1) ;; *)
    [ -n "$(owner_token)" ] || { m refuse_bind "$GC_BIND" >&2; exit 1; } ;;
  esac
}
# CLI chạy bằng root ở chế độ Docker (sudo genchibi …): tệp / thư mục nó tạo trả về cho user của container (GC_UID:GC_GID trong .env — trình cài không để 0)
own_fix() {
  { [ "${MODE:-}" = docker ] && [ "$(id -u)" = 0 ] && [ -n "${GC_UID:-}" ] && [ "$GC_UID" != 0 ]; } || return 0
  local p; for p in ${1+"$@"}; do [ -e "$p" ] && chown -R "$GC_UID:${GC_GID:-$GC_UID}" "$p" 2>/dev/null; done; return 0
}
start() {
  guard_exposure
  legacy_tunnel_down
  if [ "$MODE" = docker ]; then own_fix data run logs; sync_compose; edge_prepare; compose up -d --quiet-pull 2>&1 | grep -vE "Creating|Created|Starting|Network|Container .* (Running|Waiting)" || true
  else
    running_native && { m already_running "$(cat "$PIDF")"; return; }
    mkdir -p logs
    [ -n "${GC_EXTRA_CA:-}" ] && export NODE_EXTRA_CA_CERTS="$GC_EXTRA_CA"
    GC_HOME="$HOME_DIR" GC_PORT="$PORT" nohup node "$HOME_DIR/launcher.js" >> "$LOG" 2>&1 &
    echo $! > "$PIDF"; m started "$!"
  fi
}
stop() {
  legacy_tunnel_down
  if [ "$MODE" = docker ]; then compose stop
  else
    if running_native; then kill "$(cat "$PIDF")"; rm -f "$PIDF"; m stopped; else m not_running; fi
  fi
}
status() {
  local h; h="$(curl -fsS "$URL/api/health" 2>/dev/null || true)"
  if [ -n "$h" ]; then m st_up "$(echo "$h" | json version | sed 's/^v//')" "$URL" "$MODE"; else m st_down "$MODE"; fi
  local sc; sc="$(setup_code)"; [ -z "$sc" ] || m st_setup "$sc" "$(setup_until)"
  m st_releases "$(cd releases 2>/dev/null && ls | tr '\n' ' ')" "$(basename "$(readlink current)")"
  if [ -n "$h" ]; then oapi GET /api/online; fi
  if [ "$OCODE" = 200 ] && [ "$(jv flow.waitingPassword)" = true ] && [ -n "$(jv publicUrlPending)" ]; then m st_online_wait "$(jv publicUrlPending)" "$(jv flow.mode)" "$(jv publicUrlPending)"   # CNS-209: trạng thái TẠM, không phải "off"
  elif [ "$OCODE" = 200 ] && [ "$(jv mode)" != off ] && [ -n "$(jv publicUrl)" ]; then m st_online "$(jv publicUrl)" "$(jv mode)"; else m st_mcp_off; fi
}
update() {
  m upd_checking
