  grep -q '^# gen-chibi — lệnh quản lý trên máy chủ' "$1" 2>/dev/null && grep -q 'INNER="$HOME_DIR/current/cli/genchibi"' "$1" 2>/dev/null || return 1
  ! grep -q '^TRUST_BAKED=' "$1" 2>/dev/null || return 1
  STUB_HOME="$(sed -n 's/^HOME_DIR="${GC_HOME:-\(.*\)}"$/\1/p' "$1" | head -n 1)"
  return 0
}
stub_candidates() { # các tệp genchibi owner có thể gõ (mỗi dòng một)
  local p; { [ -z "$CLI_SELF" ] || printf '%s\n' "$CLI_SELF"; printf '%s\n' "$TRUST_HOME/.local/bin/genchibi"; p="$(type -P genchibi 2>/dev/null || true)"; [ -z "$p" ] || printf '%s\n' "$p"; } | awk '!s[$0]++'
}
STUB_MAIN=""
stub_fix() {
  file_safe "$TD/genchibi" || return 0
  local f STUB_HOME
  while IFS= read -r f; do
    [ -n "$f" ] && [ -f "$f" ] || continue
    case "$f" in "$HOME_DIR"/*|"$HOME_PHYS"/*) continue ;; esac
    if is_old_stub "$f"; then
      case "$STUB_HOME" in "$HOME_DIR"|"$HOME_PHYS") ;; *) continue ;; esac   # lệnh của bản cài khác: không đụng
      file_safe "$f" || continue
      cp "$TD/genchibi" "$f.gc-tmp" && chmod 755 "$f.gc-tmp" && mv -f "$f.gc-tmp" "$f" && m root_booted "$f" >&2 && { [ -n "$STUB_MAIN" ] || STUB_MAIN="$f"; }
    elif grep -q '^TRUST_BAKED=' "$f" 2>/dev/null; then [ -n "$STUB_MAIN" ] || STUB_MAIN="$f"; fi
  done < <(stub_candidates)
  return 0
}
# chạy từ TRONG thư mục cài (lệnh cũ exec sang current/cli/genchibi) → tải + kiểm gói của bản đang chạy, lắp $TD/genchibi, thay các lệnh cũ, rồi chuyển sang
# bản đã kiểm. Không kiểm được (mất mạng) → báo, chạy tiếp lần này (mã mới) — lần gõ sau thử lại
trust_boot() {
  [ -n "$BOOT" ] || return 0
  trust_sync
  if file_safe "$TD/genchibi"; then
    stub_fix
    [ -n "$CLI_SELF" ] || CLI_SELF="${STUB_MAIN:-$TD/genchibi}"
    GC_CF_TOKEN="${GC_CF_TOKEN-}" GC_CLI_INNER=1 GC_HOME="$HOME_DIR" GC_CLI_SELF="$CLI_SELF" exec bash "$TD/genchibi" ${1+"$@"}
  fi
  [ -n "$CLI_SELF" ] || CLI_SELF="$SELF_FILE"
  m root_boot_fail "$(cur_tag)" "${TRUST_ERR:-?}" >&2
}
# --env-file của compose khi root: các khoá .env đã nhận, nguyên văn trong '…' (compose không mở rộng $ trong nháy đơn). GC_UID / GC_GID = chủ thư mục cài
# (không bao giờ 0 — .env đặt GC_UID=0 không làm container chạy root), GC_PORT / GC_BIND đã kiểm dạng. Giá trị có ' bị bỏ
compose_env() {
  local out="" line k v bind="${GC_BIND:-127.0.0.1}"
  [ "$APP_UID" != 0 ] && [ "$APP_GID" != 0 ] || return 1
  priv_gid "$APP_GID" && return 1   # nhóm đặc quyền (docker, sudo, wheel, adm…) → container không bao giờ chạy với nó
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    k="${line%%=*}"; v="${line#*=}"
    case "$k" in GC_UID|GC_GID|GC_PORT|GC_BIND|GC_MODE|GC_DOCKER_VIA|GC_INSTALLED_BY|GC_TUNNEL|COMPOSE_PROFILES|GC_EDGE_DIR) continue ;; esac
    case "$v" in *"'"*) continue ;; esac
    out="$out$k='$v'"$'\n'
  done <<EOF_ENV
$ENV_RAW
EOF_ENV
  # biến .env mà override ĐÃ DUYỆT dùng (CNS-281 / CNS-294): GIÁ TRỊ chụp lúc duyệt ($TI/override.env) — không đọc .env sống (container ghi được);
  # .env đổi giá trị → ov_state báo đổi, hỏi lại
  local snap="${CE_SNAP:-$TI/override.env}"
  if file_safe "$snap" && { [ -n "${CE_FORCE:-}" ] || file_safe "$TI/override.yml"; }; then
    local oe; oe="$(grep -vE "^($(printf '%s' "$OV_GEN" | tr ' ' '|'))=" "$snap" || true)"   # khoá genchibi tự tính không bao giờ lấy từ bản chụp
    [ -z "$oe" ] || out="$out$oe"$'\n'
  fi
  out="${out}GC_EDGE_DIR='$EDGE_DIR'"$'\n'   # nguồn bind mount của edge NGOÀI thư mục cài (F1)
  case "$bind" in ::1) ;; *) [[ "$bind" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] || bind=127.0.0.1 ;; esac
  out="${out}GC_UID='$APP_UID'"$'\n'"GC_GID='$APP_GID'"$'\n'"GC_PORT='$PORT'"$'\n'"GC_BIND='$bind'"$'\n'
  local ce="${CE_OUT:-$TI/compose.env}"
  ( umask 077; printf '%s' "$out" > "$ce.tmp" ) && mv -f "$ce.tmp" "$ce"
}
# Override trong thư mục cài (container ghi được) KHÔNG BAO GIỜ được root dùng khi chưa duyệt. Nhưng bỏ qua lặng lẽ có thể GỠ một lớp bảo vệ (vd service đăng
# nhập riêng của chủ đứng trước app — máy của Ryan): vì vậy mọi lệnh sẽ dựng / tạo lại container DỪNG trước khi đụng container nào (override_gate), in nội dung
# (đã lọc) + lý do + lệnh làm tiếp. Quyết định của root ở $TD: override.yml (bản đã duyệt) · override.off (SHA-256 của override mà root chọn chạy KHÔNG có nó).
# ov_state → 0: không có override / đúng bản đã duyệt / đúng bản đã chọn bỏ · 1: chưa duyệt hoặc đã đổi từ lúc quyết (OV_F = tệp)
OV_F=""; OV_GONE=""; OV_QK=""
OV_GEN="GC_UID GC_GID GC_PORT GC_BIND GC_EDGE_DIR"   # khoá compose.env do genchibi tự tính (không từ .env) — không chụp, override dùng được
# ov_src TỆP: nội dung override — đường tuyệt đối = bản chép của genchibi (đọc thẳng), tương đối = tệp trong thư mục cài (rd, bằng chủ của nó)
ov_src() { case "$1" in /*) cat -- "$1" ;; *) rd "$1" ;; esac; }
# ov_keys TỆP → các biến ${VAR} / $VAR override dùng (bỏ $$), trừ khoá genchibi tự tính (OV_GEN) — mỗi dòng một, sắp xếp
ov_keys() {
  ov_src "$1" | sed 's/\$\$//g' | { grep -oE '\$\{?[A-Za-z_][A-Za-z0-9_]*' || true; } | sed 's/^\$[{]\{0,1\}//' | sort -u | while IFS= read -r k; do
    case " $OV_GEN " in *" $k "*) continue ;; esac   # chỉ khoá genchibi tự sinh cho compose; mọi khoá khác (kể cả GC_PUBLIC_URL, HTTPS_PROXY…) được chụp
    printf '%s\n' "$k"
  done
}
# ov_env TỆP → K='giá trị hiện tại trong .env' cho mỗi biến override dùng (CNS-294: chụp lúc duyệt, so lại mỗi lần). OV_QK = khoá có giá trị chứa ' (không hỗ trợ)
ov_env() {
  local k v; OV_QK=""
  while IFS= read -r k; do
    [ -n "$k" ] || continue
    v="$(printf '%s' "$ENV_ALL" | awk -v k="$k" 'index($0, k "=") == 1 { v = substr($0, length(k) + 2) } END { print v }')"
    case "$v" in *"'"*) OV_QK="$OV_QK $k"; continue ;; esac
    printf "%s='%s'\n" "$k" "$v"
  done < <(ov_keys "$1")
}
# ---- override đã duyệt (v0.23.1 vòng 7): docker compose LÀ bộ phân tích. Không tự đọc YAML nữa (7 vòng bộ quét tự viết vẫn lệch với YAML thật): genchibi
# cho docker compose phân giải tệp (đã kiểm + bản chép override + giá trị biến đã chụp) ra DẠNG CHUẨN, rồi kiểm và CHẠY đúng dạng chuẩn đó.
#   B = config(tệp đã kiểm) · M = config(tệp đã kiểm + override) — cùng thư mục dự án (thư mục cài), cùng env; tác động của override = các dòng M có mà B không
#   có (+) và B có mà M không còn (−), so theo multiset dòng (comm trên bản đã sắp). Kiểm từng dòng "+" (xem ov_judge); "−" in cho chủ xem.
#   Thăm dò hộp cát: cùng tệp nhưng thư mục dự án là một thư mục RỖNG mới → mọi tham chiếu tương đối tới tệp của thư mục cài (include, extends file,
#   env_file, build…) làm compose lỗi → từ chối (đóng khi nghi ngờ).
#   Duyệt = bytes override + giá trị biến + tác động (+/−). Mỗi lần dựng container (up): phân giải lại; tác động khác bản đã duyệt → hỏi lại; khớp → chạy
#   $TI/effective.yml (= M vừa phân giải, đúng thứ đã kiểm).
# Vì sao đọc dòng của dạng chuẩn là đủ: trình xuất YAML của compose luôn dạng khối, một khoá một dòng; giá trị nhiều dòng thành khối chữ "|-" (dòng con thụt
# sâu hơn) — chữ "source: …" trong một giá trị chỉ có thể thành dòng THỪA (bị kiểm thêm → từ chối nhầm, đóng khi nghi ngờ), không bao giờ che được một khoá thật.
ov_abs_ok() { # đường tuyệt đối ngoài thư mục cài (cả HOME_DIR lẫn HOME_PHYS), không phải liên kết, thư mục cha thật cũng ngoài
  local v="$1" k
  case "$v" in /*) ;; *) return 1 ;; esac
  case "$v" in *'$'*|*' '*|*'"'*|*"'"*) return 1 ;; esac
  # thành phần . / .. / rỗng (//) → từ chối: daemon tự giải ../ — /không-có/../<thư mục cài>/data qua được phép so chuỗi mà vẫn trỏ vào thư mục cài
  case "$v/" in *//*|*/./*|*/../*) return 1 ;; esac
  case "$v/" in "$HOME_PHYS"/*|"$HOME_DIR"/*) return 1 ;; esac
  [ ! -L "$v" ] || return 1
  # thư mục cha PHẢI có (cd -P được) — đóng khi nghi ngờ; so đường thật cha + tên với thư mục cài
  k="$(cd -P "$(dirname "$v")" 2>/dev/null && pwd)" || return 1
  case "$k/$(basename "$v")/" in "$HOME_PHYS"/*|"$HOME_DIR"/*) return 1 ;; esac
  case "$k/" in "$HOME_PHYS"/*|"$HOME_DIR"/*) return 1 ;; esac
  if [ -d "$v" ]; then k="$(cd -P "$v" 2>/dev/null && pwd)" || k=""; case "$k/" in "$HOME_PHYS"/*|"$HOME_DIR"/*) return 1 ;; esac; fi
  return 0
}
ov_sock() { # đường là socket Docker hoặc thư mục phía trên nó (/ · /var · /run · /var/run …) — mount vào container = quyền root trên máy
  local v="$1" r s
  r="$(cd -P "$v" 2>/dev/null && pwd)" || r="$v"
  for s in /var/run/docker.sock /run/docker.sock; do
    case "$s/" in "$v"/*|"$r"/*|"$v"|"$r") return 0 ;; esac
    [ "$v" != / ] || return 0
  done
  case "$v$r" in *docker.sock*) return 0 ;; esac
  return 1
}
# ov_own_ok ĐƯỜNG (vòng 8, 🔴A): đường + MỌI thư mục cha (theo chữ lẫn theo đường thật) không thuộc user / nhóm của app và không bị tài khoản khác ghi
# (nhóm / mọi người ghi được mà không có bit t) — app không tráo được nó thành liên kết giữa lúc kiểm và lúc Docker mount. OV_OWN_WHY = lý do khi trả 1
OV_OWN_WHY=""
ov_stat() { stat -c '%u %g %a' -- "$1" 2>/dev/null || stat -f '%u %g %Mp%Lp' -- "$1" 2>/dev/null; }   # uid gid mode (GNU · BSD/macOS)
ov_own_ok() {
  local v="$1" p q u g a
  q="$(cd -P "$(dirname "$v")" 2>/dev/null && pwd)" || return 1
  for p in "$v" "${q%/}/$(basename "$v")"; do
    while :; do
      if [ -e "$p" ] || [ -L "$p" ]; then
        u=""; g=""; a=""; read -r u g a <<< "$(ov_stat "$p")" || true
        case "$u$g$a" in ""|*[!0-9]*) OV_OWN_WHY="$(mn ov_own_ww "$p")"; return 1 ;; esac   # không đọc được chủ / quyền → đóng khi nghi ngờ
        [ "$u" != "$APP_UID" ] || { OV_OWN_WHY="$(mn ov_own_uid "$p" "$u")"; return 1; }
        [ "$g" != "$APP_GID" ] || [ "$g" = 0 ] || { OV_OWN_WHY="$(mn ov_own_gid "$p" "$g")"; return 1; }   # nhóm 0 ghi được: luật dưới bắt
        # quyền của chính liên kết không có nghĩa (thay nó cần quyền ghi thư mục cha — được kiểm ở vòng sau)
        if [ ! -L "$p" ] && (( (8#$a & 8#022) != 0 && (8#$a & 8#1000) == 0 )); then OV_OWN_WHY="$(mn ov_own_ww "$p")"; return 1; fi
        # ACL mở rộng (như path_safe) — có getfacl thì kiểm từng thành phần
        if [ ! -L "$p" ] && command -v getfacl >/dev/null 2>&1 && [ -n "$(getfacl -cp -- "$p" 2>/dev/null | grep -Ev '^(user|group|other|mask)::|^$' || true)" ]; then OV_OWN_WHY="$(mn ov_own_acl "$p")"; return 1; fi
      fi
      [ "$p" != / ] && [ -n "$p" ] || break
      p="$(dirname "$p")"
    done
  done
  return 0
}
# ov_rawscan TỆP (vòng 8, 🟠C): extends / include trỏ tới đường TUYỆT ĐỐI được compose chép thẳng vào dạng chuẩn (khoá biến mất, hộp cát vẫn đọc được tệp);
# compose cũ (2.38 — runner CI) còn chép cả env_file / label_file vào environment / labels BẤT CHẤP --no-env-resolution (khoá biến mất)
# → quét chữ thô của override: từ extends / include / env_file / label_file ở bất kỳ đâu, tag binary, chuỗi thoát \x \u \U, \ cuối dòng, chỉ thị %, tag !<…> (có thể dựng / giấu khoá).
# Đóng khi nghi ngờ: trùng chữ trong giá trị cũng bị từ chối. In lỗi, trả 1
# Vòng 9: go-yaml coi CR lẻ, NEL (U+0085), LS / PS (U+2028 / U+2029) là ngắt dòng; "\" + ngắt dòng trong chuỗi nháy kép NỐI hai nửa (? "inc\<LS>lude") và
# chỉ khoá tường minh "? " mới được nhiều dòng → từ chối: "\" + CR / byte ≥ 0x80, các byte NEL / LS / PS ở bất kỳ đâu, dòng khoá tường minh "? "
ov_rawscan() {
  local n=0 l t bad="" ls=$'\xe2\x80\xa8' ps=$'\xe2\x80\xa9' nel=$'\xc2\x85' b
  # vòng 9b: không dựa vào việc read của bash bỏ NUL — NUL, BOM UTF-16 / UTF-32 (compose đọc được UTF-16) → từ chối trước khi quét
  b="$(head -c 4 -- "$1" | od -An -tx1 | tr -d ' \n')"
  case "$b" in fffe*|feff*|0000feff*) m ov_bad_enc; return 1 ;; esac
  LC_ALL=C tr -d '\000' < "$1" | cmp -s - "$1" || { m ov_bad_enc; return 1; }
  while IFS= read -r l || [ -n "$l" ]; do
    n=$((n + 1))
    # tag YAML: chỉ !reset / !override (tag gộp của compose) — !!binary, !!b%69nary (= binary), !<…>, %TAG… đều giải mã được ra khoá ẩn
    for t in $(printf '%s\n' "$l" | LC_ALL=C grep -oE '(^|[[:space:],{[])![^][:space:],{}[]*' | sed 's/^[^!]*//'); do
      case "$t" in '!reset'|'!override') ;; *) bad=1; m ov_bad_tag "$n" "$(printf '%s' "${l#"${l%%[! ]*}"}" | san | cut -c1-120)"; break ;; esac
    done
    if printf '%s\n' "$l" | LC_ALL=C grep -qiwE 'extends|include|env_file|label_file' \
      || printf '%s\n' "$l" | LC_ALL=C grep -qE '\\[xuU]|\\.?$|^%' \
      || printf '%s\n' "$l" | LC_ALL=C grep -qE '(^|[[:space:],{[])\?([[:space:]]|$)' \
      || printf '%s\n' "$l" | LC_ALL=C grep -qE $'\\\\[\r\x80-\xff]' \
      || printf '%s\n' "$l" | LC_ALL=C grep -qF -e "$ls" -e "$ps" -e "$nel"; then
      bad=1; m ov_bad_raw "$n" "$(printf '%s' "${l#"${l%%[! ]*}"}" | san | cut -c1-120)"
    fi
  done < "$1"
  [ -z "$bad" ]
}
# ov_canon TỆP (vòng 8, 🟡D): mỗi dòng dạng chuẩn của compose (thụt 2 dấu cách, một khoá một dòng) → "đường-khoá<TAB>dòng". Cùng chữ ở hai service / hai
# danh sách là hai dòng KHÁC nhau → so multiset không còn nhầm "dời" một bind sang service khác là không đổi. Dòng tiếp của một giá trị (khối |-, chuỗi dài
# bị gập) mang đường "<khoá>|" và giữ chữ — vẫn bị kiểm như một dòng (đóng khi nghi ngờ). Mục danh sách: "[]" (không đánh số: chèn mục không làm dời các dòng khác)
ov_canon() {
  LC_ALL=C awk '
    function kof(x,   i) {   # khoá của "k: v" / "k:" (k có nháy hoặc không); "" nếu không phải dòng khoá
      if (match(x, /^"([^"\\]|\\.)*"/) || match(x, /^\047([^\047]|\047\047)*\047/)) { i = RLENGTH; x2 = substr(x, i + 1); if (x2 ~ /^:( |$)/) { vv = substr(x2, 3); return substr(x, 1, i) } return "" }
      i = index(x, ": "); if (i > 1) { vv = substr(x, i + 2); return substr(x, 1, i - 1) }
      if (x ~ /^[^ ]+:$/) { vv = ""; return substr(x, 1, length(x) - 1) }
      return ""
    }
    function pth(   i, r) { r = ""; for (i = 1; i <= d; i++) r = r (k[i] == "[]" ? "[]" : (r == "" ? "" : ".") k[i]); return r }
    BEGIN { d = 0; ci = -1 }
    {
      if ($0 == "") { if (ci >= 0) print cp "|\t"; next }
      n = match($0, /[^ ]/) - 1; x = substr($0, n + 1)
      if (ci >= 0 && n > ci) { print cp "|\t" x; next }
      ci = -1
      while (d > 0 && ind[d] >= n) d--
      if (x == "-" || substr(x, 1, 2) == "- ") {
        p = pth() "[]"; d++; ind[d] = n; k[d] = "[]"; r = substr(x, 3)
        key = kof(r)
        print p "\t" x
        if (key == "") { ci = n; cp = p }
        else if (vv == "") { d++; ind[d] = n + 2; k[d] = key }
        else { ci = n + 2; cp = p "." key }
        next
      }
      key = kof(x); p = pth()
      print p "\t" x
      if (key == "") { ci = n; cp = p; next }
      if (vv == "") { d++; ind[d] = n; k[d] = key } else { ci = n; cp = (p == "" ? "" : p ".") key }
    }' "$1"
}
# base_files: các "-f tệp" đã kiểm (không override), mỗi phần một dòng
base_files() {
  local d; d="$(trust_files)"; [ -n "$d" ] || return 1
  printf '%s\n' -f "$d/docker-compose.yml"
  if [ -f "$EDGE_MARK" ] && [ -f "$d/docker-compose.edge.yml" ]; then
    grep -q 'GC_EDGE_DIR' "$d/docker-compose.edge.yml" || { m edge_old "$(basename "$d")" >&2; return 1; }
    printf '%s\n' -f "$d/docker-compose.edge.yml"
  fi
}
# ov_resolve RA [OVERRIDE] [THƯ_MỤC_DỰ_ÁN] [ENV]: docker compose config (dạng chuẩn) — --no-env-resolution giữ env_file là một khoá (compose mới; compose
# 2.38 vẫn đọc tệp vào và bỏ khoá → ov_rawscan chặn env_file / label_file theo chữ thô, mọi phiên bản)
ov_resolve() {
  local out="$1" ov="${2:-}" pd="${3:-$HOME_DIR}" ef="${4:-$TI/compose.env}" a=() l bl
  bl="$(base_files)" || return 1
  while IFS= read -r l; do a+=("$l"); done <<< "$bl"
  [ -z "$ov" ] || a+=(-f "$ov")
  if [ -n "${IS_ROOT:-}" ] && ov_can_hide; then
    # vòng 9 (cấu trúc, không theo chữ): root phân giải trong mount namespace riêng, thư mục cài bị phủ tmpfs RỖNG chỉ đọc → include / extends / env_file
    # / label_file trỏ vào thư mục cài (đường tuyệt đối, liên kết) đều lỗi "không có tệp" → từ chối. KHÔNG kín tuyệt đối: /proc/<pid>/root|cwd của tiến trình ngoài
    # namespace vẫn tới được thư mục cài → quét chữ (include / extends / env_file / label_file) + ov_judge (đường /proc, /sys, /dev/fd) là các lớp còn lại. Tệp đã kiểm + bản chép override ở $TD
    ( cd "$TD/run" && unshare -m --propagation private -- sh -c 'for d in "$1" "$2"; do mount -t tmpfs -o ro,mode=000,size=4k gc-empty "$d" || exit 97; done; shift 2; exec docker ${1+"$@"}' \
        sh "$HOME_PHYS" "$HOME_DIR" compose "${a[@]}" --project-directory "$pd" --env-file "$ef" config --no-env-resolution ) > "$out" 2> "$out.err"
  else
    ( cd "$TD/run" && dk compose "${a[@]}" --project-directory "$pd" --env-file "$ef" config --no-env-resolution ) > "$out" 2> "$out.err"
  fi
}
# ov_can_hide: mount namespace + tmpfs làm được không (root thật, có unshare) — thử một lần: phủ $TD/run trong namespace riêng. Không → chỉ còn quét chữ (ov_rawscan)
OV_CANHIDE=""
ov_can_hide() {
  [ -n "$OV_CANHIDE" ] || { OV_CANHIDE=n; command -v unshare >/dev/null 2>&1 && unshare -m --propagation private -- sh -c 'mount -t tmpfs -o ro,size=4k gc-probe "$1"' sh "$TD/run" >/dev/null 2>&1 && OV_CANHIDE=y; }
  [ "$OV_CANHIDE" = y ]
}
# ov_sysrw M D: nguồn bind override thêm (dòng "+ … source:" của D) nằm dưới thư mục hệ thống mà mục đó không read_only → in (cảnh báo, vẫn duyệt được)
ov_sysrw() {
  LC_ALL=C awk -v D="$2" '
    BEGIN { while ((getline l < D) > 0) if (l ~ /^\+/ && l ~ /\tsource: /) { sub(/^.*\tsource: /, "", l); add[l] = 1 } }
    function flush() { if (src != "" && !ro && (src in add) && src ~ /^\/(etc|root|proc|sys|boot|run|var\/lib\/docker)(\/|$)/) print src; src = ""; ro = 0 }
    /^ *- / { flush() }
    /^ *(- )?source: / { x = $0; sub(/^ *(- )?source: /, "", x); src = x }
    /^ *(- )?read_only: true$/ { ro = 1 }
    END { flush() }' "$1" | sort -u
}
# ov_show_add D: các dòng "+" (đường khoá + dòng), tối đa 40 — chủ thấy override thêm gì vào kết quả thật
ov_show_add() {
  local n l; n="$(grep -c '^+' "$1" 2>/dev/null || true)"; [ "${n:-0}" -gt 0 ] || return 0
  m ov_adds
  grep '^+' "$1" | head -n 40 | while IFS= read -r l; do l="${l#+}"; m ov_add_line "$(printf '%s %s' "${l%%$'\t'*}" "${l#*$'\t'}" | san | cut -c1-160)"; done
  [ "$n" -le 40 ] || m ov_add_more "$((n - 40))"
}
OV_EFF=""; OV_ERR=""
# ov_effect OVERRIDE ENV → in tác động (+dòng / −dòng, đã sắp); OV_EFF = tệp M (dạng chuẩn đầy đủ, để chạy). Lỗi phân giải → 1, OV_ERR = dòng lỗi của compose
ov_effect() {
  local bf mf sbx rc=0
  # vòng 9b: root mà không che được thư mục cài (không unshare, mount bị seccomp / AppArmor chặn) → ĐÓNG, không lùi về chỉ quét chữ.
  # GC_TEST_NOHIDE_OK (môi trường của shell gọi lệnh + GC_TEST=1, không từ .env): bộ test "root giả" bằng user thường
  if [ -n "${IS_ROOT:-}" ] && ! ov_can_hide && ! { [ "${GC_TEST:-}" = 1 ] && [ -n "${GC_TEST_NOHIDE_OK:-}" ]; }; then OV_NOHIDE=1; OV_ERR="$(mn ov_nohide)"; return 1; fi
  bf="$(mktemp "$TD/run/ovb-XXXXXX")" && mf="$(mktemp "$TD/run/ovm-XXXXXX")" || return 1
  ov_resolve "$bf" "" "$HOME_DIR" "$2" && ov_resolve "$mf" "$1" "$HOME_DIR" "$2" || rc=1
  if [ $rc = 0 ]; then
    # thăm dò hộp cát: thư mục dự án RỖNG mới (0700) — override đọc tệp tương đối của thư mục cài thì compose lỗi ở đây
    sbx="$(mktemp -d "$TD/run/sbox-XXXXXX")" || return 1
    ov_resolve "$mf.sb" "$1" "$sbx" "$2" || { rc=2; cp -f "$mf.sb.err" "$mf.err" 2>/dev/null || true; }
    rmdir "$sbx" 2>/dev/null || true; rm -f "$mf.sb" "$mf.sb.err"
  fi
  if [ $rc != 0 ]; then
    OV_ERR="$(cat "$bf.err" "$mf.err" 2>/dev/null | san | grep -v '^$' | head -n 3 | tr '\n' ' ')"
    rm -f "$bf" "$bf.err" "$mf" "$mf.err"; return $rc
  fi
  ov_canon "$bf" | LC_ALL=C sort > "$bf.s"; ov_canon "$mf" | LC_ALL=C sort > "$mf.s"   # so theo dòng CÓ đường khoá (vòng 8)
  { LC_ALL=C comm -13 "$bf.s" "$mf.s" | sed 's/^/+/'; LC_ALL=C comm -23 "$bf.s" "$mf.s" | sed 's/^/-/'; }
  rm -f "$bf" "$bf.err" "$bf.s" "$mf.s" "$mf.err"; OV_EFF="$mf"
}
# ov_judge TỆP_TÁC_ĐỘNG → in lỗi (✗, từ chối) / cảnh báo (!) / dòng bị bỏ (·); trả 1 nếu có lỗi. Chỉ dòng "+" bị kiểm (thứ override thêm / đổi)
ov_judge() {
  local line l t key val bad="" nrm=0 kp
  while IFS= read -r line; do
    # dòng = dấu (+ / −) · đường khoá · TAB · dòng dạng chuẩn (ov_canon)
    l="${line#?}"; kp="${l%%$'\t'*}"; case "$l" in *$'\t'*) l="${l#*$'\t'}" ;; esac
    t="${l#"${l%%[! ]*}"}"; t="${t#- }"
    key="${t%%:*}"; val=""; case "$t" in *": "*) val="${t#*: }" ;; esac
    case "$line" in -*) nrm=$((nrm + 1)); [ "$nrm" -gt 15 ] || m ov_rm "$(printf '%s %s' "$kp" "$t" | san)"; continue ;; esac
    case "$key" in
      build|env_file|extends|include|develop|use_api_socket|provider|volumes_from|dockerfile|additional_contexts|label_file)
        bad=1; m ov_bad_key "$key"; continue ;;
    esac
    case "$t" in *docker.sock*) bad=1; m ov_bad_sock "$key" "$(printf '%s' "$val" | san)"; continue ;; esac
    case "$key" in
      source|device|context|file|path)
        case "$val" in \"*) case "$val" in *\\*) bad=1; m ov_bad_src "$key" "$(printf '%s' "$val" | san)"; continue ;; esac; val="${val#\"}"; val="${val%\"}" ;;
                       \'*) val="${val#\'}"; val="${val%\'}"; val="${val//\'\'/\'}" ;; esac
        [ -n "$val" ] || continue
        case "$val" in
          */*|.*|~*)
            if ov_sock "$val"; then bad=1; m ov_bad_sock "$key" "$(printf '%s' "$val" | san)"
            elif case "$val/" in /proc/*|/sys/*|/dev/fd/*|/dev/stdin/*|/dev/stdout/*|/dev/stderr/*) true ;; *) false ;; esac; then bad=1; m ov_bad_proc "$key" "$(printf '%s' "$val" | san)"
            elif ! ov_abs_ok "$val"; then bad=1; m ov_bad_src "$key" "$(printf '%s' "$val" | san)"
            elif [ ! -e "$val" ]; then bad=1; m ov_bad_missing "$key" "$(printf '%s' "$val" | san)"
            elif ! ov_own_ok "$val"; then bad=1; m ov_bad_own "$key" "$(printf '%s' "$val" | san)" "$(printf '%s' "$OV_OWN_WHY" | san)"; fi ;;
          *) [[ "$val" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] || { bad=1; m ov_bad_src "$key" "$(printf '%s' "$val" | san)"; } ;;
        esac ;;
      privileged) [ "$val" != true ] || m ov_warn "$(printf '%s' "$t" | san)" ;;
      pid|ipc|network_mode|userns_mode|uts|cgroup) case "$val" in host|*host*) m ov_warn "$(printf '%s' "$t" | san)" ;; esac ;;
      cap_add|devices|security_opt|user|sysctls|device_cgroup_rules|group_add|runtime) m ov_warn "$(printf '%s' "$t" | san)" ;;
      propagation) case "$val" in rshared|shared|rslave|slave) m ov_warn "$(printf '%s' "$t" | san)" ;; esac ;;   # mount lan ngược / xuôi giữa container và máy
    esac
  done < "$1"
  [ "$nrm" -le 15 ] || m ov_rm_more "$((nrm - 15))"
  [ -z "$bad" ]
}
# ov_vars TỆP: biến COMPOSE_* / DOCKER_* (đổi cách chính Docker chạy) + giá trị có ' (OV_QK, từ ov_env) → in lỗi, trả 1
ov_vars() { local k bad=""; while IFS= read -r k; do case "$k" in COMPOSE_*|DOCKER_*) bad=1; m ov_bad_var "$k" ;; esac; done < <(ov_keys "$1"); for k in $OV_QK; do bad=1; m ov_bad_quote "$k"; done; [ -z "$bad" ]; }
gc_cmd() { if [ -n "$IS_ROOT" ]; then printf 'sudo %s' "${CLI_SELF:-$TD/genchibi}"; else printf '%s' "${CLI_SELF:-genchibi}"; fi; }   # lệnh chạy lại được (đường tuyệt đối — sudo secure_path không có ~/.local/bin, CNS-285)
# ov_state → 0: không có override / đúng bản đã duyệt (bytes + giá trị biến + tác động sau phân giải, $TI/effective.yml vừa ghi) / đúng bản đã chọn bỏ
# · 1: chưa duyệt, đã đổi, đã xoá (OV_GONE), tác động đổi (OV_CHG), không có docker compose (OV_NOCOMPOSE). Kết quả nhớ trong một lệnh (OV_DONE)
OV_DONE=""; OV_RC=1; OV_CHG=""; OV_NOCOMPOSE=""; OV_JMSG=""; OV_CHGTXT=""; OV_NOHIDE=""
ov_state() {
  [ -z "$OV_DONE" ] || return "$OV_RC"
  OV_DONE=1; OV_RC=1
  OV_F="$(compose_override)"; OV_GONE=""; OV_CHG=""; OV_NOCOMPOSE=""; OV_JMSG=""; OV_CHGTXT=""; OV_NOHIDE=""
  if [ -z "$OV_F" ]; then
    # chủ xoá override trong thư mục cài mà còn bản đã duyệt → phải quyết lại (không lặng lẽ dựng lại service cũ — CNS-286)
    if file_safe "$TI/override.yml"; then OV_GONE=1; return 1; fi
    OV_RC=0; return 0
  fi
  local h e; h="$(rd "$OV_F" | sha256_of)"
  if file_safe "$TI/override.off" && [ "$(head -n 1 "$TI/override.off")" = "$h" ]; then OV_RC=0; return 0; fi
  file_safe "$TI/override.yml" && [ "$(sha256_of "$TI/override.yml")" = "$h" ] && file_safe "$TI/override.env" && file_safe "$TI/override.effect" || return 1
  [ "$(ov_env "$TI/override.yml" | sha256_of)" = "$(sha256_of "$TI/override.env")" ] || return 1
  dk compose version >/dev/null 2>&1 || { OV_NOCOMPOSE=1; return 1; }
  compose_env || return 1
  e="$(mktemp "$TD/run/ove-XXXXXX")" || return 1
  if ! ov_effect "$TI/override.yml" "$TI/compose.env" > "$e"; then [ -n "$OV_NOHIDE" ] || OV_CHG=1; rm -f "$e"; return 1; fi
  if [ "$(sha256_of "$e")" != "$(sha256_of "$TI/override.effect")" ]; then
    OV_CHG=1; OV_CHGTXT="$(LC_ALL=C comm -13 <(LC_ALL=C sort "$TI/override.effect") <(LC_ALL=C sort "$e") | head -n 40 | tr '\t' ' ' | san | cut -c1-160)" || OV_CHGTXT=""
    rm -f "$e" "$OV_EFF"; return 1
  fi
  # vòng 8 (🔴A): chữ giống hệt lúc duyệt KHÔNG có nghĩa đường trên máy còn như cũ (compose giữ nguyên chữ của đường bind) → kiểm lại ĐỦ mỗi lần dùng:
  # quét chữ thô + ov_judge (tuyệt đối, ngoài thư mục cài, không liên kết, socket, chủ / quyền) trên kết quả vừa phân giải
  if ! { ov_rawscan "$TI/override.yml" && ov_judge "$e"; } > "$e.j" 2>&1; then OV_JMSG="$(grep '^  - ' "$e.j" || true)"; rm -f "$e" "$e.j" "$OV_EFF"; return 1; fi
  rm -f "$e" "$e.j"; chmod 600 "$OV_EFF"; mv -f "$OV_EFF" "$TI/effective.yml"
  OV_RC=0; return 0
}
ov_print() { rd "$1" | san | head -n 60; }   # nội dung override cho người đọc: bỏ ký tự điều khiển (terminal), tối đa 60 dòng
ov_vals_note() { # nội dung vẫn đúng bản đã duyệt mà giá trị biến trong .env đổi → in TÊN các khoá đổi (không in giá trị)
  file_safe "$TI/override.yml" && file_safe "$TI/override.env" || return 0
  local ch; ch="$(ov_env "$TI/override.yml" | { diff - "$TI/override.env" 2>/dev/null || true; } | sed -n "s/^[<>] \([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p" | sort -u | tr '\n' ' ')" || ch=""
  [ -z "${ch% }" ] || m ov_vals "${ch% }"
}
override_gate() { # TRUST: override chưa duyệt / đã đổi / đã xoá → in lý do + nội dung + cách làm tiếp, trả 1 (lệnh gọi dừng TRƯỚC khi đụng container)
  [ -n "${TRUST:-}" ] || return 0
  OV_DONE=""   # rào trước khi dựng: luôn phân giải lại NGAY LÚC NÀY (dấu edge, tệp gốc có thể vừa đổi trong cùng lệnh — vd online --caddy)
  ov_state && return 0
  if [ -n "$OV_GONE" ]; then { m ov_gone "$TI/override.yml" "$(gc_cmd)"; } >&2; return 1; fi
  { m ov_block "$HOME_DIR/$OV_F"; ov_print "$OV_F"; echo; ov_keys_note "$OV_F"; ov_vals_note
    [ -z "$OV_NOCOMPOSE" ] || m ov_nocompose; [ -z "$OV_NOHIDE" ] || m ov_nohide; [ -z "$OV_CHG" ] || m ov_effect_changed
    [ -z "$OV_CHGTXT" ] || { m ov_chg_head; printf '%s\n' "$OV_CHGTXT" | while IFS= read -r l; do m ov_chg_line "$l"; done; }
    [ -z "$OV_JMSG" ] || { m ov_rejudge; printf '%s\n' "$OV_JMSG"; }
    m ov_block_fix "$(gc_cmd)" "$(gc_cmd)" "$HOME_DIR/$OV_F"; } >&2
  return 1
}
ov_keys_note() { local k; k="$(ov_keys "$1" | tr '\n' ' ')"; [ -z "${k% }" ] || m ov_keys_show "${k% }"; }
# genchibi override [status | approve [--yes] | off [--yes]] — quyết override của chủ cho BẢN CÀI NÀY ($TI). approve: bản chép (kiểm + chạy từ CÙNG bytes) →
# chụp giá trị biến → docker compose phân giải (ov_effect) → kiểm (ov_judge) → hiện nội dung + cảnh báo → xác nhận → lưu override.yml + override.env +
# override.effect (+ effective.yml). off: chạy KHÔNG có override này (ghi SHA). Không có terminal → cần --yes
override_cmd() {
  local sub="${1:-status}" f a y="" tmp h
  [ $# -eq 0 ] || shift
  for a in ${1+"$@"}; do case "$a" in --yes|-y) y=1 ;; *) m bad_opt "$a" >&2; return 2 ;; esac; done
  [ -n "$TRUST" ] || { m ov_notroot; return 0; }
  f="$(compose_override)"
  case "$sub" in
    status)
      if ! ov_state; then
        if [ -n "$OV_GONE" ]; then m ov_gone "$TI/override.yml" "$(gc_cmd)"; else m ov_block_short "$HOME_DIR/$OV_F" "$(gc_cmd)" "$(gc_cmd)"; ov_vals_note
          [ -z "$OV_NOCOMPOSE" ] || m ov_nocompose; [ -z "$OV_NOHIDE" ] || m ov_nohide; [ -z "$OV_CHG" ] || m ov_effect_changed; [ -z "$OV_JMSG" ] || { m ov_rejudge; printf '%s\n' "$OV_JMSG"; }; fi; return 1
      elif [ -z "$f" ]; then m ov_none
      elif file_safe "$TI/override.yml"; then m ov_same "$HOME_DIR/$f" "$TI/override.yml"; ov_keys_note "$f"
      else m ov_skipped "$HOME_DIR/$f" "$(gc_cmd)"; fi ;;
    approve)
      [ -n "$f" ] || { m ov_none; return 1; }
      dk compose version >/dev/null 2>&1 || { m ov_nocompose >&2; return 1; }   # không có Docker Compose → không phân giải được → không duyệt
      compose_env || { m uid0_refuse "$HOME_DIR" >&2; return 1; }
      tmp="$(mktemp "$TD/run/ov-XXXXXX")" || return 1
      rd "$f" > "$tmp" || true
      m ov_show "$HOME_DIR/$f"; san < "$tmp"; echo; ov_keys_note "$tmp"
      ov_env "$tmp" > "$tmp.env"
      # compose.env ứng viên: như compose.env nhưng với giá trị vừa chụp
      CE_SNAP="$tmp.env" CE_OUT="$tmp.ce" CE_FORCE=1 compose_env || { rm -f "$tmp" "$tmp.env"; return 1; }
      local rc=0 rw=0; ov_rawscan "$tmp" > "$tmp.raw" || rw=1   # chữ thô trước: vẫn báo khi compose không phân giải được (vd thư mục cài bị phủ)
      ov_effect "$tmp" "$tmp.ce" > "$tmp.eff" || rc=$?
      if [ $rc != 0 ]; then
        { m ov_bad "$HOME_DIR/$f"; cat "$tmp.raw"; if [ $rc = 2 ]; then m ov_sandbox "$OV_ERR"; else m ov_resolve_fail "$OV_ERR"; fi; ov_vars "$tmp" || true; } >&2
        rm -f "$tmp" "$tmp.env" "$tmp.ce" "$tmp.eff" "$tmp.raw"; return 1
      fi
      local j=$rw v=0; ov_judge "$tmp.eff" > "$tmp.bad" || j=1; cat "$tmp.raw" >> "$tmp.bad"; rm -f "$tmp.raw"; ov_vars "$tmp" >> "$tmp.bad" || v=1
      ov_sysrw "$OV_EFF" "$tmp.eff" | while IFS= read -r l; do m ov_warn_sys "$(printf '%s' "$l" | san)"; done >> "$tmp.bad"
      if [ $j = 1 ] || [ $v = 1 ]; then { m ov_bad "$HOME_DIR/$f"; cat "$tmp.bad"; } >&2; rm -f "$tmp" "$tmp.env" "$tmp.ce" "$tmp.eff" "$tmp.bad" "$OV_EFF"; return 1; fi
      ov_show_add "$tmp.eff"
      if [ -s "$tmp.bad" ]; then m ov_effect_show; cat "$tmp.bad"; fi; rm -f "$tmp.bad"
      if [ -n "$y" ] || ask_yn "$(mn ov_ask)"; then
        chmod 600 "$tmp" "$tmp.env" "$tmp.eff" "$OV_EFF"
        mv -f "$tmp.env" "$TI/override.env" && mv -f "$tmp.eff" "$TI/override.effect" && mv -f "$OV_EFF" "$TI/effective.yml" && mv -f "$tmp" "$TI/override.yml" \
          && rm -f "$TI/override.off" "$tmp.ce" && m ov_approved "$TI/override.yml"
      else rm -f "$tmp" "$tmp.env" "$tmp.ce" "$tmp.eff" "$OV_EFF"; m cancelled; return 1; fi ;;
    off)
      if [ -n "$f" ]; then m ov_show "$HOME_DIR/$f"; ov_print "$f"; echo; fi
      if [ -n "$y" ] || ask_yn "$(mn ov_off_ask)"; then
        rm -f "$TI/override.yml" "$TI/override.env" "$TI/override.effect" "$TI/effective.yml"
        if [ -n "$f" ]; then h="$(rd "$f" | sha256_of)"; ( umask 077; printf '%s\n' "$h" > "$TI/override.off" ); else rm -f "$TI/override.off"; fi
        m ov_off
      else m cancelled; return 1; fi ;;
    -h|--help|help) m ov_help ;;
    *) m bad_opt "$sub" >&2; m ov_help >&2; return 2 ;;
  esac
}
guard_exposure() {
  # đóng khi nghi ngờ: mở ra ngoài máy này mà không có token thì không chạy
  case "${GC_BIND:-127.0.0.1}" in 127.0.0.1|localhost|::1) ;; *)
    [ -n "$(owner_token)" ] || { m refuse_bind "$GC_BIND" >&2; exit 1; } ;;
  esac
}
# CLI chạy bằng root ở chế độ Docker (sudo genchibi …): tệp / thư mục nó tạo trả về cho user của container (GC_UID:GC_GID trong .env — trình cài không để 0)
own_fix() {
  [ -z "${TRUST:-}" ] || return 0   # root (CNS-257): mọi tệp đã ghi bằng user của thư mục cài (as_app) — không chown -R trên cây user đó ghi được
  { [ "${MODE:-}" = docker ] && [ "$(id -u)" = 0 ] && [ -n "${GC_UID:-}" ] && [ "$GC_UID" != 0 ]; } || return 0
  # không theo symlink (-h), không đổi chủ tệp có nhiều liên kết cứng (có thể là liên kết tới tệp của root), một filesystem
  local p; for p in ${1+"$@"}; do [ -e "$p" ] && find "$p" -xdev \( -type d -o -type l -o -links 1 \) -exec chown -h "$GC_UID:${GC_GID:-$GC_UID}" {} + 2>/dev/null; done; return 0
}
start() {
  guard_exposure
