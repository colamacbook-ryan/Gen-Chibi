# genchibi live hook (v0.24, INT-21): hooks của Claude Code cho Sân khấu Live. Tệp hook chạy trên MÁY CHỦ (cả bản Docker) → luôn là bản CHÉP ở $TD:
#   TRUST (Docker): từ gói phát hành đã kiểm SHA-256 ($TD/rel/<bản>/live-hook.mjs — trust_fetch giữ lại) · native: từ current/ (đọc như dữ liệu, cùng
#   user với app). Không bao giờ in đường trong thư mục cài làm lệnh. Token live (data/live-token, chỉ mở POST /api/live/event) đọc như dữ liệu, kiểm dạng.
#   Không tự sửa cấu hình nào khi không có --install-into; --install-into: từ chối symlink / không phải tệp / không phải JSON object / trong thư mục cài,
#   sao lưu bản cũ, ghi nguyên tử (tệp tạm cùng thư mục + rename), chỉ thay các hook Live cũ của chính genchibi.
LIVE_EVENTS="SessionStart UserPromptSubmit PreToolUse PostToolUse PostToolUseFailure Notification Stop SubagentStart SubagentStop PreCompact SessionEnd"
shq() { printf "'%s'" "${1//\'/\'\\\'\'}"; }
live_cmd() {
  local sub="${1:-}" mode=print into=""; shift || true
  [ "$sub" = hook ] || { m live_usage >&2; return 2; }
  while [ $# -gt 0 ]; do case "$1" in --print) mode=print; shift ;; --json) mode=json; shift ;; --install-into) into="${2:-}"; [ -n "$into" ] || { m live_usage >&2; return 2; }; mode=into; shift 2 ;; *) m live_usage >&2; return 2 ;; esac; done
  # 1) nguồn đã kiểm → bản chép ở $TD
  local src="" dest tmp tf
  if [ -n "$TRUST" ]; then
    tf="$(trust_files)"; src="${tf:+$tf/live-hook.mjs}"
    if [ -z "$src" ] || ! file_safe "$src"; then m live_nohook "$(cur_tag)" "${tf:-${TRUST_ERR:-not verified}}" >&2; return 1; fi
  fi
  td_parent_ok "$TD" || { m td_unsafe "$TD" >&2; return 1; }
  ( umask 077; mkdir -p "$TD" ) 2>/dev/null || true
  path_safe "$TD" || { m td_unsafe "$TD" >&2; return 1; }
  case "$(cd -P "$TD" && pwd)/" in "$HOME_PHYS"/*) m td_in_install "$TD" "$HOME_DIR" >&2; return 1 ;; esac
  dest="$TD/live-hook.mjs"
  trusted_copy "${src:-current/tools/live-hook.mjs}" "$dest" 'gen-chibi — bộ chuyển hooks của Claude Code' || { m live_nohook "$(cur_tag)" "current/tools/live-hook.mjs" >&2; return 1; }
  # 2) token live (dữ liệu của app — đọc bằng user của app, đúng dạng mới dùng)
  local tok; tok="$(rd data/live-token | tr -d ' \r\n')" || tok=""
  case "$tok" in gcl_*) ;; *) tok="" ;; esac
  case "$tok" in *[!A-Za-z0-9_-]*) tok="" ;; esac
  [ "${#tok}" -ge 36 ] || { m live_notoken "$HOME_DIR" >&2; return 1; }
  # token live → tệp 0600 CẠNH tệp hook (hook tự đọc): không nằm trong lệnh → không lộ qua /proc/*/cmdline của shell chạy hook
  tmp="$(mktemp "$TD/live-token.XXXXXX")" || { m td_unsafe "$TD" >&2; return 1; }
  printf '%s\n' "$tok" > "$tmp" && chmod 600 "$tmp" && mv -f -- "$tmp" "$TD/live-token"
  # 3) lệnh hook: node TUYỆT ĐỐI (ứng dụng mở từ Dock / menu không thấy PATH của terminal) + tệp đã chép + địa chỉ app trên máy này
  local nb; nb="$(command -v node 2>/dev/null)" || nb=""
  [ -n "$nb" ] || { m live_nonode >&2; nb=node; }
  local cmd jcmd ev js="" sep=""
  cmd="GC_LIVE_URL=$(shq "$URL") $(shq "$nb") $(shq "$dest")"; jcmd="$(cfg_esc "$cmd")"
  for ev in $LIVE_EVENTS; do
    case "$ev" in PreToolUse|PostToolUse|PostToolUseFailure) js="$js$sep"'    "'"$ev"'": [{ "matcher": "*", "hooks": [{ "type": "command", "command": "'"$jcmd"'", "timeout": 2 }] }]' ;;
      *) js="$js$sep"'    "'"$ev"'": [{ "hooks": [{ "type": "command", "command": "'"$jcmd"'", "timeout": 2 }] }]' ;; esac
    sep=$',\n'
  done
  js=$'{\n  "hooks": {\n'"$js"$'\n  }\n}'
  [ -z "$IS_ROOT" ] || m live_root "$TD" >&2
  case "$mode" in
    json) printf '%s\n' "$js"; return 0 ;;
    print) m live_head; printf '\n%s\n\n' "$js"; m live_foot "$dest" "$URL" "$TD/live-token"; return 0 ;;
  esac
  # 4) --install-into: ghép vào settings.json của Claude Code (cần node — chính hook cũng cần)
  [ "$nb" != node ] || { m live_in_bad "$into" "node" >&2; return 1; }
  case "$into" in /*) ;; "~/"*) into="$HOME/${into#\~/}" ;; *) into="$ORIG_PWD/$into" ;; esac
  local dp anc; dp="$(dirname "$into")"; anc="$dp"
  while [ ! -e "$anc" ] && [ ! -L "$anc" ]; do anc="$(dirname "$anc")"; done
  # root (sudo): chỉ ghi vào chỗ của CHÍNH root (mọi thư mục trên đường thuộc root / không ai khác ghi được, không symlink) — nhà của user khác:
  # tệp sẽ thuộc root và hook trỏ vào /root/.local (user không chạy được), lại mở đường tráo symlink → từ chối, bảo chạy không sudo bằng user đó
  if [ -n "$IS_ROOT" ] && ! path_safe "$anc"; then m live_in_bad "$into" "not root's own folder — run genchibi live hook without sudo, as the user who runs Claude Code" >&2; return 1; fi
  [ -d "$dp" ] || ( umask 077; mkdir -p "$dp" ) || { m live_in_bad "$into" "folder" >&2; return 1; }
  dp="$(cd -P "$dp" && pwd)"
  case "$dp/" in "$HOME_PHYS"/*) m live_in_bad "$into" "inside the install folder" >&2; return 1 ;; esac
  if [ -L "$into" ]; then m live_in_bad "$into" "symlink" >&2; return 1; fi
  if [ -e "$into" ] && [ ! -f "$into" ]; then m live_in_bad "$into" "not a regular file" >&2; return 1; fi
  # một lần mở O_NOFOLLOW → fstat → đọc từ chính fd; sao lưu ghi từ bộ đệm (wx, quyền gốc); tệp mới ghi tạm (wx) rồi rename — không đọc / chép qua đường dẫn lần hai
  local res; res="$(printf '%s' "$js" | ( cd / && "$nb" -e '
const fs = require("fs"), path = require("path"), C = fs.constants, file = process.argv[1], add = JSON.parse(fs.readFileSync(0, "utf8")).hooks;
const out = m => { process.stdout.write(m); process.exit(m.startsWith("ok") ? 0 : 3); };
let cur = {}, had = false, mode = 0o600, buf = null, fd = -1;
try { fd = fs.openSync(file, C.O_RDONLY | C.O_NOFOLLOW | (C.O_NONBLOCK || 0)); } catch (e) { if (e.code === "ELOOP") out("bad symlink"); if (e.code !== "ENOENT") out("bad " + e.code); }
if (fd >= 0) { const st = fs.fstatSync(fd); if (!st.isFile()) out("bad not a regular file"); had = true; mode = st.mode & 0o777; buf = fs.readFileSync(fd); fs.closeSync(fd);
  const raw = buf.toString("utf8");
  if (raw.trim()) { try { cur = JSON.parse(raw); } catch (e) { out("bad not JSON"); } }
  if (!cur || typeof cur !== "object" || Array.isArray(cur)) out("bad not a JSON object");
  if (cur.hooks !== undefined && (!cur.hooks || typeof cur.hooks !== "object" || Array.isArray(cur.hooks))) out("bad hooks is not an object"); }
const mine = h => h && typeof h.command === "string" && /live-hook\.mjs/.test(h.command) && (/GC_LIVE_(URL|TOKEN)=/.test(h.command) || /\/gen-chibi(-live)?\/live-hook\.mjs/.test(h.command));
const hooks = Object.assign({}, cur.hooks || {});
Object.keys(hooks).forEach(ev => { if (!Array.isArray(hooks[ev])) return; hooks[ev] = hooks[ev].map(g => g && Array.isArray(g.hooks) ? Object.assign({}, g, { hooks: g.hooks.filter(h => !mine(h)) }) : g).filter(g => !(g && Array.isArray(g.hooks) && !g.hooks.length)); if (!hooks[ev].length) delete hooks[ev]; });
Object.keys(add).forEach(ev => { hooks[ev] = (Array.isArray(hooks[ev]) ? hooks[ev] : []).concat(add[ev]); });
const next = JSON.stringify(Object.assign({}, cur, { hooks }), null, 2) + "\n", dir = path.dirname(file), base = path.basename(file);
let bak = "";
if (had) { bak = path.join(dir, base + ".bak-" + new Date().toISOString().replace(/[:.]/g, "-")); fs.writeFileSync(bak, buf, { flag: "wx", mode }); fs.chmodSync(bak, mode); }
const tmp = path.join(dir, "." + base + ".gc-" + process.pid + "-" + Date.now());
const wfd = fs.openSync(tmp, "wx", mode); fs.writeSync(wfd, next); fs.fchmodSync(wfd, mode); fs.fsyncSync(wfd); fs.closeSync(wfd);
fs.renameSync(tmp, file);
out("ok " + bak);
' "$into" ) 2>&1)" || true
  case "$res" in
    "ok ") m live_in_new "$into" ;;
    ok\ *) m live_in_ok "$into" "${res#ok }" ;;
    bad\ *) m live_in_bad "$into" "${res#bad }" >&2; return 1 ;;
    *) m live_in_bad "$into" "$(printf '%s' "$res" | grep -m1 -E 'Error|E[A-Z]+:' || printf '%s' "$res" | tail -n 1)" >&2; return 1 ;;   # lỗi của node: nói lý do, không nuốt
  esac
}

# trusted_copy NGUỒN ĐÍCH DẤU (CNS-320) — MỘT hàm chép mã sẽ CHẠY TRÊN MÁY CHỦ (hook Live, cầu nối CLI) từ nguồn đã kiểm:
#   TRUST (Docker): nguồn PHẢI nằm trong $TD/rel/v<bản>/ (gói phát hành đã kiểm SHA-256 — trust_fetch giữ lại), tệp thường của chính mình, không symlink
#   native: nguồn là đường tương đối current/… đọc như dữ liệu bằng user của app (tệp cuối không được là symlink)
#   nội dung phải mang dòng DẤU trong 600 byte đầu; đích: thư mục an toàn NGOÀI thư mục cài, tệp tạm cùng thư mục (0600) rồi mv. Không bao giờ lấy mã từ app.
trusted_copy() {
  local src="$1" dest="$2" mark="$3" d tmp
  d="$(dirname "$dest")"
  td_parent_ok "$d" || return 1
  ( umask 077; mkdir -p "$d" ) 2>/dev/null || return 1
  path_safe "$d" || return 1
  case "$(cd -P "$d" && pwd)/" in "$HOME_PHYS"/*) return 1 ;; esac
  if [ -n "$TRUST" ]; then
    case "$src" in "$TD"/rel/v*/*) ;; *) return 1 ;; esac
    case "$src" in *..*) return 1 ;; esac
    file_safe "$src" || return 1
  else
    case "$src" in current/*) ;; *) return 1 ;; esac
    case "$src" in *..*) return 1 ;; esac
    [ ! -L "$HOME_DIR/$src" ] || return 1
  fi
  tmp="$(mktemp "$d/.gc-copy.XXXXXX")" || return 1
  if [ -n "$TRUST" ]; then cat -- "$src" > "$tmp" || { rm -f -- "$tmp"; return 1; }
  else rd "$src" > "$tmp" || { rm -f -- "$tmp"; return 1; }; fi
  if ! head -c 600 "$tmp" | grep -qF -- "$mark"; then rm -f -- "$tmp"; return 1; fi
  chmod 600 "$tmp" && mv -f -- "$tmp" "$dest"
}

# ---------------------------------------------------------------- cầu nối CLI (v0.26, spec v025-cli-bridge §6, INT-22)
# AI của Studio chạy bằng agent CLI (agy, Claude Code) trên máy này. Mã chạy trên máy chủ = bản chép đã kiểm ở $TD/ai-bridge/ (trusted_copy, như hook Live);
# dữ liệu (token gcb_ + bí mật HMAC 0600, địa chỉ app CHỐT lúc install, registry) ở ~/.local/lib/gen-chibi/bridge/; HOME riêng của từng CLI ở
# ~/.local/share/gen-chibi/bridge/<cli>-home. Từ chối root (khác live hook — CNS-315). Token không bao giờ trên argv: phản hồi pair đi qua stdin.
BRIDGE_CODE="$TD/ai-bridge"
BRIDGE_LIB="$HOME/.local/lib/gen-chibi/bridge"
BRIDGE_SHARE="$HOME/.local/share/gen-chibi/bridge"
BRIDGE_UNIT_NAME="gen-chibi-ai-bridge.service"
BRIDGE_UNIT="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/$BRIDGE_UNIT_NAME"
br_nodebin() {
  local nb; nb="$(command -v node 2>/dev/null)" || nb=""
  if [ -z "$nb" ] || ! "$nb" -e 'process.exit(+process.versions.node.split(".")[0] >= 18 ? 0 : 1)' 2>/dev/null; then m br_no_node "${nb:-none}" >&2; return 1; fi
  ( cd "$(dirname "$nb")" && printf '%s/%s' "$(pwd -P)" "$(basename "$nb")" )
}
br_node() { local nb; [ -f "$BRIDGE_CODE/ai-bridge.mjs" ] || { m br_not_installed >&2; return 1; }; nb="$(br_nodebin)" || return 1; ( cd "$HOME" && "$nb" "$BRIDGE_CODE/ai-bridge.mjs" ${1+"$@"} ); }
br_src_dir() { # thư mục nguồn đã kiểm của 3 tệp cầu nối → BR_SRC (TRUST: $TD/rel/<bản>/bridge · native: current/bridge)
  BR_SRC=""
  if [ -n "$TRUST" ]; then local tf; tf="$(trust_files)"; [ -n "$tf" ] && [ -f "$tf/bridge/ai-bridge.mjs" ] && BR_SRC="$tf/bridge"
  else [ -f "$HOME_DIR/current/bridge/ai-bridge.mjs" ] && BR_SRC="current/bridge"; fi
  [ -n "$BR_SRC" ]
}
br_copy_all() {
  local e f mk
  for e in ai-bridge.mjs shim.mjs selftest.mjs; do
    case "$e" in ai-bridge.mjs) mk='gen-chibi — CẦU NỐI CLI trên MÁY CHỦ' ;; shim.mjs) mk='gen-chibi — shim TRONG hộp cát' ;; *) mk='gen-chibi — TỰ KIỂM HỘP CÁT' ;; esac
    trusted_copy "$BR_SRC/$e" "$BRIDGE_CODE/$e" "$mk" || { m br_copy "$BR_SRC/$e" >&2; return 1; }
  done
}
br_systemd() { command -v systemctl >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1; }
br_install() {
  local nb tag v bw
  nb="$(br_nodebin)" || return 1
  bw="$(command -v bwrap 2>/dev/null)" || bw=""
  if [ "$(uname -s)" = Linux ]; then
    if [ -z "$bw" ]; then m br_no_bwrap "bwrap not found" >&2
    elif ! "$bw" --unshare-all --ro-bind /usr /usr --symlink usr/bin /bin --symlink usr/lib64 /lib64 --symlink usr/lib /lib -- /usr/bin/true 2>/dev/null; then m br_no_bwrap "user namespaces" >&2; fi
  fi
  tag="$(cur_tag)"; v="${tag#v}"; [ -n "$v" ] || v="$(rd current/VERSION | tr -d ' 
')" || v=""
  br_src_dir || { m br_src "${tag:-?}" "${TRUST:+$TD/rel}${TRUST:-current/bridge}" >&2; return 1; }
  br_copy_all || return 1
  # địa chỉ app chốt MỘT lần ở đây (CNS-314) — cầu nối không đọc .env về sau; ghép: phản hồi (token + bí mật) đi qua stdin vào cầu nối, không qua argv
  local res; res="$(api POST /api/ai/bridge/pair '{}')" || { m br_pair >&2; return 1; }
  printf '%s' "$res" | ( cd "$HOME" && "$nb" "$BRIDGE_CODE/ai-bridge.mjs" pair-store "$URL" "$v" ) || { m br_pair >&2; return 1; }
  m br_installed "$BRIDGE_CODE" "$URL" "$BRIDGE_LIB"
  if br_systemd; then
    ( umask 077; mkdir -p "$(dirname "$BRIDGE_UNIT")" )
    printf '%s
' "[Unit]" "Description=gen-chibi CLI bridge (Studio AI through agent CLIs on this machine)" "After=network-online.target" ""       "[Service]" "Type=simple" "ExecStart=$nb $BRIDGE_CODE/ai-bridge.mjs run" "Restart=on-failure" "RestartSec=5" "RestartPreventExitStatus=2 3 4" "NoNewPrivileges=yes" "UMask=0077" ""       "[Install]" "WantedBy=default.target" > "$BRIDGE_UNIT.tmp" && chmod 600 "$BRIDGE_UNIT.tmp" && mv -f "$BRIDGE_UNIT.tmp" "$BRIDGE_UNIT"
    systemctl --user daemon-reload && systemctl --user enable --now "$BRIDGE_UNIT_NAME" >/dev/null 2>&1 && m br_unit
  else m br_no_systemd; fi
  m br_next
}
# gỡ: dịch vụ + mã + token / HMAC / registry; HOME riêng của CLI (đăng nhập) chỉ xoá SAU KHI HỎI (--keep-home: không hỏi, giữ)
br_uninstall() {
  local keep=""; [ "${1:-}" = --keep-home ] && keep=1
  if command -v systemctl >/dev/null 2>&1; then systemctl --user disable --now "$BRIDGE_UNIT_NAME" >/dev/null 2>&1 || true; fi
  rm -f -- "$BRIDGE_UNIT"
  if command -v systemctl >/dev/null 2>&1; then systemctl --user daemon-reload >/dev/null 2>&1 || true; fi
  if [ -f "$BRIDGE_CODE/ai-bridge.mjs" ]; then br_node forget || true; fi
  rm -f -- "$BRIDGE_CODE/ai-bridge.mjs" "$BRIDGE_CODE/shim.mjs" "$BRIDGE_CODE/selftest.mjs"; rmdir "$BRIDGE_CODE" 2>/dev/null || true
  m br_uninstalled
  [ -d "$BRIDGE_SHARE" ] || return 0
  if [ -z "$keep" ] && ask_yn "$(mn br_ask_home "$BRIDGE_SHARE")"; then
    case "$BRIDGE_SHARE" in "$HOME"/.local/share/gen-chibi/bridge) rm -rf -- "$BRIDGE_SHARE" ;; esac
  else m br_keep_home "$BRIDGE_SHARE"; fi
}
# update / trust_sync: cầu nối đã cài → chép lại 3 tệp từ gói đã kiểm của bản đang chạy rồi khởi động lại dịch vụ (CNS-306). Mã không bao giờ lấy từ app
br_refresh() {
  [ -z "$IS_ROOT" ] || return 0
  [ -f "$BRIDGE_CODE/ai-bridge.mjs" ] || return 0
  br_src_dir || return 0
  if cmp -s "$BR_SRC/ai-bridge.mjs" "$BRIDGE_CODE/ai-bridge.mjs" 2>/dev/null; then return 0; fi
  br_copy_all || return 0
  m br_refreshed "$(cur_tag)" >&2
  if command -v systemctl >/dev/null 2>&1; then systemctl --user try-restart "$BRIDGE_UNIT_NAME" >/dev/null 2>&1 || true; fi
}
ai_cmd() {
  [ "${1:-}" = bridge ] || { m ai_usage >&2; return 2; }
  shift; local sub="${1:-}"; shift || true
  [ -z "$IS_ROOT" ] || { m br_root >&2; return 2; }
  case "$sub" in
    install) br_install ;;
    uninstall) br_uninstall ${1+"$@"} ;;
    start|stop) br_systemd || { m br_no_systemd >&2; return 1; }; systemctl --user "$sub" "$BRIDGE_UNIT_NAME" ;;
    status) br_node status || return 1; if br_systemd; then systemctl --user --no-pager status "$BRIDGE_UNIT_NAME" 2>/dev/null | head -n 3 || true; fi ;;
    logs) journalctl --user -u "$BRIDGE_UNIT_NAME" -n 200 -f 2>&1 | log_san ;;
    run|probe|login|enable|disable|config) br_node "$sub" ${1+"$@"} ;;
    *) m ai_usage >&2; [ -z "$sub" ] && return 0; return 2 ;;
  esac
}

trust_boot ${1+"$@"}   # root được lệnh cũ gọi từ trong thư mục cài → lắp lệnh đã kiểm rồi chuyển sang (không quay lại)
case "${1:-help}" in mcp|help|-h|--help|override) ;; *) trust_sync ;; esac
[ -z "$TRUST" ] || stub_fix   # lệnh cũ còn trong PATH (vd owner gõ bằng đường khác) → thay ở mọi lần chạy (CNS-278)
# override chưa quyết (TRUST) → lệnh dựng / tạo lại / khởi động lại container dừng NGAY, trước khi đụng container nào (container đang chạy giữ nguyên)
case "${1:-help}" in
  start|restart|update|rollback|restore|token|github-token) override_gate || exit 1 ;;
  online) case "${2:-}" in ""|status|-h|--help|help) ;; *) override_gate || exit 1 ;; esac ;;
  lang|language) [ -z "${2:-}" ] || override_gate || exit 1 ;;
esac
case "${1:-help}" in
  start) legacy_tunnel_note; start ;; stop) stop ;; restart) legacy_tunnel_note; stop; start ;; status) legacy_tunnel_note; status ;; update) legacy_tunnel_note; update ;;
  logs) logs ;; backup) backup ;; restore) shift; restore "${1:-}" ;; uninstall) uninstall ;;
  mcp) mcp ;; open) open_ui ;; version) status ;; password) shift; password_cmd ${1+"$@"} ;;
  rollback) shift; rollback_cmd ${1+"$@"}; exit $? ;;
  doctor) shift; doctor_cmd ${1+"$@"}; exit $? ;;
  override) shift; override_cmd ${1+"$@"}; exit $? ;;
  setup) shift; setup_cmd ${1+"$@"}; exit $? ;;
  expose|link) removed_cmd "$1" "${2:-}" ;;   # bỏ ở v0.23 — thoát 2
  online) shift; online_cmd ${1+"$@"}; exit $? ;;
  token|github-token) shift; token_cmd "${1:-}" ;;
  lang|language) shift; lang_cmd "${1:-}" ;;
  agent) shift; agent_cmd ${1+"$@"} ;;
  live) shift; live_cmd ${1+"$@"}; exit $? ;;
  ai) shift; ai_cmd ${1+"$@"}; exit $? ;;
  *) usage ;;
esac
