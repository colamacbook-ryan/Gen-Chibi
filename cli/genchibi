}
valid_host() { [[ "$1" =~ ^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?)*\.[A-Za-z]{2,63}$ ]] && [ "${#1}" -le 253 ]; }
online_usage() { m on_help; }
online_cmd() {
  local sub="${1:-}" pos="" a
  [ $# -eq 0 ] || shift
  case "$sub" in
    --caddy) online_caddy; return ;;
    --caddy-off) online_caddy_off; return ;;
    -h|--help|help) online_usage; return 0 ;;
    ""|status) online_status; return ;;
  esac
  while [ $# -gt 0 ]; do
    a="$1"; shift
    case "$a" in
      --yes|-y) YES=1 ;;
      --overwrite-dns) OVERWRITE=1 ;;
      --token-stdin) TOKSTDIN=1 ;;
      --waf-done) WAFDONE=1 ;;
      --sub) CFSUB="${1:-}"; [ $# -eq 0 ] || shift
        [[ "$CFSUB" =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$ ]] || { m bad_opt "--sub $CFSUB" >&2; return 2; } ;;
      --token|--token=*|--api-token|--api-token=*) m cf_tok_argv >&2; return 2 ;;
      -*) m bad_opt "$a" >&2; online_usage >&2; return 2 ;;
      *) if [ -z "$pos" ]; then pos="$a"
         elif [[ "$a" =~ ^[A-Za-z0-9_.-]{20,}$ ]]; then m cf_tok_argv >&2; return 2   # trông như token: từ chối, không dùng
         else m bad_opt "$a" >&2; return 2; fi ;;
    esac
  done
  case "$sub" in
    caddy) [ -n "$pos" ] || { online_usage >&2; return 2; }; online_go_caddy "$pos" ;;
    cloudflare|cf) online_go_cloudflare "$pos" ;;
    proxy) [ -n "$pos" ] || { online_usage >&2; return 2; }; online_go_proxy "$pos" ;;
    quick)
      [ -z "$pos" ] || { m bad_opt "$pos" >&2; return 2; }
      m on_start "quick" "*.trycloudflare.com"
      online_send /api/online/quick "" || return 1
      online_follow && a=0 || a=$?; online_done "$a" ;;
    recheck)
      opost /api/online/recheck "$([ -n "$WAFDONE" ] && printf '{"confirmManual":"waf"}' || printf '{}')"
      case "$OCODE" in 2??) ;; *) online_err; return 1 ;; esac
      WAFDONE=""; online_follow && a=0 || a=$?
      [ "$a" != 5 ] || { online_waf && a=0 || a=$?; }
      online_done "$a" ;;
    off)
      local body='{}'
      if [ -n "$TOKSTDIN" ] || [ -n "${GC_CF_TOKEN:-}" ]; then cf_token || return 1; body="{\"token\":\"$CFTOK\"}"; fi   # có token → app dọn cả tunnel / DNS / WAF đã tạo ở Cloudflare
      unset GC_CF_TOKEN
      opost /api/online/off "$body"; CFTOK=""; body=""
      case "$OCODE" in 2??) ;; *) online_err; return 1 ;; esac
      online_follow && a=0 || a=$?; online_done "$a" ;;
    migrate)
      opost /api/online/migrate '{}'
      if [ "$OCODE" = 404 ]; then m on_migrate_old >&2; return 1; fi
      case "$OCODE" in 2??) m on_migrated
        # máy còn GC_TUNNEL (genchibi expose ≤ v0.22): cấu hình đã sang Go online → dừng tunnel cũ còn sót, bỏ GC_TUNNEL / profile cũ khỏi .env (hết dòng nhắc)
        if [ -n "${GC_TUNNEL:-}" ]; then legacy_tunnel_down; set_env GC_TUNNEL ""; GC_TUNNEL=""
          case "${COMPOSE_PROFILES:-}" in tunnel|quick) set_env COMPOSE_PROFILES ""; COMPOSE_PROFILES="" ;; esac; fi
        online_status ;;
        *) online_err; return 1 ;; esac ;;
    *) m bad_opt "$sub" >&2; online_usage >&2; return 2 ;;
  esac
}
set_env() { # set_env KHOÁ GIÁ_TRỊ — sửa hoặc thêm dòng trong .env. Móc kiểm thử GC_TEST* không bao giờ vào .env (review bảo mật 🟡7): từ chối, và bỏ dòng cũ nếu có
  local k="$1" v="$2" tmp; touch .env
  case "$k" in GC_TEST*) return 0 ;; esac
  tmp="$(mktemp)"
  awk -v k="$k" -v v="$v" '/^[ \t]*(export[ \t]+)?GC_TEST/ { next } index($0, k "=") == 1 { if (!d) print k "=" v; d = 1; next } { print } END { if (!d) print k "=" v }' .env > "$tmp" && cat "$tmp" > .env
  rm -f "$tmp"
  export "$k=$v"
}
rand_hex() { openssl rand -hex "$1" 2>/dev/null || node -e "console.log(require('crypto').randomBytes($1).toString('hex'))"; }
token_cmd() {
  # genchibi token [giá trị|--clear]: đặt GC_GITHUB_TOKEN (repo private). Không truyền giá trị → hỏi ẩn / đọc stdin,
  # để token không nằm trong lịch sử shell hay danh sách tiến trình.
  local t="${1:-}" tmp
  if [ "$t" = "--clear" ]; then t=""
  elif [ -z "$t" ]; then
    if [ -t 0 ]; then read -r -s -p "$(mn tok_ask)" t; echo; else read -r t || true; fi
    [ -n "$t" ] || { m tok_none >&2; exit 1; }
  fi
  case "$t" in *[!A-Za-z0-9_.-]*) m tok_bad >&2; exit 1 ;; esac
  touch .env; chmod 600 .env; tmp="$(mktemp)"
  K=GC_GITHUB_TOKEN V="$t" awk 'BEGIN { k = ENVIRON["K"]; v = ENVIRON["V"]; d = 0 }
    index($0, k "=") == 1 { print k "=" v; d = 1; next } { print } END { if (!d) print k "=" v }' .env > "$tmp" && cat "$tmp" > .env; rm -f "$tmp"
  export GC_GITHUB_TOKEN="$t"
  if [ -n "$t" ]; then m tok_set; else m tok_cleared; fi
  if [ "$MODE" = docker ]; then start; else stop; start; fi
}
lang_cmd() {
  # genchibi lang [en|vi]: không đối số → in ngôn ngữ CLI + mặc định THẬT của Studio (/api/health khi app chạy, không thì data/settings.json).
  # Có đối số → so với CẢ HAI (không chỉ .env — CNS-153): khác thì ghi GC_LANG vào .env và đổi mặc định của Studio:
  #   app đang chạy → PUT /api/settings { uiLang, uiLangEnv } (đánh dấu giá trị .env đã áp: lần khởi động sau không áp lại đè lựa chọn Studio về sau);
  #   app dừng → sửa uiLang / uiLangEnv trong data/settings.json (thiếu khoá thì server tự áp GC_LANG mới ở lần chạy tới).
  local want="${1:-}" cur real h="" run=""
  cur="$(sed -n 's/^GC_LANG=//p' .env 2>/dev/null | tail -1)"
  case "$cur" in en|vi) ;; *) cur="" ;; esac
  h="$(curl -fsS -m 5 "$URL/api/health" 2>/dev/null || true)"; [ -n "$h" ] && run=1
  if [ -n "$run" ]; then real="$(printf '%s' "$h" | sed -n 's/.*"uiLang"[[:space:]]*:[[:space:]]*"\([A-Za-z_-]*\)".*/\1/p')"; else real="$(settings_lang)"; fi
  case "$real" in en|vi) ;; *) real="${cur:-en}" ;; esac
  if [ -z "$want" ]; then
    m lang_now "$(lang_name "$UI")" "$UI" "$(lang_name "$real")" "$real"; m lang_hint; return 0
  fi
  case "$want" in en|EN|En) want=en ;; vi|VI|Vi) want=vi ;; *) m lang_bad "$want" >&2; exit 1 ;; esac
  UI="$want"   # từ đây nói bằng ngôn ngữ vừa chọn
  if [ "$cur" = "$want" ] && [ "$real" = "$want" ]; then m lang_same "$(lang_name "$want")" "$want"; m lang_note; return 0; fi
  set_env GC_LANG "$want"
  m lang_set "$(lang_name "$want")" "$want"
  if [ -n "$run" ]; then
    # API không nhận (app quá cũ, lỗi mạng…) → khởi động lại: server áp GC_LANG mới khi khởi động
    if api PUT /api/settings "{\"uiLang\":\"$want\",\"uiLangEnv\":\"$want\"}" >/dev/null 2>&1; then m lang_live "$(lang_name "$want")"; else m lang_restart; apply_env; fi
  else
    if [ -f data/settings.json ] && grep -q '"uiLang"[[:space:]]*:' data/settings.json; then
      local tmp; tmp="$(mktemp)"
      sed -e "s/\"uiLang\"\([[:space:]]*:[[:space:]]*\)\"[A-Za-z_-]*\"/\"uiLang\"\1\"$want\"/" \
          -e "s/\"uiLangEnv\"\([[:space:]]*:[[:space:]]*\)\"[A-Za-z_-]*\"/\"uiLangEnv\"\1\"$want\"/" data/settings.json > "$tmp" && cat "$tmp" > data/settings.json
      rm -f "$tmp"
    fi
    m lang_norun
  fi
  m lang_note
}
apply_env() { # khởi động lại để app nhận khoá/tên miền/ngôn ngữ mới
  if [ "$MODE" = docker ]; then sync_compose; edge_prepare; compose up -d --quiet-pull 2>&1 | grep -vE "Creating|Created|Starting|Started|Stopping|Stopped|Removing|Removed|Recreate|Network|Container .* (Running|Waiting)" || true
  else stop >/dev/null; start >/dev/null; fi
}
# ---------------------------------------------------------------- genchibi expose / link: ĐÃ BỎ ở v0.23 (bí danh từ v0.21.3; CHANGELOG v0.22.0 báo trước)
# Không chạy gì: một dòng chỉ lệnh online tương ứng (stderr), thoát 2. Không còn nhánh cũ (expose --off dọn .env, --rotate, link có khoá).
removed_cmd() {
  local old="$1" a="${2:-}" new
  if [ "$old" = link ]; then case "$a" in --check) new="online recheck" ;; *) new="online" ;; esac
  else case "$a" in --quick) new="online quick" ;; --off) new="online off" ;; ""|-*|help) new="online --help" ;; *) new="online cloudflare $a" ;; esac; fi
  m removed "$old${a:+ $a}" "$new" >&2
  exit 2
}
# Máy còn GC_TUNNEL trong .env (tunnel do genchibi expose ≤ v0.22 tạo; profiles tunnel / quick đã bỏ khỏi docker-compose.yml): start / update / status
# in MỘT dòng nhắc genchibi online migrate. Tunnel cũ không còn được chạy; tiến trình / container cũ còn sót thì dừng (start, stop, migrate) —
# không để thứ mở ra Internet mà genchibi stop không quản được.
legacy_tunnel_note() { [ -z "${GC_TUNNEL:-}" ] || m gc_tunnel "$GC_TUNNEL" >&2; return 0; }
legacy_tunnel_down() {
  local pf="$HOME_DIR/logs/tunnel.pid" p
  if [ -f "$pf" ]; then
    p="$(tr -dc 0-9 < "$pf")"
    if [ -n "$p" ]; then case "$(ps -p "$p" -o command= 2>/dev/null)" in *cloudflared*) kill "$p" 2>/dev/null || true ;; esac; fi   # chỉ đúng cloudflared cũ (pid có thể đã bị dùng lại)
    rm -f "$pf"
  fi
  if [ "$MODE" = docker ] && [ -n "${GC_TUNNEL:-}" ]; then dk rm -f gen-chibi-tunnel gen-chibi-tunnel-quick >/dev/null 2>&1 || true; fi
  return 0
}

