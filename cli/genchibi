_t() { F=""; if [ "$UI" = vi ]; then _vi "$1"; fi; if [ -z "$F" ]; then _en "$1"; fi; if [ -z "$F" ]; then F="$1"; fi; }
m()  { _t "$1"; shift; printf "%s$F\n" "" ${1+"$@"}; }   # "%s" + "" đứng đầu: câu bắt đầu bằng "-" không bị printf hiểu là tuỳ chọn
mn() { _t "$1"; shift; printf "%s$F" "" ${1+"$@"}; }
pick_ui() { case "${1:-}" in vi|vi[_.-]*|VI|VI[_.-]*|Vi) UI=vi ;; *) UI=en ;; esac; }
lang_name() { case "$1" in vi) echo "Tiếng Việt" ;; *) echo "English" ;; esac; }
# mặc định của Studio ghi trong data/settings.json › uiLang (một nguồn sự thật — server ghi). sed thuần: không cần node / jq, chạy được với bash 3.2
settings_lang() { sed -n 's/.*"uiLang"[[:space:]]*:[[:space:]]*"\([A-Za-z_-]*\)".*/\1/p' data/settings.json 2>/dev/null | head -1 || true; }
ENV_LANG="${GC_LANG:-}"   # GC_LANG=vi genchibi … (biến môi trường) thắng giá trị trong .env
pick_ui "$ENV_LANG"

HOME_DIR="${GC_HOME:-__GC_HOME__}"
[ -d "$HOME_DIR" ] || { m no_home "$HOME_DIR" >&2; exit 1; }
# Lệnh đi theo bản cài: chuyển cho cli/genchibi của bản đang chạy, để bản cập nhật mang theo lệnh mới.
INNER="$HOME_DIR/current/cli/genchibi"
if [ -z "${GC_CLI_INNER:-}" ] && [ -f "$INNER" ]; then GC_CLI_INNER=1 GC_HOME="$HOME_DIR" exec bash "$INNER" ${1+"$@"}; fi
ORIG_PWD="$PWD"   # thư mục người gọi lệnh (agent skill cài vào dự án của họ, không phải thư mục cài)
cd "$HOME_DIR"
set -a; [ -f .env ] && . ./.env; set +a
# GC_LANG (biến môi trường › .env) rỗng — bản cài ≤ v0.19 nâng cấp, hoặc cài lại không chọn — thì CLI nói theo mặc định của Studio (CNS-152)
UI_SRC="${ENV_LANG:-${GC_LANG:-}}"; [ -n "$UI_SRC" ] || UI_SRC="$(settings_lang)"
pick_ui "$UI_SRC"
MODE="${GC_MODE:-docker}"; PORT="${GC_PORT:-7480}"
URL="http://127.0.0.1:$PORT"
PIDF="$HOME_DIR/logs/launcher.pid"; LOG="$HOME_DIR/logs/gen-chibi.log"
TDIR="$HOME_DIR/tunnel"; TPID="$HOME_DIR/logs/tunnel.pid"; TLOG="$HOME_DIR/logs/tunnel.log"
CF_IMAGE="${GC_CF_IMAGE:-cloudflare/cloudflared:2026.9.3}"

# token đi qua stdin (curl -K -), không nằm trong argv → không lộ trong `ps`
auth_cfg() { if [ -n "${GC_API_TOKEN:-}" ]; then printf 'header = "Authorization: Bearer %s"\n' "$GC_API_TOKEN"; fi; }
api() { auth_cfg | curl -fsS -K - -X "$1" -H 'X-GC-Request: 1' -H "X-GC-Lang: $UI" -H 'Content-Type: application/json' ${3:+-d "$3"} "$URL$2"; }   # X-GC-Lang: câu server trả về theo ngôn ngữ CLI
running_native() { [ -f "$PIDF" ] && kill -0 "$(cat "$PIDF")" 2>/dev/null; }
json() { node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{const o=JSON.parse(s);const k=process.argv[1].split(".");let v=o;for(const x of k)v=v==null?v:v[x];console.log(v===undefined?"":typeof v==="object"?JSON.stringify(v):v)})' "$1" 2>/dev/null || sed -n "s/.*\"$1\": *\"\{0,1\}\([^\",}]*\).*/\1/p"; }

guard_exposure() {
  # đóng khi nghi ngờ: mở ra ngoài máy này mà không có token thì không chạy
  case "${GC_BIND:-127.0.0.1}" in 127.0.0.1|localhost|::1) ;; *)
    [ -n "${GC_API_TOKEN:-}" ] || { m refuse_bind "$GC_BIND" >&2; exit 1; } ;;
  esac
}
start() {
  guard_exposure
  if [ "$MODE" = docker ]; then sync_compose; docker compose up -d --quiet-pull 2>&1 | grep -vE "Creating|Created|Starting|Network|Container .* (Running|Waiting)" || true
  else
    running_native && { m already_running "$(cat "$PIDF")"; return; }
    mkdir -p logs
    [ -n "${GC_EXTRA_CA:-}" ] && export NODE_EXTRA_CA_CERTS="$GC_EXTRA_CA"
    GC_HOME="$HOME_DIR" GC_PORT="$PORT" nohup node "$HOME_DIR/launcher.js" >> "$LOG" 2>&1 &
    echo $! > "$PIDF"; m started "$!"
    tunnel_start
  fi
}
stop() {
  if [ "$MODE" = docker ]; then docker compose stop
  else
    tunnel_stop
    if running_native; then kill "$(cat "$PIDF")"; rm -f "$PIDF"; m stopped; else m not_running; fi
  fi
}
status() {
  local h; h="$(curl -fsS "$URL/api/health" 2>/dev/null || true)"
  if [ -n "$h" ]; then m st_up "$(echo "$h" | json version | sed 's/^v//')" "$URL" "$MODE"; else m st_down "$MODE"; fi
  m st_releases "$(cd releases 2>/dev/null && ls | tr '\n' ' ')" "$(basename "$(readlink current)")"
  case "${GC_TUNNEL:-}" in
    named) m st_mcp_named "${GC_PUBLIC_URL:-?}" ;;
    quick) m st_mcp_quick "$(quick_url)" ;;
    *) m st_mcp_off ;;
  esac
}
update() {
  m upd_checking
  api POST /api/update/check >/dev/null || { m upd_nocheck; exit 1; }
  local r; r="$(api POST /api/update/apply '{}')" || { m upd_failed; exit 1; }
  echo "$r" | json message
  if echo "$r" | grep -q '"restart":true'; then
    for i in $(seq 1 60); do sleep 1; curl -fsS "$URL/api/health" >/dev/null 2>&1 && break; done
    sleep 2; status
  fi
}
backup() {
  mkdir -p backups; local f="backups/thu-cong-$(date +%Y%m%d-%H%M%S).tar.gz"
  tar -czf "$f" data && m backed_up "$HOME_DIR/$f"
}
restore() {
  local f="${1:-}"; [ -f "$f" ] || { m restore_usage; exit 1; }
  read -r -p "$(mn restore_ask "$f")" a
  case "$a" in "dong y"|yes) ;; *) m cancelled; exit 1 ;; esac
  backup; stop; rm -rf data.restore && mkdir data.restore && tar -xzf "$f" -C data.restore
  rm -rf data && mv data.restore/data data && rm -rf data.restore; start; m restored
}
uninstall() {
  read -r -p "$(mn un_ask)" a
  local wipe=""
  # câu trả lời xoá dữ liệu: k/K (tiếng Việt, "không") · n/N (tiếng Anh, "no"); mọi câu khác giữ dữ liệu
  if [ "$UI" = vi ]; then case "$a" in k|K) wipe=1 ;; esac; else case "$a" in n|N) wipe=1 ;; esac; fi
  stop || true
  [ "$MODE" = docker ] && docker compose down || true
  rm -f "$HOME/.local/bin/genchibi"
