agent_cmd() {
  local sub="${1:-connect}"; shift || true
  case "$sub" in
    connect) agent_connect ;;
    guide) agent_curl "$URL/api/agent/guide?topic=${1:-guide}"; echo ;;
    topics) agent_curl "$URL/api/agent/topics"; echo ;;
    tools) local f=openai; [ "${1:-}" = --format ] && f="${2:-openai}"; agent_curl "$URL/api/agent/tools?format=$f"; echo ;;
    skill)
      local v="${1:-claude}" dir="" force=""; shift || true
      while [ $# -gt 0 ]; do case "$1" in --dir) dir="${2:-}"; shift 2 || shift ;; --force) force=1; shift ;; *) shift ;; esac; done
      case "$v" in claude) dir="${dir:-$HOME/.claude/skills}" ;; cursor|gemini|codex|generic) dir="${dir:-$ORIG_PWD}" ;; *) m skill_usage >&2; return 1 ;; esac
      # đích trong thư mục cài (container ghi được — gói skill sẽ thành đầu vào của app) → từ chối; dò theo đường thật của thư mục gần nhất đã có
      local dp="$dir"; case "$dp" in /*) ;; *) dp="$ORIG_PWD/$dp" ;; esac; while [ ! -d "$dp" ]; do dp="$(dirname "$dp")"; done; dp="$(cd -P "$dp" && pwd)"
      case "$dp/" in "$HOME_PHYS"/*|"$HOME_DIR"/*) m skill_in_install "$dir" >&2; return 1 ;; esac
      # giải nén vào thư mục tạm, rồi chỉ ghi đè tệp DO CHÍNH LỆNH NÀY SINH (có dấu "generated by `genchibi agent skill`");
      # AGENTS.md / GEMINI.md / rule có sẵn của người dùng thì dừng lại (trừ khi --force)
      # gói do app gửi (container) = dữ liệu không tin: chỉ tệp thường + thư mục, không tên tuyệt đối / "..", giải nén không giữ chủ / quyền; đích có liên kết = đụng
      local tmp; tmp="$(mktemp -d)"
      agent_curl "$URL/api/agent/skill?vendor=$v" > "$tmp.tar" || { rm -rf "$tmp" "$tmp.tar"; m skill_dl_fail >&2; return 1; }
      if [ -n "$(LC_ALL=C tar -tvf "$tmp.tar" 2>/dev/null | cut -c1 | { grep -v '^[-d]$' || true; })" ] || ! LC_ALL=C tar -tf "$tmp.tar" >/dev/null 2>&1 \
        || [ -n "$(LC_ALL=C tar -tf "$tmp.tar" 2>/dev/null | { grep -E '^/|(^|/)\.\.(/|$)' || true; })" ]; then
        rm -rf "$tmp" "$tmp.tar"; m skill_bad >&2; return 1
      fi
      tar -x --no-same-owner --no-same-permissions -C "$tmp" -f "$tmp.tar" || { rm -rf "$tmp" "$tmp.tar"; m skill_dl_fail >&2; return 1; }
      rm -f "$tmp.tar"
      if [ -n "$(cd "$tmp" && find . ! -type f ! -type d)" ]; then rm -rf "$tmp"; m skill_bad >&2; return 1; fi
      local f clash="" lclash="" q
      while IFS= read -r f; do
        f="${f#./}"; q="$f"
        # mọi thành phần của đường đích (kể cả chính dir) là liên kết → coi như đụng (cp sẽ ghi xuyên liên kết)
        while :; do if [ -L "$dir/$q" ]; then lclash="$lclash $dir/$q"; break; fi; case "$q" in */*) q="${q%/*}" ;; *) break ;; esac; done
        if [ -L "$dir" ]; then lclash="$lclash $dir"; fi
        if [ -e "$dir/$f" ] && [ ! -L "$dir/$f" ] && ! head -c 2000 "$dir/$f" | grep -q 'generated by `genchibi agent skill`'; then clash="$clash $dir/$f"; fi
      done < <(cd "$tmp" && find . -type f)
      if [ -n "$lclash" ]; then rm -rf "$tmp"; m skill_clash "$(printf '%s\n' $lclash | awk '!s[$0]++' | tr '\n' ' ')" >&2; return 1; fi   # liên kết: kể cả --force cũng không ghi xuyên
      if [ -n "$clash" ] && [ -z "$force" ]; then rm -rf "$tmp"; m skill_clash "$clash" >&2; m skill_clash2 >&2; return 1; fi
      mkdir -p "$dir" && cp -R "$tmp"/. "$dir"/ && rm -rf "$tmp"
      m skill_done "$v" "$dir" ;;
    *) m agent_usage >&2; return 1 ;;
  esac
}
# dấu máy chủ (v0.23.1, CNS-235): run/host-id = SHA-256 của /etc/machine-id (Linux) / IOPlatformUUID (macOS) — chỉ băm, không ghi giá trị gốc. Server (cả trong
# Docker, nơi không thấy /etc/machine-id của máy chủ) ghép nó với run/machine-id (ngẫu nhiên, trình cài / server tạo) thành dấu máy; cả hai nằm ngoài data/
# nên không theo bản sao lưu: khôi phục trên CHÍNH máy này giữ install-id, máy khác → install-id mới
host_id_save() {
  local h="" f cur
  for f in /etc/machine-id /var/lib/dbus/machine-id; do [ -r "$f" ] && h="$(tr -d ' \t\r\n' < "$f" 2>/dev/null)" && [ -n "$h" ] && break; done
  [ -n "$h" ] || h="$(ioreg -rd1 -c IOPlatformExpertDevice 2>/dev/null | sed -n 's/.*"IOPlatformUUID" = "\([^"]*\)".*/\1/p' | head -n 1)" || h=""
  [ -n "$h" ] || return 0
  h="$(printf '%s' "$h" | sha256_of)"
  case "$h" in [0-9a-f]*) ;; *) return 0 ;; esac
  cur="$(rd run/host-id | tr -d ' \r\n')" || cur=""
  [ "$cur" != "$h" ] || return 0
  as_app mkdir -p run 2>/dev/null && as_app chmod 700 run 2>/dev/null; printf '%s\n' "$h" | aw run/host-id 600 2>/dev/null || true
  return 0
}
# genchibi rollback [--yes]: chạy lại bản trước (như Studio › Hệ thống › Cập nhật › Chạy lại bản cũ) — app đổi current; root kiểm gói của bản đó (trust_sync)
